window.THERA_DATA = {"categories":[{"id":"lupsma_prostata","name":"177Lu-PSMA · Próstata","short":"Lu-PSMA","color":"#3b82f6","icon":"atom","count":14},{"id":"ra223_prostata","name":"223Ra · Próstata","short":"Ra-223","color":"#a855f7","icon":"radiation","count":8},{"id":"lu_dotatate_net","name":"177Lu-DOTATATE · NET","short":"Lu-DOTATATE","color":"#10b981","icon":"activity","count":10},{"id":"lupsma_ccrcc","name":"177Lu-PSMA · ccRCC","short":"Lu-PSMA-RCC","color":"#06b6d4","icon":"atom","count":3},{"id":"y90_tare","name":"Radioembolização 90Y","short":"Y-90","color":"#f59e0b","icon":"droplet","count":10},{"id":"novos_psma","name":"Novos PSMA (α / 161Tb / RIT)","short":"α-PSMA","color":"#ef4444","icon":"zap","count":8},{"id":"mibg_pediatria_pheo","name":"131I-MIBG · Pediátrico · PPGL","short":"MIBG/PPGL","color":"#ec4899","icon":"heart-pulse","count":8},{"id":"prostata_contexto","name":"Oncologia Próstata · Contexto","short":"Contexto Próstata","color":"#64748b","icon":"book-open","count":22},{"id":"nsclc_imuno","name":"NSCLC · Imunoterapia 1L","short":"NSCLC IO","color":"#22d3ee","icon":"shield-plus","count":8},{"id":"nsclc_alvo","name":"NSCLC · Drivers moleculares","short":"NSCLC alvo","color":"#0ea5b7","icon":"target","count":11},{"id":"nsclc_periop","name":"NSCLC · Perioperatório","short":"NSCLC periop","color":"#34d399","icon":"scissors","count":8},{"id":"sclc","name":"SCLC · Pequenas células","short":"SCLC","color":"#fbbf24","icon":"flame","count":5},{"id":"lung_radio_dev","name":"Pulmão · Radiofármacos experimentais","short":"Lung radio","color":"#a855f7","icon":"atom","count":2}],"studies":[{"estudo":"VISION (2021)","acron":"VISION — 177Lu-PSMA-617 in PSMA-positive mCRPC","nct":"NCT03511664","sponsor":"Endocyte/Novartis | PI: Oliver Sartor & Michael Morris","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 2:1 a 177Lu-PSMA-617 + SoC vs SoC. Endpoints duplos co-primários (rPFS por BICR e OS).","centros":"84 centros, EUA, Canadá e Europa","periodo":"Jun/2018 - Out/2019 (recrutamento)","indicacao":"mCRPC pós-≥1 ARPi (abi/enza) E pós-≥1 taxano (docetaxel ± cabazitaxel)","incl":"Idade ≥18a; ECOG 0-2; expectativa de vida ≥6 m; mCRPC com progressão por PCWG3; ADT mantida; PSMA-PET 68Ga-PSMA-11 elegível.","excl":"Lesões PSMA-negativas ≥2,5 cm linfonodais ou ≥1 cm viscerais; insuficiência renal grave (Cr >1,5× ULN); plaq <100k; Hb <9 g/dL; leucemia/SMD prévia; toxicidade hematológica acumulada.","estrat":"Nível de LDH (alto/baixo), presença de mets viscerais, uso de ARPi no estudo, ECOG 0-1 vs 2","basal":"Mediana 71a; ECOG 0-1 em ~93%; mediana de 2 linhas prévias de ARPi e 1-2 taxanos; mets ósseas em ~91%, viscerais em ~10%.","n":"Planejado 750; randomizado 831; analisado ITT 831 (551 LuPSMA + 280 SoC)","molecular":"PET 68Ga-PSMA-11 obrigatório: captação > parênquima hepático em ≥1 lesão (critério Novartis VISION); central review.","biomarc":"PSA seriado, LDH, FA; análises exploratórias de SUVmean ao PET; ctDNA não foi obrigatório no protocolo principal.","radiofarmaco":"[177Lu]Lu-PSMA-617 (vipivotide tetraxetan / Pluvicto®)","esquema":"7,4 GBq (±10%) IV q6 sem; até 6 ciclos (4 + 2 opcionais conforme resposta/segurança)","cumul":"≤44,4 GBq (44.400 MBq) cumulativos","comparador":"SoC à escolha do investigador (SEM QT, SEM Ra-223 e SEM RT extracraniana): pode incluir ARPi (abi/enza), corticoide, denosumabe/zoledronato.","estatistica":"Poder 90% para OS (HR 0,727); 84% para rPFS (HR 0,67). Análise sequencial fechada com α global 0,025 (2-sided).","analises":"ITT para todos os endpoints; OS calculada em coorte ITT com cross-over não permitido; análises sensíveis para perdas iniciais.","primario":"rPFS (BICR): 8,7 vs 3,4 m (HR 0,40; IC 99,2% 0,29-0,57; p<0,001) | OS: 15,3 vs 11,3 m (HR 0,62; IC 95% 0,52-0,74; p<0,001)","secundario":"ORR (RECIST 1.1, lesões mensuráveis): 30% vs 2% | DCR: 89% vs 67% | PSA50: 46% vs 7,1% | PSA80: 33% vs 2% | Tempo até 1º SSE: 11,5 vs 6,8 m (HR 0,50) | QoL: melhora favoreceu LuPSMA (FACT-P, BPI-SF)","subgrupo":"Benefício consistente em todas as subpopulações pré-especificadas (mets viscerais, idade, LDH, uso de ARPi). Excluídos com viscerais grandes podem ter benefício menor.","tox_g3":"Eventos ≥G3: 52,7% vs 38,0%. Anemia G3 13%, trombocitopenia G3 7,9%, neutropenia G3 3,4%, fadiga G3 7%.","tox_interesse":"Xerostomia 38,8% (predominantemente G1-2); fadiga 43%; náusea 35,3%; descontinuação por AE 12%; sem casos relevantes de SMD/leucemia no follow-up.","impacto_reg":"Aprovação FDA do Pluvicto® (Mar/2022) e EMA (Dez/2022). Incluído como opção em NCCN, EAU, ESMO para mCRPC PSMA+ pós-taxano e ARPi.","limit":"Comparador SoC limitado (não permitia QT/Ra-223). Lesões PSMA-negativas excluídas — extrapolação cuidadosa. Discordância FDG/PSMA não foi avaliada de rotina.","ref":"Sartor O, et al. NEJM 2021;385:1091-1103. (atualização Lancet Oncol 2024 — sustentado)","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT03511664","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/34161051/","ano_pub":2021,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_0"},{"estudo":"TheraP (ANZUP 1603, 2021/2024)","acron":"TheraP — A randomised phase II trial of 177Lu-PSMA-617 vs cabazitaxel in mCRPC","nct":"NCT03392428","sponsor":"ANZUP Cancer Trials Group | PI: Michael Hofman / Ian Davis","fase":"Fase 2 randomizada (Australia / NZ)","desenho":"Randomização 1:1 head-to-head 177Lu-PSMA-617 vs cabazitaxel; endpoint primário PSA50.","centros":"11 centros na Austrália","periodo":"Fev/2018 - Set/2019","indicacao":"mCRPC pós-docetaxel, candidato a cabazitaxel","incl":"Idade ≥18a; ECOG 0-2; mCRPC pós-docetaxel; PSMA-avido ao PET 68Ga-PSMA-11; FDG-PET sem discordância.","excl":"Lesão PSMA-negativa em sítio FDG-positivo (discordância maior); insuficiência renal/medular significativa; mCRPC pós-cabazitaxel.","estrat":"Centro, número de linhas prévias, uso prévio de ARPi","basal":"Mediana 72a; ECOG 0-1 em 91%; mets viscerais em ~12%; mediana de 1 linha prévia de ARPi e docetaxel.","n":"Planejado 200; randomizados 200 (99 LuPSMA + 101 cabaz); 91 e 85 receberam tratamento","molecular":"PET 68Ga-PSMA-11: SUVmax ≥20 em ≥1 lesão E SUVmax ≥10 em todas as lesões mensuráveis; PET 18F-FDG: nenhuma lesão FDG+ que seja PSMA−.","biomarc":"PSA seriado, ctDNA exploratório (subestudos), ARv7 não obrigatório.","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"8,5 GBq inicial, redução de 0,5 GBq por ciclo; até 6 ciclos q6sem (mediana de 5 ciclos)","cumul":"Mediana 35 GBq (variando 17-44)","comparador":"Cabazitaxel 20 mg/m² IV q3sem + prednisona 10 mg/dia + GCSF profilático; até 10 ciclos","estatistica":"Poder 84% para detectar diferença absoluta de 20% no PSA50 (50% vs 30%), α 0,05 unilateral.","analises":"ITT (intent-to-treat); análise por treated population como sensibilidade.","primario":"PSA50: 66% vs 37% (diferença 29%; p<0,0001)","secundario":"rPFS: HR 0,63 (favorece LuPSMA) | ORR (RECIST): 49% vs 24% | OS final (Lancet Oncol 2024, FU mediano 36 m): 19,1 vs 19,6 m (HR 0,97; sem diferença) | QoL: favoreceu LuPSMA","subgrupo":"Benefício maior em alta avidez PSMA (SUVmax >20). Análises de FDG mostraram que pacientes com FDG+/PSMA-discordante têm pior prognóstico (mas excluídos do estudo).","tox_g3":"Eventos G3-4: 33% vs 53%. Trombocitopenia G3-4: 11% (LuPSMA) vs 0% (cabaz); neutropenia G3-4: 4% vs 13%; xerostomia G1-2: 60%.","tox_interesse":"Xerostomia, fadiga (LuPSMA); neuropatia, alopecia, neutropenia febril (cabaz). Descontinuação por AE: 4% vs 19%.","impacto_reg":"Não modificou aprovação regulatória direta; mudou prática clínica como estudo head-to-head positivo. Influenciou desenhos posteriores (PSMAfore, SPLASH).","limit":"Não desenhado para OS; alto cross-over (32% receberam LuPSMA após cabaz) diluiu OS. Generalização limitada para pacientes com discordância FDG/PSMA.","ref":"Hofman MS, et al. Lancet 2021;397:797-804; Lancet Oncol 2024;25:99-107 (OS update)","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT03392428","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/33581798/","ano_pub":1603,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_1"},{"estudo":"PSMAfore (2024/2025)","acron":"PSMAfore — 177Lu-PSMA-617 vs ARPi switch in mCRPC pós-1 ARPi pré-taxano","nct":"NCT04689828","sponsor":"Novartis | PI: Oliver Sartor / Karim Fizazi","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 1:1 a 177Lu-PSMA-617 vs troca de ARPi (abi↔enza); cross-over permitido para braço LuPSMA na progressão.","centros":"108 centros mundiais","periodo":"Jul/2021 - Out/2022","indicacao":"mCRPC pós-1 ARPi, sem indicação imediata de QT (taxano-naive)","incl":"ECOG 0-1; PSMA-PET positivo; ADT contínua; expectativa de vida ≥6 m; função renal/hepática preservada.","excl":"Indicação clínica de QT imediata; lesões PSMA-negativas excludentes (idem VISION); QT prévia para mCRPC.","estrat":"Região, ECOG, presença de mets viscerais","basal":"Mediana 71a; mets ósseas ~89%, viscerais ~10%; ECOG 0 em 65%; PSA mediano 13 ng/mL.","n":"Planejado 450; randomizados 468 (234+234); cross-over: 84% do braço ARPi para LuPSMA na progressão","molecular":"PET 68Ga-PSMA-11 — critério VISION (≥1 lesão PSMA+ e sem lesão excludente). Sem FDG obrigatório.","biomarc":"PSA, LDH, FA; ctDNA em subestudo; análise exploratória de PSMA SUVmean.","radiofarmaco":"[177Lu]Lu-PSMA-617 (Pluvicto®)","esquema":"7,4 GBq IV q6sem; até 6 ciclos","cumul":"≤44,4 GBq","comparador":"Troca de ARPi: abiraterona 1000 mg + prednisona ↔ enzalutamida 160 mg/dia (oposto ao usado em 1ª linha)","estatistica":"Poder 95% para rPFS (HR 0,55); poder 86% para OS (HR 0,75). α global 0,05.","analises":"ITT para rPFS; OS analisada com ajuste por cross-over (IPCW e RPSFT) como pré-especificado.","primario":"rPFS (atualizado Lancet 2024, BICR): 11,6 vs 5,6 m (HR 0,49; IC 0,39-0,61; p<0,0001)","secundario":"OS ITT (final 2025, FU 24,6 m): 24,5 vs 23,1 m (HR 0,91; p=0,20) — NS por cross-over | OS ajustada IPCW: HR 0,59 | PSA50: 51% vs 17% | ORR: 51% vs 14% | Tempo até deterioração de QoL: favoreceu LuPSMA","subgrupo":"Benefício consistente (mets viscerais, ECOG, idade); sem subgrupo com efeito heterogêneo significativo.","tox_g3":"Eventos ≥G3: 36% vs 48%. Anemia G3: 6,2% vs 5%; xerostomia G3: <1%; trombocitopenia G3: 2%; fadiga G3: 5%.","tox_interesse":"Xerostomia 57% (LuPSMA) vs 2% (ARPi) — perfil característico. Menos eventos hematológicos graves que esperado para ARPi (devido à retirada de QT).","impacto_reg":"Aprovação FDA (Mar/2025) ampliada para mCRPC pós-ARPi pré-taxano. Inclusão em NCCN como opção precoce. Mudou jornada terapêutica.","limit":"OS ITT diluída pelo alto cross-over (84%). Sem comparação com QT (que muitos clínicos preferem em pacientes com sintomas/visceral).","ref":"Sartor O, et al. Lancet 2024;404:325-336; ESMO 2025 final OS analysis","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04689828","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/39306420/","ano_pub":2024,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_2"},{"estudo":"SPLASH (2024/2025)","acron":"SPLASH — 177Lu-PNT2002 (PSMA-I&T) vs ARPi switch","nct":"NCT04647526","sponsor":"Lantheus / Point Biopharma | PI: Oliver Sartor","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 2:1 a 177Lu-PSMA-I&T (PNT2002) vs troca de ARPi; cross-over permitido.","centros":"EUA, Canadá, Europa (multinacional)","periodo":"2021 - 2023","indicacao":"mCRPC pós-1 ARPi, pré-taxano","incl":"PSMA-PET positivo; ECOG 0-2; ADT contínua.","excl":"QT prévia para mCRPC; visceral grande; insuficiência renal/medular grave.","estrat":"Sem detalhes públicos completos","basal":"Mediana 73a; ECOG 0-1 ~90%; perfil semelhante ao PSMAfore.","n":"Planejado 415; randomizados 412 (276 LuPSMA-I&T + 136 ARPi)","molecular":"PSMA-PET positivo (68Ga-PSMA-11 OU 18F-DCFPyL — Pylarify), critério proprietário Lantheus. Sem FDG obrigatório.","biomarc":"PSA, ctDNA exploratório, dosimetria de subgrupos.","radiofarmaco":"[177Lu]Lu-PNT2002 (PSMA-I&T)","esquema":"6,8 GBq IV q8sem; 4 ciclos (regime mais curto que VISION/PSMAfore)","cumul":"≤27,2 GBq","comparador":"Abiraterona ↔ enzalutamida (troca, conforme PSMAfore)","estatistica":"Poder ≥80% para rPFS (HR 0,69); α 0,05.","analises":"ITT para rPFS; análise OS com ajuste por cross-over previsto.","primario":"rPFS (BICR): 9,5 vs 6,0 m (HR 0,71; IC 0,55-0,92; p=0,0088)","secundario":"PSA50: 35,7% vs 14,6% (p<0,001) | ORR: 38% vs 12% | OS imatura na análise principal (HR 1,11) — provável diluição por cross-over | QoL: favoreceu LuPSMA","subgrupo":"Benefício consistente; sem heterogeneidade marcante.","tox_g3":"Eventos ≥G3: 30% vs 37%. Anemia G3: ~7%; trombocitopenia G3: 3%; xerostomia G3: <1%.","tox_interesse":"Xerostomia 37%, fadiga 53%, anemia 18%. Menor exposição cumulativa (4 × 6,8 = 27,2 GBq) potencialmente associa a perfil mais leve que VISION.","impacto_reg":"Submissão à FDA pelo Lantheus (2025) para 177Lu-PNT2002. Pode adicionar concorrente comercial ao Pluvicto®.","limit":"Atividade cumulativa menor pode subdosar uma fração; ausência de FDG-PET pode incluir pacientes com discordância. Comparador limitado (sem QT).","ref":"Sartor O, et al. Lancet Oncol 2025; ESMO 2024 LBA (apresentação)","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04647526","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/40460244/","ano_pub":2024,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_3"},{"estudo":"ECLIPSE (em andamento)","acron":"ECLIPSE — 177Lu-PNT2002 vs ARPi em mCRPC pós-ARPi pré-taxano","nct":"NCT05204927","sponsor":"Lantheus | PI: Oliver Sartor","fase":"Fase 3 confirmatória","desenho":"Randomização 2:1 a 177Lu-PSMA-I&T vs troca de ARPi.","centros":"Multinacional","periodo":"2022 - em andamento (recrutamento ativo)","indicacao":"mCRPC pós-ARPi, pré-taxano","incl":"Análogo ao SPLASH (PSMA-PET+, ECOG 0-2, ADT)","excl":"Análogos a SPLASH/PSMAfore","estrat":"Por publicar","basal":"Por publicar","n":"Planejado ~415","molecular":"PSMA-PET positivo (68Ga ou 18F-DCFPyL)","biomarc":"PSA, dosimetria","radiofarmaco":"[177Lu]Lu-PNT2002 (PSMA-I&T)","esquema":"7,4 GBq q6sem × 6 ciclos (esquema 'VISION-like')","cumul":"≤44,4 GBq","comparador":"Troca de ARPi","estatistica":"Por publicar","analises":"Por publicar","primario":"rPFS por BICR — em andamento (dados não publicados)","secundario":"OS, PFS-2, PSA50, QoL, segurança — em andamento","subgrupo":"—","tox_g3":"Em andamento — dados não publicados","tox_interesse":"Em andamento","impacto_reg":"Estudo confirmatório do PSMA-I&T no esquema mais intenso; resultados podem consolidar/expandir aprovação.","limit":"Aguardando resultados; redundância parcial com SPLASH (esquema diferente).","ref":"ClinicalTrials.gov NCT05204927","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT05204927","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_4"},{"estudo":"ENZA-p (ANZUP 1901, 2024)","acron":"ENZA-p — Enzalutamide ± 177Lu-PSMA-617 in poor-risk mCRPC","nct":"NCT04419402","sponsor":"ANZUP Cancer Trials Group | PI: Louise Emmett","fase":"Fase 2 randomizada","desenho":"Randomização 1:1 a enzalutamida + LuPSMA-617 vs enzalutamida isolada; ciclos adicionais de LuPSMA conforme PET na sem 12.","centros":"15 centros na Austrália","periodo":"Ago/2020 - Jun/2022","indicacao":"mCRPC pré-QT/pré-ARPi (1ª linha mCRPC), com ALTO RISCO de falha precoce a enzalutamida (≥2 fatores de risco)","incl":"Idade ≥18a; ECOG 0-2; ≥2 fatores de risco poor: PSA-DT <84d, mets viscerais, dor pelo BPI ≥2, LDH >ULN, ALP >ULN, albumina baixa.","excl":"QT prévia para mCRPC; PSMA-PET sem captação significativa.","estrat":"Centro; uso prévio de docetaxel para mHSPC","basal":"Mediana 71a; mets viscerais 18%; PSA mediano 30 ng/mL; alta carga de risco.","n":"Planejado 160; randomizados 162 (83 + 79)","molecular":"PET 68Ga-PSMA-11: SUVmax ≥15 em ≥1 lesão E SUVmax >10 em todas as lesões mensuráveis. PSMA-PET de seguimento na sem 12 para definir necessidade de ciclos adicionais.","biomarc":"ctDNA exploratório; PSMA-PET dinâmico (substudy mostrou que upregulation precoce prediz resposta).","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"7,5 GBq q6-8sem; 2 ciclos iniciais + 2 adicionais (total 4) se ainda PSMA+ no PET interino. Mediana 4 ciclos.","cumul":"Mediana 30 GBq; máximo 30 GBq (4 ciclos)","comparador":"Enzalutamida 160 mg/dia VO contínua (ambos os braços)","estatistica":"Poder 80% para PSA-PFS HR 0,63; α 0,05 unilateral.","analises":"ITT; análises de subgrupo pré-especificadas.","primario":"PSA-PFS: 13,0 vs 7,8 m (HR 0,43; IC 0,29-0,63; p<0,0001)","secundario":"rPFS: 16,0 vs 12,0 m (HR 0,67) | cPFS: 14,0 vs 9,4 m (HR 0,47) | PSA50: 93% vs 68% | PSA90: 78% vs 37% | OS atualizada: 34 vs 26 m (HR 0,55) | Dor (BPI): redução em 61% vs 27%","subgrupo":"Benefício maior em pacientes com viscerais (subgrupo 'poor-risk'); sustained tumor PSMA upregulation no PET de 6sem prediz resposta sustentada.","tox_g3":"G3-5: 40% vs 41% (semelhantes). Anemia, fadiga, náusea G3 ~5-8%.","tox_interesse":"Xerostomia 40% no braço LuPSMA; fadiga 75% vs 70%; náusea 47% vs 27%.","impacto_reg":"Demonstra eficácia de combinação simultânea (não sequencial) de RLT + ARPi em mCRPC. Influencia desenhos como PSMAddition.","limit":"Fase 2 (não pivotal); população 'poor-risk' restrita; uso de PET para guiar dose adicional aumenta complexidade prática.","ref":"Emmett L, et al. Lancet Oncol 2024;25:563-571; Nat Cancer 2026 (PSMA upregulation substudy)","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04419402","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/38432236/","ano_pub":1901,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_5"},{"estudo":"UpFrontPSMA (2024)","acron":"UpFrontPSMA — Sequenced 177Lu-PSMA + Docetaxel vs Docetaxel in mHSPC","nct":"NCT04343885","sponsor":"Peter MacCallum | PI: Arun Azad / Michael Hofman","fase":"Fase 2 randomizada","desenho":"Randomização 1:1: braço experimental ADT + 2 ciclos LuPSMA → 6 ciclos docetaxel; controle ADT + 6 ciclos docetaxel.","centros":"11 centros na Austrália","periodo":"Ago/2020 - Out/2022","indicacao":"mHSPC de novo (sem tratamento prévio), alto volume CHAARTED, pré-QT/pré-ARPi","incl":"Idade ≥18a; mHSPC alto volume CHAARTED; PSMA-PET com captação intensa (SUVmax ≥15 em ≥1 lesão); FDG-PET sem discordância maior; ADT iniciada ≤4 sem antes de inclusão.","excl":"Discordância FDG+/PSMA−; mets cerebrais; insuficiência renal/medular significativa.","estrat":"Centro; idade <70 vs ≥70","basal":"Mediana 67a; ECOG 0-1 ~95%; alta carga de mets ósseas; mets viscerais ~26%; PSA mediano 73 ng/mL.","n":"Planejado 130; randomizados 130 (63 + 67)","molecular":"PET 68Ga-PSMA-11: SUVmax ≥15 em ≥1 lesão; PET 18F-FDG: sem lesões FDG+/PSMA−.","biomarc":"PSA, ctDNA, dosimetria.","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"7,5 GBq q6sem × 2 ciclos (sequencial antes de docetaxel)","cumul":"15 GBq (2 ciclos)","comparador":"ADT + docetaxel 75 mg/m² q3sem × 6 ciclos","estatistica":"Poder ~80% para detectar diferença em PSA indetectável (proporção). α 0,05.","analises":"ITT para endpoint primário; análises secundárias incluindo OS e rPFS.","primario":"PSA indetectável (<0,02 ng/mL) em 48 sem: 41% vs 16% (OR 3,88; IC 1,73-8,90; p=0,002)","secundario":"PSA-PFS: 31 vs 20 m (HR 0,60; IC 0,38-0,93; p=0,039) | rPFS: HR 0,58 (IC 0,33-1,03; p=0,067) | Tempo até CRPC: HR 0,47 favoreceu LuPSMA","subgrupo":"Benefício consistente em alto volume; subgrupos com viscerais também beneficiados.","tox_g3":"G3-4: 29% vs 27% (semelhantes). Hematológicas predominantes do docetaxel; xerostomia G3 <1%.","tox_interesse":"Xerostomia 37% no braço LuPSMA (G1-2 predominante); sem aumento de toxicidade do docetaxel; sem mortes relacionadas.","impacto_reg":"Primeiro RCT em mHSPC com benefício para LuPSMA em adição a SoC. Inspirou e apoiou desenho do PSMAddition.","limit":"Fase 2 (não pivotal); uso de docetaxel como SoC pode estar superado em alguns cenários (tripleta com darolutamida); requer PSMA-PET intenso.","ref":"Azad AA, et al. Lancet Oncol 2024;25:1267-1276","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04343885","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/39237162/","ano_pub":2024,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_6"},{"estudo":"PSMAddition (ESMO 2025)","acron":"PSMAddition — 177Lu-PSMA-617 + ADT + ARPi vs ADT + ARPi in mHSPC","nct":"NCT04720157","sponsor":"Novartis","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 1:1 a tripla combinação ADT+ARPi+LuPSMA vs duo ADT+ARPi.","centros":"190+ centros mundiais","periodo":"Jun/2021 - 2024 (recrutamento)","indicacao":"mHSPC PSMA-positivo, pré-QT/pré-ARPi","incl":"≥18a; mHSPC com ≥1 lesão PSMA+ ao PET; ECOG 0-1; adequada função orgânica; ARPi à escolha do investigador.","excl":"QT prévia para mHSPC; uso prévio de RLT; mets cerebrais sintomáticas.","estrat":"Volume CHAARTED (alto vs baixo), região, ARPi escolhida","basal":"Mediana 68a; ~50% de novo mHSPC; 68% alto volume; 40% com mets viscerais; ECOG 0 em ~70%.","n":"Planejado 1.126; randomizados 1.144 (572 + 572)","molecular":"PET 68Ga-PSMA-11: ≥1 lesão PSMA+ (critério mais permissivo que VISION).","biomarc":"PSA, ctDNA, dosimetria de subgrupos.","radiofarmaco":"[177Lu]Lu-PSMA-617 (Pluvicto®)","esquema":"7,4 GBq q6sem × 6 ciclos","cumul":"≤44,4 GBq","comparador":"ADT + ARPi (abiraterona OU enzalutamida) à escolha do investigador","estatistica":"Poder ~85% para rPFS HR 0,71; α 0,025 (2-sided). Endpoints chaves hierarquizados.","analises":"ITT; OS com ajuste para cross-over não previsto (sem cross-over no protocolo).","primario":"rPFS: HR 0,72 (IC 0,58-0,90; p=0,002) | mediana ainda imatura","secundario":"OS (1ª interina, maturidade 47%): HR 0,84 (p=0,125; tendência) | Tempo até mCRPC: HR 0,70 | Tempo até PSA progression: HR 0,42 | PSA50, ORR favoreceram tripla","subgrupo":"Benefício consistente em alto e baixo volume, viscerais ou não. Análise de novos vs recidivados em andamento.","tox_g3":"Eventos ≥G3: maiores no braço LuPSMA, mas perfil hematológico controlado. Anemia G3 ~10%, plaquetopenia G3 ~3%.","tox_interesse":"Xerostomia 45,7%, fadiga 34,8%, náusea 34,2%, anemia 27,1%. Sem novos sinais de segurança vs VISION/PSMAfore.","impacto_reg":"Primeiro fase III positivo de RLT em mHSPC. Submissão regulatória esperada para 2026 (FDA/EMA). Provável expansão da indicação do Pluvicto®.","limit":"OS imatura; necessidade de PSMA-PET acessível e estrutura para administrar 6 ciclos em pacientes mHSPC; impacto sobre escolha de ARPi vs RLT-first.","ref":"Tagawa ST, et al. ESMO 2025 LBA1; ClinicalTrials.gov NCT04720157","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04720157","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=PSMAddition+2025","ano_pub":2025,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_7"},{"estudo":"STAMPEDE-2 (em andamento)","acron":"STAMPEDE-2 — Plataforma multibraço UK em mHSPC","nct":"NCT06320067","sponsor":"MRC Clinical Trials Unit / UCL | PI: Nicholas James / Gerhardt Attard","fase":"Fase 3 plataforma multibraço","desenho":"Plataforma adaptativa: comparações múltiplas em paralelo (LuPSMA, novos ARPi, intensificação local).","centros":"100+ no Reino Unido / Suíça","periodo":"2024 - 2030 (planejado)","indicacao":"mHSPC de novo ou recidivado, pré-QT/pré-ARPi","incl":"Por subprotocolo (LuPSMA-arm: PSMA-PET+, ADT recente)","excl":"Por subprotocolo","estrat":"Volume, idade, fator molecular","basal":"Por publicar","n":"Plataforma planejada >5.000; ~1.756 no braço LuPSMA","molecular":"PSMA-PET (critério adaptado)","biomarc":"Painel multiômico (UK Biobank-link)","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"Esquema 'fracionado': 3 ciclos com 2× 7,4 GBq (D1 + D8) q6sem (testando esquema mais intensificado)","cumul":"≤44,4 GBq (em ~3 ciclos com fracionamento)","comparador":"ADT + ARPi (± SBRT ± QT, conforme estratificação)","estatistica":"Por subprotocolo; OS como endpoint primário do braço LuPSMA","analises":"Plataforma multi-arm com ajustes por comparações múltiplas","primario":"OS — em andamento (dados não publicados)","secundario":"rPFS, MFS, QoL, custo-efetividade — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Plataforma com peso regulatório (UK NICE). Pode validar esquema fracionado de LuPSMA.","limit":"Resultados de longo prazo; complexidade de plataforma com múltiplas comparações.","ref":"ClinicalTrials.gov NCT06320067","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT06320067","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/26719232/","ano_pub":0,"status":"Em andamento","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_8"},{"estudo":"LuTectomy (2024)","acron":"LuTectomy — 177Lu-PSMA-617 neoadjuvante pré-prostatectomia em HRLPC","nct":"NCT04430192","sponsor":"Peter MacCallum | PI: Renu Eapen / Declan Murphy","fase":"Fase 1/2 (braço único)","desenho":"Estudo aberto, single-arm; 1 ou 2 ciclos LuPSMA antes de RPT em 6 sem; análise dosimétrica (peça cirúrgica).","centros":"1 centro (Peter MacCallum, Australia)","periodo":"2020 - 2022","indicacao":"Câncer de próstata localizado de alto risco, pré-prostatectomia","incl":"ISUP ≥4 OU cT3-4 OU PSA ≥20; PET 68Ga-PSMA-11 com SUVmax ≥10 no primário; candidato a RPT.","excl":"Mets distantes; toxicidade prévia de RT pélvica.","estrat":"—","basal":"Mediana 64a; ECOG 0; PSA mediano 12; ISUP 4-5 em 90%.","n":"20 pacientes","molecular":"PSMA-PET com captação intensa no tumor primário (SUVmax ≥10).","biomarc":"PSA, dosimetria intra-tumoral por SPECT pós-injeção; análise patológica de necrose.","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"5 GBq IV; 1 ou 2 ciclos q6sem; RPT em 6-8 sem após último ciclo","cumul":"5-10 GBq (1-2 ciclos)","comparador":"—","estatistica":"Descritivo (single-arm); n para detectar dose tumoral adequada.","analises":"Per-protocol; análise dosimétrica em cada lesão.","primario":"Dose absorvida no tumor primário (mGy/MBq) — viabilidade dosimétrica demonstrada","secundario":"PSA50 pré-cirúrgico ~45%; downstaging em 35%; resposta patológica (necrose >50% em alguns casos); margens cirúrgicas positivas em 35%.","subgrupo":"—","tox_g3":"Sem eventos G3-4 relacionados ao tratamento.","tox_interesse":"Cirurgia preservada em todos os pacientes; xerostomia leve transitória.","impacto_reg":"Prova de conceito de RLT neoadjuvante em alto risco. Inspirou estudos randomizados (PRELUDE, NEPI).","limit":"n pequeno; sem comparador; resposta patológica modesta.","ref":"Eapen RS, et al. Eur Urol 2024;85:217-226","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04430192","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/37923670/","ano_pub":2024,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_9"},{"estudo":"PRELUDE (em andamento)","acron":"PRELUDE — 177Lu-PSMA-617 neoadjuvante em câncer de próstata muito alto risco","nct":"NCT06798558","sponsor":"Investigador-iniciado (Europa)","fase":"Fase 2, braço único","desenho":"Single-arm; 2 ciclos LuPSMA antes de RPT.","centros":"Multicêntrico europeu","periodo":"2025 - em recrutamento","indicacao":"Câncer de próstata localizado de muito alto risco, pré-RPT","incl":"HRLPC (critério MSKCC/EAU 'very high risk'); PSMA-PET+ no primário.","excl":"Mets distantes; FDG-PET com discordância maior.","estrat":"Por publicar","basal":"Por publicar","n":"54 pacientes planejados","molecular":"PSMA-PET com captação intensa no primário; FDG opcional para discordância.","biomarc":"PSA, ctDNA, dosimetria.","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"7,4 GBq × 2 ciclos q6sem; RPT em 6-8 sem","cumul":"14,8 GBq","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol; pCR como endpoint primário.","primario":"Resposta patológica completa (pCR) — em andamento","secundario":"Toxicidade, PSA50 pré-cirurgia, padrão de captação residual ao PSMA-PET pós-tratamento, QoL, sobrevida livre de recidiva bioquímica — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Pode validar conceito de neoadjuvância LuPSMA em larger cohort.","limit":"Não randomizado; comparador histórico.","ref":"ClinicalTrials.gov NCT06798558","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT06798558","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_10"},{"estudo":"BULLSEYE (Lancet Oncol 2026)","acron":"BULLSEYE — 177Lu-PSMA-617 vs SoC em HSPC oligometastático recidivado","nct":"NCT04443062","sponsor":"Acadêmico (Holanda) | PI: Erasmus MC","fase":"Fase 2 randomizada","desenho":"Randomização 1:1 a LuPSMA vs SoC (vigilância / ADT a critério); 2 ciclos iniciais + 2 adicionais se PSMA+ residual.","centros":"Multicêntrico holandês","periodo":"2020 - 2025","indicacao":"HSPC oligometastático com BCR pós-tratamento local definitivo","incl":"BCR pós-RPT/RT; PSA-DT <6 m; PSA >1,0 ng/mL; ≤5 lesões ao PSMA-PET; sem ADT prévia para BCR.","excl":"≥6 lesões; CRPC; ADT em curso para BCR.","estrat":"Centro; uso prévio de salvage RT","basal":"Mediana 68a; idade jovem favorecida; PSA mediano ~3 ng/mL; ECOG 0 em maioria.","n":"58 pacientes randomizados","molecular":"PET 68Ga-PSMA-11 com 1-5 lesões ávidas (oligometástase ao PSMA-PET).","biomarc":"PSA dinâmico; PSA-DT; ctDNA exploratório.","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"7,4 GBq q6sem × 2 ciclos iniciais + 2 adicionais se PSMA+ residual","cumul":"14,8-29,6 GBq","comparador":"Vigilância ativa OU ADT (a critério do investigador)","estatistica":"Poder ~80% para PD em 6 m; α 0,05.","analises":"ITT.","primario":"Progressão de doença em 6 m: 7% (LuPSMA) vs 93% (SoC) | PFS: 25 vs 5 m (HR ~0,15)","secundario":"PSA50, tempo até início de ADT, QoL, padrão de recidiva.","subgrupo":"—","tox_g3":"Boa tolerabilidade; sem eventos hematológicos significativos.","tox_interesse":"Xerostomia leve transitória; QoL preservada.","impacto_reg":"Demonstra alta atividade de LuPSMA em oligometástase HSPC, com potencial de adiar ADT (preserva QoL).","limit":"n pequeno; SoC heterogêneo (vigilância ou ADT); seguimento ainda curto para OS.","ref":"BULLSEYE — Lancet Oncol 2026 (em publicação); NCT04443062","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT04443062","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=BULLSEYE+2026","ano_pub":2026,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_11"},{"estudo":"LUNAR (ASCO 2025)","acron":"LUNAR — 177Lu-PSMA-PNT2002 + SBRT vs SBRT em mHSPC oligometastático","nct":"NCT05496959","sponsor":"Acadêmico (multicêntrico)","fase":"Fase 2 randomizada","desenho":"Randomização 1:1; SBRT em todas as lesões + LuPSMA vs SBRT isolada.","centros":"Multicêntrico EUA/UK","periodo":"2022 - 2024 (recrutamento)","indicacao":"mHSPC oligometastático (1-5 lesões ao PSMA-PET)","incl":"1-5 lesões ao PSMA-PET; SUVmax ≥2× hepático; PSA-DB <6 m.","excl":"≥6 lesões; CRPC; ADT em curso.","estrat":"Número de lesões; uso prévio de salvage RT.","basal":"Por publicar","n":"92 (planejados 90)","molecular":"PSMA-PET com SUVmax ≥2× hepático em ≥1 lesão.","biomarc":"PSA, dosimetria.","radiofarmaco":"[177Lu]Lu-PNT2002 (PSMA-I&T)","esquema":"6,8 GBq × 2 ciclos q6-8sem (após SBRT)","cumul":"13,6 GBq","comparador":"SBRT em todas as lesões (sem RLT)","estatistica":"Poder ~80% para PFS HR 0,5; α 0,05.","analises":"ITT.","primario":"PFS: 17,6 m (LuPSMA + SBRT) vs 7,4 m (SBRT) — HR 0,37 (p<0,001)","secundario":"Padrão de recidiva favoreceu o braço com RLT (menos novas lesões); PSA50; ADT-free survival.","subgrupo":"Sem cross-over relevante.","tox_g3":"Sem aumento relevante de toxicidade no braço com radioligante; SBRT padrão.","tox_interesse":"Xerostomia leve; sem eventos hematológicos graves.","impacto_reg":"Conceito complementar: SBRT trata lesões visíveis, LuPSMA trata doença microscópica sistêmica. Apoia papel de RLT como adjuvante à terapia local.","limit":"n moderado; seguimento curto para OS; comparador SBRT-only pode subestimar SoC moderno.","ref":"LUNAR — ASCO 2025 (Hofman MS et al.); NCT05496959","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT05496959","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=LUNAR+2025","ano_pub":2025,"status":"Publicado","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_12"},{"estudo":"POPSTAR II (em andamento)","acron":"POPSTAR II — 177Lu-PSMA-I&T + SBRT vs SBRT em oligometastase HSPC","nct":"NCT05560659","sponsor":"Peter MacCallum (Australia)","fase":"Fase 2 randomizada","desenho":"Randomização 1:1; análogo ao LUNAR mas com PSMA-I&T.","centros":"Australia (multi)","periodo":"2022 - em recrutamento","indicacao":"Próstata oligometastático/oligorrecorrente (HSPC)","incl":"1-5 lesões ao PSMA-PET; ao menos 1 sítio com SUVmax ≥2× hepático.","excl":"≥6 lesões; CRPC.","estrat":"Por publicar","basal":"Por publicar","n":"~140 planejados","molecular":"PSMA-PET com SUVmax ≥2× hepático.","biomarc":"PSA, ctDNA exploratório.","radiofarmaco":"[177Lu]Lu-PSMA-I&T","esquema":"6,0 GBq × 2 ciclos q6-8sem após SBRT","cumul":"12 GBq","comparador":"SBRT isolada","estatistica":"Por publicar","analises":"Por publicar","primario":"bPFS — em andamento","secundario":"Toxicidade, PSA50, ADT-free survival, padrão de recorrência ao PSMA-PET, QoL, MDT-PFS, OS, custos, PET-PFS — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Estudo análogo ao LUNAR com PSMA-I&T; ajudará a estabelecer papel de RLT em oligometástase.","limit":"Aguardando resultados.","ref":"ClinicalTrials.gov NCT05560659","category_id":"lupsma_prostata","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT05560659","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-PSMA · Próstata","category_short":"Lu-PSMA","category_color":"#3b82f6","uid":"lupsma_prostata_13"},{"estudo":"ALSYMPCA (2013)","acron":"ALSYMPCA — ALpharadin in SYMPtomatic Prostate CAncer patients","nct":"NCT00699751","sponsor":"Algeta/Bayer | PI: Chris Parker / Sten Nilsson","fase":"Fase 3, internacional, randomizado, duplo-cego, controlado por placebo","desenho":"Randomização 2:1 a 223Ra-dicloreto vs placebo; ambos + SoC.","centros":"136 centros em 19 países","periodo":"Jun/2008 - Fev/2011","indicacao":"mCRPC ósseo sintomático, sem mets viscerais (com ou sem QT prévia)","incl":"Idade ≥18a; ECOG 0-2; ≥2 mets ósseas em cintilo; PSA progressivo ou progressão clínica; sintomas (uso analgésico ou EBRT recente); pós-docetaxel OU inelegível.","excl":"Mets viscerais; mets nodais >3 cm; QT em curso; insuficiência renal/medular grave (Hb <10, plaq <100k, neutro <1,5).","estrat":"Uso prévio de docetaxel (sim/não), nível de ALP basal (≥220 vs <220 U/L), uso atual de bisfosfonato","basal":"Mediana 71a; ECOG 0-1 em 87%; pós-docetaxel em 57%; uso de bisfosfonatos em 41%; mediana 6 mets ósseas.","n":"Planejado ~750; randomizados 921 (614 Ra + 307 placebo); ITT 921","molecular":"Cintilografia óssea 99mTc-MDP com ≥2 lesões; sem PET PSMA na época do estudo.","biomarc":"PSA, ALP total, bone-ALP, NTx urinário (todos seriados); sem biomarcadores genômicos.","radiofarmaco":"223Ra-dicloreto (Xofigo® / Alpharadin)","esquema":"50 kBq/kg IV (atualizado para 55 kBq/kg após recalibração); q4sem × 6 ciclos","cumul":"300 kBq/kg (atualizado 330 kBq/kg)","comparador":"Placebo (solução salina) IV q4sem × 6","estatistica":"Poder 90% para OS HR 0,76; α 0,05 bilateral. Análise interina pré-especificada com critério O'Brien-Fleming.","analises":"ITT; estudo INTERROMPIDO precocemente por eficácia em análise interina (capping de eventos).","primario":"OS: 14,9 vs 11,3 m (HR 0,70; IC 0,58-0,83; p<0,001) — REDUÇÃO DE 30% NO RISCO DE MORTE","secundario":"Tempo até 1º SSE: 15,6 vs 9,8 m (HR 0,66) | Tempo até elevação de ALP total: HR 0,17 | Tempo até elevação de PSA: HR 0,64 | QoL (FACT-P): melhora favoreceu Ra-223","subgrupo":"Benefício consistente em todos subgrupos (uso prévio de QT, nível de ALP, idade, ECOG); subgrupo sem QT prévia teve magnitude semelhante de benefício.","tox_g3":"Eventos hematológicos G3-4: trombocitopenia 6,3% vs 2%; neutropenia 2,2% vs <1%; anemia 12,9% vs 13,1% (sem diferença).","tox_interesse":"Diarreia G1-2 (25% vs 15%); náusea (36% vs 35%); fadiga (26% vs 26%). Toxicidade hematológica autolimitada. Risco baixo de SMD/leucemia (<1% no FU longo).","impacto_reg":"PRIMEIRO ALFA-EMISSOR aprovado em oncologia (FDA 2013 / EMA 2013). Padrão em mCRPC ósseo sintomático. Inclusão em NCCN, EAU, ESMO. Estimulou desenvolvimento de toda a alfa-terapia oncológica.","limit":"Comparador placebo (questão ética hoje); selecionou pacientes 'sintomáticos'; sem PET PSMA para estratificação. Não combinou com ARPi (limitação resolvida pelo PEACE-3, evitando combinação ERA-223).","ref":"Parker C, et al. NEJM 2013;369:213-223; Hoskin P et al. Lancet Oncol 2014 (subgrupo pós-doce)","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe — recomendado isoladamente e obrigatório em combinações com ARPi (proteção óssea; lição do ERA-223). Sem pré-medicação específica para a infusão; hidratação opcional.","nct_url":"https://clinicaltrials.gov/study/NCT00699751","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/23863050/","ano_pub":2013,"status":"Publicado","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_0"},{"estudo":"ERA-223 (2019)","acron":"ERA-223 — Abiraterone + Radium-223 in mCRPC","nct":"NCT02043678","sponsor":"Bayer | PI: Matthew Smith","fase":"Fase 3, internacional, duplo-cego, controlado por placebo","desenho":"Randomização 1:1 a abiraterona + prednisona + Ra-223 vs abiraterona + prednisona + placebo; protetor ósseo NÃO obrigatório no protocolo original.","centros":"165 centros mundiais","periodo":"Mar/2014 - Ago/2017 (interrompido)","indicacao":"mCRPC ósseo, assintomático ou minimamente sintomático, sem QT prévia","incl":"≥18a; ECOG 0-1; ≥2 mets ósseas; sem mets viscerais; sem QT prévia para mCRPC.","excl":"Mets viscerais; sintomas dolorosos significativos; insuficiência cardíaca/renal grave.","estrat":"Uso prévio de bisfosfonato/denosumabe; nível de ALP","basal":"Mediana 70a; ECOG 0 em ~52%; PSA mediano 24 ng/mL; uso de bisfosfonato em ~40%.","n":"Planejado 800; randomizados 806 (401 + 405)","molecular":"Cintilografia óssea (sem PET PSMA).","biomarc":"PSA, ALP, biomarcadores ósseos; sem genômica.","radiofarmaco":"223Ra-dicloreto","esquema":"55 kBq/kg q4sem × 6","cumul":"330 kBq/kg","comparador":"Abiraterona 1000 mg/dia + prednisona 5 mg BID + placebo IV","estatistica":"Poder 80% para SSE-FS HR 0,68; α 0,05.","analises":"ITT; estudo INTERROMPIDO PRECOCEMENTE por desbalanço de fraturas e mortes.","primario":"SSE-FS (sobrevida livre de evento sintomático esquelético): 22,3 vs 26,0 m (HR 1,12; IC 0,92-1,37) — FAVOR CONTROLE","secundario":"OS: 30,7 vs 33,3 m (HR 1,20; IC 0,95-1,50) — FAVOR CONTROLE | Fraturas: 29% vs 11% (excesso significativo no braço Ra-223)","subgrupo":"Subgrupo COM bisfosfonato/denosumabe basal: SEM excesso de fraturas (post hoc, hipótese-gerador).","tox_g3":"Eventos AE G3-4 hematológicos esperados; principal achado foi excesso de FRATURAS PATOLÓGICAS (sem proteção óssea).","tox_interesse":"Fraturas patológicas/osteoporóticas: 29% (combo) vs 11% (controle); maioria não associada a SSE clínico mas refletindo fragilidade óssea.","impacto_reg":"RESULTADO NEGATIVO. Mudou regulamentação: Ra-223 não pode ser combinado com abiraterona; protetor ósseo (bisfosfonato/denosumabe) tornou-se OBRIGATÓRIO em todas as combinações futuras (PEACE-3).","limit":"Falha do protocolo em não exigir protetor ósseo; combinação simultânea (vs sequencial) pode aumentar densidade óssea anormal e fragilidade.","ref":"Smith M, et al. Lancet Oncol 2019;20:408-419","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe — recomendado isoladamente e obrigatório em combinações com ARPi (proteção óssea; lição do ERA-223). Sem pré-medicação específica para a infusão; hidratação opcional.","nct_url":"https://clinicaltrials.gov/study/NCT02043678","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/30738780/","ano_pub":2019,"status":"Publicado","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_1"},{"estudo":"PEACE-3 (EORTC 1333, 2024-2025)","acron":"PEACE-3 / EORTC-GUCG 1333 — Enzalutamide + Radium-223 vs Enzalutamide in mCRPC","nct":"NCT02194842","sponsor":"EORTC + Bayer | PI: Silke Gillessen / Bertrand Tombal","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 1:1 a enzalutamida + Ra-223 + protetor ósseo OBRIGATÓRIO vs enzalutamida + protetor ósseo.","centros":"55 centros em 14 países (Europa)","periodo":"Nov/2015 - Mar/2023","indicacao":"mCRPC com mets ósseas, assintomático ou minimamente sintomático","incl":"≥18a; ECOG 0-1; ≥2 mets ósseas; sem mets viscerais; bisfosfonato OU denosumabe OBRIGATÓRIO (pelo menos por 6 m).","excl":"Mets viscerais; QT prévia para mCRPC; uso prévio de Ra-223 ou enzalutamida.","estrat":"Uso prévio de docetaxel para mHSPC; uso de protetor ósseo basal (bisfosfonato vs denosumabe)","basal":"Mediana 70a; ECOG 0 em 67%; uso prévio de docetaxel para mHSPC em 30%; uso de denosumabe em ~80%.","n":"Planejado ~556; randomizados 446 (223 + 223)","molecular":"Cintilografia óssea + TC; sem PET PSMA obrigatório (alguns centros usaram).","biomarc":"PSA, ALP, biomarcadores ósseos.","radiofarmaco":"223Ra-dicloreto + enzalutamida","esquema":"Ra-223: 55 kBq/kg q4sem × 6 + enzalutamida 160 mg/dia VO contínua + protetor ósseo (bisfosfonato/denosumabe) obrigatório","cumul":"Ra-223: 330 kBq/kg","comparador":"Enzalutamida 160 mg/dia + protetor ósseo","estatistica":"Poder 90% para rPFS HR 0,67; OS analisada como hierarquia secundária. α 0,05 bilateral.","analises":"ITT; análise OS final reportada em 2025.","primario":"rPFS: 19,4 vs 16,4 m (HR 0,69; IC 0,54-0,87; p=0,0009)","secundario":"OS final (Ann Oncol 2025): 38,2 vs 32,6 m (HR 0,75; IC 0,60-0,95; p=0,0042) — REDUÇÃO DE 25% NO RISCO DE MORTE | Tempo até próxima terapia sistêmica: HR 0,57 | Tempo até SSE, PSA50: favoreceram combinação.","subgrupo":"Benefício consistente; sem heterogeneidade marcante.","tox_g3":"Eventos AE G3-4 esperados; SEM excesso de fraturas (lição do ERA-223 aprendida); neutropenia G3 ~5%, anemia G3 ~7%.","tox_interesse":"Sem excesso de fraturas patológicas (uso obrigatório de protetor ósseo); mielotoxicidade leve-moderada autolimitada.","impacto_reg":"RESGATE da combinação Ra-223 + ARPi (com protetor ósseo). Aprovação ampliada esperada (Bayer, 2025/2026). Novo padrão em mCRPC ósseo assintomático/min sintomático.","limit":"Recrutamento longo (8 anos); sem braço sem ARPi para isolar efeito de Ra-223 puro; sem PET PSMA na maioria.","ref":"Gillessen S, et al. Ann Oncol 2025; JCO 2026 (final OS); Annals Oncol article PIIS0923-7534(25)00203-0","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe — recomendado isoladamente e obrigatório em combinações com ARPi (proteção óssea; lição do ERA-223). Sem pré-medicação específica para a infusão; hidratação opcional.","nct_url":"https://clinicaltrials.gov/study/NCT02194842","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/40450503/","ano_pub":1333,"status":"Publicado","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_2"},{"estudo":"DORA (em andamento)","acron":"DORA — Docetaxel ± Radium-223 in mCRPC","nct":"NCT03574571","sponsor":"Cooperative group (NCI/CTEP) | PI: Michael Morris","fase":"Fase 3 randomizada, aberta","desenho":"Randomização 1:1 a docetaxel + Ra-223 vs docetaxel.","centros":"EUA + Reino Unido + Europa (multicêntrico)","periodo":"2018 - em recrutamento ativo","indicacao":"mCRPC com mets ósseas, candidato a docetaxel","incl":"≥18a; ECOG 0-2; mets ósseas; bisfosfonato/denosumabe permitido (não obrigatório).","excl":"Mets viscerais maiores; uso prévio de Ra-223; insuficiência hematológica.","estrat":"Por publicar","basal":"Por publicar","n":"738 planejados","molecular":"Cintilografia óssea; uso de PET PSMA varia por centro.","biomarc":"PSA, ALP, biomarcadores ósseos.","radiofarmaco":"223Ra-dicloreto + docetaxel","esquema":"Docetaxel 60 mg/m² q3sem × 10 (dose REDUZIDA) + Ra-223 55 kBq/kg q6sem × 6 (intervalo PROLONGADO para evitar mielotoxicidade aditiva)","cumul":"Ra-223: 330 kBq/kg; doce: 600 mg/m²","comparador":"Docetaxel 75 mg/m² q3sem × 10 (dose-padrão)","estatistica":"Poder ~80% para OS (HR 0,75; mediana 15 vs 20 m); α 0,05.","analises":"ITT planejada.","primario":"OS — em andamento (dados não publicados)","secundario":"rPFS, SSE-FS, tempo até progressão de ALP, QoL (FACT-P, BPI, BFI) — em andamento","subgrupo":"—","tox_g3":"Em andamento — perfil esperado: hematológico e GI do docetaxel + medular do Ra-223.","tox_interesse":"Em andamento; foco em mielotoxicidade aditiva.","impacto_reg":"Pode validar combinação Ra-223 + QT (cenário diferente do PEACE-3 que usou ARPi).","limit":"Recrutamento lento; uso de docetaxel em dose reduzida (60 vs 75 mg/m²) pode subestimar braço controle.","ref":"ClinicalTrials.gov NCT03574571","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe obrigatório durante todo o tratamento (proteção óssea — lição do ERA-223). Pré-medicação para docetaxel: dexametasona + anti-histamínico (prevenção de hipersensibilidade); antieméticos; G-CSF profilático conforme protocolo.","nct_url":"https://clinicaltrials.gov/study/NCT03574571","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_3"},{"estudo":"COMRADE (ASCO 2025)","acron":"COMRADE — Combination Olaparib + Radium-223 in mCRPC with bone metastases","nct":"NCT03317392","sponsor":"ETCTN / NCI | PI: Rana McKay / Heather Cheng","fase":"Fase 1/2 randomizada (ETCTN)","desenho":"Fase 1: 3+3 escalonamento de olaparib + Ra-223 fixo; Fase 2: randomização 1:1 olaparib + Ra-223 vs Ra-223 isolado.","centros":"Multicêntrico EUA (NCI)","periodo":"2018 - 2024","indicacao":"mCRPC com mets ósseas, ECOG 0-1, com ou sem mutação HRR","incl":"≥18a; ECOG 0-1; ≥2 mets ósseas; sem visceral; sem linfoadenomegalia >4 cm; sem Ra-223 prévio.","excl":"Visceral grande; mielotoxicidade pré-existente; uso de PARP prévio.","estrat":"Uso prévio de docetaxel; status HRR (em análise)","basal":"Mediana 70a; ECOG 0-1 em todos; status HRR mutado em ~25%; PSA mediano variável.","n":"Fase 2: 120 randomizados (59 + 59 após ajuste por erro de randomização inicial em 13)","molecular":"Cintilografia óssea + ctDNA (HRR); status HRR não obrigatório para inclusão (hipótese: benefício INDEPENDE de HRR).","biomarc":"ctDNA tumor fraction (prognóstica em ambos os braços), painel HRR (BRCA1/2, ATM etc.).","radiofarmaco":"223Ra + Olaparib","esquema":"Ra-223: 55 kBq/kg IV q4sem × 6 + Olaparib 200 mg PO BID (RP2D) contínuo","cumul":"Ra-223: 330 kBq/kg; olaparib até PD","comparador":"Ra-223 isolado (55 kBq/kg q4sem × 6) + bisfosfonato/denosumabe","estatistica":"Poder ~80% para rPFS HR 0,5; α 0,1 unilateral (early-phase).","analises":"ITT; análise por status HRR planejada.","primario":"rPFS: 8,9 vs 4,7 m (HR estratificado 0,47; IC 90% 0,34-0,65; p=0,0013) — REDUÇÃO DE 53%","secundario":"Subgrupo SEM doce prévio: rPFS 13,7 vs 5,7 m (HR 0,24) | Subgrupo ≤20 mets ósseas: rPFS 13,4 vs 4,2 m (HR 0,21) | ctDNA TF prognóstica.","subgrupo":"Benefício maior em pacientes sem doce prévio E com menor carga (≤20 mets); status HRR ainda em análise (hipótese: benefício mantido).","tox_g3":"Eventos ≥G3: 56% (combo) vs 33% (Ra-223 isolado). Linfopenia foi o evento principal (manejável); anemia G3 ~10%.","tox_interesse":"Linfocitopenia; sem excesso de SMD/leucemia em FU disponível; mielotoxicidade aditiva moderada.","impacto_reg":"Conceito proof-of-concept para combinação RLT + PARP em mCRPC. Benefício INDEPENDE de HRR (hipótese a confirmar). Pode abrir caminho para combos LuPSMA + PARP.","limit":"Fase 1/2 (não pivotal); n moderado; resultados de OS imaturos; randomização original com erro técnico (corrigido).","ref":"Hussain MH, et al. ASCO 2025; J Clin Oncol 2025;43(suppl 16):5007","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe obrigatório (proteção óssea). Atenção à toxicidade hematológica aditiva (linfopenia do PARPi + medular do Ra-223) — hemograma seriado. Antieméticos para olaparib.","nct_url":"https://clinicaltrials.gov/study/NCT03317392","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=COMRADE+2025","ano_pub":2025,"status":"Publicado","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_4"},{"estudo":"AlphaBet (em andamento)","acron":"AlphaBet — Combination Ra-223 + 177Lu-PSMA-I&T in mCRPC","nct":"NCT05383079","sponsor":"Peter MacCallum | PI: Shahneen Sandhu","fase":"Fase 1/2 (escalonamento + expansão)","desenho":"Single-arm; escalonamento de dose de Ra-223 com Lu-PSMA fixo, depois expansão.","centros":"Australia (multicêntrico)","periodo":"2022 - em recrutamento","indicacao":"mCRPC com mets ósseas, candidatos a 177Lu-PSMA","incl":"PSMA-PET+; FDG-PET sem discordância maior; mets ósseas; ECOG 0-2.","excl":"Mielotoxicidade pré-existente; uso prévio de Ra-223 ou Lu-PSMA.","estrat":"Por publicar","basal":"Por publicar","n":"~36 planejados","molecular":"PSMA-PET com SUVmax adequado; FDG-PET para excluir discordância.","biomarc":"PSA, dosimetria, ctDNA.","radiofarmaco":"223Ra + 177Lu-PSMA-I&T","esquema":"Ra-223 55 kBq/kg q6sem (escalonado) + Lu-PSMA-I&T 7,4 GBq q6sem; ambos × 6","cumul":"Ra-223: 330 kBq/kg; Lu-PSMA: 44,4 GBq","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol; foco em DLT.","primario":"DLT, MTD — em andamento","secundario":"PSA50, rPFS, tempo até SSE, QoL — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Combina alfa-emissor ósseo-trópico + radioligante PSMA — conceito 'duplo radiação'. Hipótese de sinergia.","limit":"n pequeno; sem comparador; toxicidade hematológica aditiva é risco.","ref":"ClinicalTrials.gov NCT05383079","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe obrigatório (proteção óssea pelo componente Ra-223). Hidratação peri-infusão para o componente Lu-PSMA; antieméticos.","nct_url":"https://clinicaltrials.gov/study/NCT05383079","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_5"},{"estudo":"RALU (JNM 2023; ESMO 2024)","acron":"RALU — 177Lu-PSMA after Radium-223: real-world safety/survival","nct":"Não-aplicável (estudo retrospectivo, multicêntrico)","sponsor":"Investigador-iniciado, multicentros europeus | PI: Oliver Sartor / Paolo Castellucci","fase":"Coorte multicêntrica retrospectiva (real-world)","desenho":"Análise retrospectiva de pacientes que receberam 223Ra seguido de 177Lu-PSMA na rotina; foco em segurança e desfechos sequenciais.","centros":"Vários centros europeus (Alemanha, Itália, Espanha, EUA)","periodo":"Coorte 2014-2022","indicacao":"mCRPC com mets ósseas que receberam 223Ra previamente e foram tratados sequencialmente com 177Lu-PSMA","incl":"Documentação completa de tratamento prévio com Ra-223 e início subsequente de 177Lu-PSMA; PSMA-PET+ adequado.","excl":"Tratamento concomitante; dados incompletos.","estrat":"Análise post-hoc por intervalo Ra-223 → Lu-PSMA, presença de viscerais, número de linhas prévias","basal":"Mediana 73a; 69% com ≥4 linhas prolongadoras de vida prévias; mediana 6 ciclos de Ra-223; 59% receberam ≥4 ciclos de Lu-PSMA.","n":"133 (análise final ESMO 2024); 78 publicados em JNM 2023; 49 na análise interina (JCO 2022)","molecular":"PSMA-PET+ adequado para indicação de 177Lu-PSMA (critérios variáveis por centro; não padronizado por se tratar de real-world).","biomarc":"PSA, contagem hematológica seriada; sem genômica obrigatória.","radiofarmaco":"Sequência 223Ra → 177Lu-PSMA-617","esquema":"Ra-223: até 6 ciclos × 55 kBq/kg q4sem | seguido por Lu-PSMA-617: mediana 4 ciclos × 7,4 GBq q6-8sem","cumul":"Ra-223: até 330 kBq/kg + Lu-PSMA: ~30 GBq mediana","comparador":"— (sem comparador formal; análise descritiva)","estatistica":"Descritiva; análises de sobrevida (KM); subanálises por intervalo entre RLTs.","analises":"Retrospectiva; análise de subgrupo por presença de viscerais (post-hoc).","primario":"Segurança hematológica + OS | OS mediana a partir do início do 177Lu-PSMA: 12,6 m (IC 8,8-16,1) | OS mediana a partir do início do 223Ra: 31,4 m (IC 25,7-37,6)","secundario":"PSA50 ~38-40%; tempo até progressão clínica/PSA semelhante a populações análogas pós-taxano sem 223Ra. Pacientes com viscerais tiveram OS pior (esperado).","subgrupo":"Sem prejuízo claro de eficácia ou segurança em diferentes janelas Ra-223 → Lu-PSMA; análise por presença de visceral mostrou OS pior nesse subgrupo.","tox_g3":"Eventos hematológicos G3-4 atribuídos ao 177Lu-PSMA (FU 30 d): anemia 18%, trombocitopenia 2%, neutropenia <5%, linfopenia G3-4 ~10-15%.","tox_interesse":"Sem aumento inesperado de toxicidade medular apesar do uso prévio de alfa-emissor ósseo. Sem sinais de SMD/leucemia precoce.","impacto_reg":"Principal evidência de SEGURANÇA E VIABILIDADE da sequência 223Ra → 177Lu-PSMA. Reforça que 223Ra prévio NÃO contraindica RLT subsequente, desde que função medular permita. Suporta sequenciamento racional.","limit":"Estudo RETROSPECTIVO (não randomizado); seleção de pacientes que toleraram Ra-223 (viés); sem padronização de PSMA-PET; comparação histórica.","ref":"Sartor O, Castellucci P, et al. J Nucl Med 2023;64:1058-1064; ESMO 2024 (final analysis)","category_id":"ra223_prostata","preparo":"Verificar protocolo específico do estudo.","nct_url":"","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/36302656/","ano_pub":2023,"status":"Publicado","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_6"},{"estudo":"RaCe2 (em andamento)","acron":"RaCe2 — Sequential Ra-223 and Cabazitaxel in mCRPC","nct":"NCT03002220","sponsor":"Acadêmico (Reino Unido)","fase":"Fase 2 (braço único)","desenho":"Single-arm; sequencial Ra-223 → cabazitaxel.","centros":"Multicêntrico Reino Unido","periodo":"Em andamento","indicacao":"mCRPC ósseo pós-docetaxel","incl":"Pós-doce; mets ósseas; bisfosfonato obrigatório.","excl":"Visceral grande; mielotoxicidade.","estrat":"Por publicar","basal":"Por publicar","n":"~50 planejados","molecular":"Cintilografia óssea (sem PET PSMA obrigatório).","biomarc":"PSA, ALP, biomarcadores ósseos.","radiofarmaco":"223Ra → Cabazitaxel sequencial","esquema":"Ra-223 55 kBq/kg q4sem × 6 → Cabazitaxel 25 mg/m² q3sem × 10","cumul":"Ra-223: 330 kBq/kg + cabaz: 250 mg/m²","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol; segurança e tolerabilidade.","primario":"Segurança e tolerabilidade da sequência","secundario":"rPFS, OS, PSA50, ALP response","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Avalia sequenciamento Ra-223 → cabaz para reforçar evidência de uso seguro em sequência.","limit":"n pequeno; sem comparador; resultados aguardados.","ref":"ClinicalTrials.gov NCT03002220","category_id":"ra223_prostata","preparo":"Bisfosfonato/denosumabe — recomendado isoladamente e obrigatório em combinações com ARPi (proteção óssea; lição do ERA-223). Sem pré-medicação específica para a infusão; hidratação opcional.","nct_url":"https://clinicaltrials.gov/study/NCT03002220","pubmed_url":"","ano_pub":0,"status":"Publicado","category_name":"223Ra · Próstata","category_short":"Ra-223","category_color":"#a855f7","uid":"ra223_prostata_7"},{"estudo":"NETTER-1 (2017/2021)","acron":"NETTER-1 — 177Lu-DOTATATE in midgut NET","nct":"NCT01578239","sponsor":"Advanced Accelerator Applications (AAA) / Novartis | PI: Jonathan Strosberg","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 1:1 a 177Lu-DOTATATE + LAR padrão vs LAR alta dose.","centros":"41 centros em 8 países (EUA + Europa)","periodo":"Set/2012 - Jan/2016","indicacao":"TNE midgut bem diferenciado (G1-G2, Ki-67 ≤20%) progressivo sob octreotide LAR padrão","incl":"≥18a; ECOG 0-2; TNE midgut bem dif; SSTR+ (cintilo OctreoScan ou 68Ga-DOTATATE); progressão por RECIST nos 3 anos prévios sob LAR padrão.","excl":"Ki-67 >20%; mets cerebrais; insuficiência renal/medular significativa.","estrat":"Captação SSTR (Krenning score ≥3 para todas lesões mensuráveis), tumor primário","basal":"Mediana 64a; ECOG 0-1 em 95%; mediana 1 linha LAR prévia; 80% mets hepáticas.","n":"Planejado 230; randomizados 229 (116 PRRT + 113 LAR alta dose); ITT 229","molecular":"Cintilografia 111In-octreotide ou PET 68Ga-DOTATATE com captação ≥ fígado (Krenning ≥3) em todas as lesões mensuráveis. Ki-67 ≤20%.","biomarc":"CgA, 5-HIAA urinário, NSE; análises retrospectivas de subtipos midgut.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate (Lutathera®)","esquema":"7,4 GBq IV q8sem × 4 ciclos + Octreotide LAR 30 mg q4sem (manutenção) durante e após PRRT","cumul":"29,6 GBq","comparador":"Octreotide LAR alta dose 60 mg q4sem (vs 30 mg padrão)","estatistica":"Poder 90% para PFS HR 0,49; α 0,05.","analises":"ITT para PFS; OS como secundário em hierarquia.","primario":"PFS (estimativa em 20 m): 65,2% vs 10,8% (p<0,0001) | PFS mediana: NÃO ATINGIDA (HR 0,21) vs 8,4 m","secundario":"ORR: 18% vs 3% (p<0,001) | OS final (Lancet Oncol 2021, FU 76 m): 48,0 vs 36,3 m (HR 0,84; IC 0,60-1,17; p=0,30) — NS por cross-over (36% LAR receberam PRRT na progressão) | QoL favoreceu PRRT","subgrupo":"Benefício consistente em subgrupos por SUVmax, idade, ECOG; midgut: ileal teve maior benefício.","tox_g3":"Eventos ≥G3: 41% vs 33%. Linfopenia G3-4 9%; trombocitopenia G3 2%; náusea G1-2 frequente (relacionada à infusão de aminoácidos).","tox_interesse":"Renal: sem toxicidade significativa (proteção com aminoácidos); SMD/leucemia em FU longo: ~2% (similar a séries de PRRT). Náusea/vômito durante infusão de aminoácidos é o evento mais comum (manejo: ondansetron + LSI tubular).","impacto_reg":"Aprovação FDA do Lutathera® (Jan/2018) e EMA (Set/2017). Padrão em TNE midgut SSTR+ progressivo. Diretrizes ENETS, NCCN.","limit":"Apenas midgut (TNE pancreático e outras localizações em outros estudos); OS não atingida na primária por cross-over significativo. Comparador 'alta dose' de LAR pode subestimar SoC moderno.","ref":"Strosberg J, et al. NEJM 2017;376:125-135; Strosberg J et al. Lancet Oncol 2021;22:1752-1763 (final OS)","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT01578239","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/28076709/","ano_pub":2017,"status":"Publicado","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_0"},{"estudo":"NETTER-2 (2024)","acron":"NETTER-2 — 177Lu-DOTATATE first-line in G2-G3 GEP-NET","nct":"NCT03972488","sponsor":"AAA / Novartis | PI: Simron Singh","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 2:1 a 177Lu-DOTATATE + LAR vs LAR alta dose; 1ª LINHA em G2-G3.","centros":"45 centros em 9 países","periodo":"Jan/2020 - Out/2022","indicacao":"TNE GEP G2 alto (Ki-67 10-20%) ou G3 baixo (Ki-67 21-55%), bem diferenciado, recém-diagnosticado, 1ª linha","incl":"≥15a; ECOG 0-2; GEP-NET bem dif G2 alto/G3 baixo; SSTR+ ao 68Ga-DOTATATE PET; recém-diagnosticado, sem QT prévia.","excl":"TNE pulmonar/midgut; G3 com Ki-67 >55% (TNE pouco dif); QT prévia.","estrat":"Idade <65 vs ≥65; grau (G2 vs G3); origem (pancreático vs não-pancreático)","basal":"Mediana 60a; ECOG 0-1 em 95%; pancreáticos 50%, midgut 13%, outros 37%; Ki-67 mediano 14% (G2) e 30% (G3); funcionantes 14%.","n":"Planejado 222; randomizados 226 (151 PRRT + 75 LAR alta dose); ITT 226","molecular":"PET 68Ga-DOTATATE OBRIGATÓRIO: captação ≥ fígado em todas as lesões mensuráveis. Ki-67 10-55%.","biomarc":"CgA, NSE; análises por grau e origem; subgrupo de funcionantes.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate (Lutathera®)","esquema":"7,4 GBq IV q8sem × 4 ciclos + Octreotide LAR 30 mg q4sem","cumul":"29,6 GBq","comparador":"Octreotide LAR alta dose 60 mg q4sem","estatistica":"Poder 90% para PFS HR 0,49; α 0,025.","analises":"ITT.","primario":"PFS: 22,8 vs 8,5 m (HR 0,28; IC 0,18-0,42; p<0,0001) — REDUÇÃO DE 72% NO RISCO","secundario":"PFS por subgrupo: G2 = 29,0 vs 13,8 m; G3 = 22,2 vs 5,6 m | ORR: 43,0% vs 9,3% (p<0,0001) — G2 ORR 40,4%, G3 ORR 48,1% | OS imatura | QoL favoreceu PRRT","subgrupo":"Magnitude de benefício SUPERIOR em G3 vs G2 (HR ~0,15-0,20 em G3; HR ~0,40 em G2); pancreáticos com benefício marcante.","tox_g3":"Eventos ≥G3: 35% vs 27%. Linfopenia G3-4 11%; leucopenia G3 2%; anemia G3 3%; náusea/diarreia G1-2.","tox_interesse":"Náusea relacionada a aminoácidos (manejo padrão); sem novos sinais de segurança.","impacto_reg":"Primeiro estudo a demonstrar eficácia de PRRT em PRIMEIRA LINHA em qualquer câncer. Atualização das diretrizes ENETS/NCCN (2024) para 177Lu-DOTATATE upfront em GEP G2-alto/G3-baixo SSTR+. Aprovação ampliada (FDA/EMA pendente).","limit":"Excluiu midgut (focado em GEP); OS imatura; dose-finding adicional pode ser necessário em G3 (talvez mais ciclos).","ref":"Singh S, et al. Lancet 2024;403:2807-2817; subanálise por grau Ann Oncol 2024;35:S919","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT03972488","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/38851203/","ano_pub":2024,"status":"Publicado","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_1"},{"estudo":"NETTER-P (em andamento)","acron":"NETTER-P — Pediatric/adolescent 177Lu-DOTATATE in NET","nct":"NCT04711135","sponsor":"AAA / Novartis","fase":"Fase 1/2, pediátrico/adolescente","desenho":"Single-arm; foco em farmacocinética, dosimetria e segurança em 12-17a.","centros":"Multicêntrico EUA/Europa","periodo":"2021 - em recrutamento","indicacao":"TNE GEP/midgut SSTR+ em pacientes ≥12 anos","incl":"Idade 12-17a; peso ≥45 kg; SSTR+; TNE bem dif; função renal/medular adequada.","excl":"Mets cerebrais; outras malignidades.","estrat":"—","basal":"Por publicar","n":"~10-15 planejados","molecular":"PET 68Ga-DOTATATE+ (mesmo critério de adultos).","biomarc":"Farmacocinética (Lu-177 plasmático, urinário); dosimetria por SPECT/CT; análise de função renal/medular evolutiva.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate","esquema":"7,4 GBq IV q8sem × 4 ciclos (pode ajustar por peso)","cumul":"29,6 GBq","comparador":"—","estatistica":"Descritivo (single-arm).","analises":"Per-protocol; foco PK/dosimetria.","primario":"Farmacocinética, dosimetria, segurança — em andamento","secundario":"ORR, PFS, dosimetria de órgãos críticos — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento — atenção especial para função renal e fertilidade futura.","impacto_reg":"Estende uso do Lutathera® para população pediátrica/adolescente; aprovado pela EMA dentro do estudo.","limit":"n pequeno; sem comparador; resultados de longo prazo essenciais (segunda neoplasia).","ref":"ClinicalTrials.gov NCT04711135","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT04711135","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_2"},{"estudo":"COMPETE (ENETS 2025)","acron":"COMPETE — 177Lu-Edotreotide vs Everolimus in G1/G2 GEP-NET","nct":"NCT03049189","sponsor":"ITM Radiopharma | PI: Marianne Pavel","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 2:1 a 177Lu-edotreotide vs everolimus; 1ª/2ª linha pós-LAR.","centros":"Multicêntrico EUA/Europa","periodo":"2017 - 2024","indicacao":"TNE GEP G1-G2 (Ki-67 ≤20%), inoperáveis, SSTR+, progressivos pós-LAR","incl":"≥18a; GEP-NET G1-G2 SSTR+ (cintilo ou PET 68Ga-DOTATATE); progressivo por RECIST nos 12 m prévios; pós-LAR.","excl":"Ki-67 >20%; mTOR inibidor prévio; QT prévia para mCRPC.","estrat":"Origem (pancreático vs não-pancreático); grau (G1 vs G2)","basal":"Mediana 65a; ECOG 0-1 em 92%; pancreáticos 45%; mediana de 1 linha prévia.","n":"Planejado 309; randomizados 309 (207 + 102)","molecular":"Cintilo OctreoScan ou PET 68Ga-DOTATATE positivo (Krenning ≥3); Ki-67 ≤20%.","biomarc":"CgA, NSE; análises pancreáticas vs não-pancreáticas.","radiofarmaco":"[177Lu]Lu-edotreotide (177Lu-DOTATOC, ITM-11) — análogo do octreotide (TOC) marcado","esquema":"7,5 GBq IV q12sem × 4 ciclos (intervalo MAIOR que NETTER)","cumul":"30 GBq","comparador":"Everolimus 10 mg/dia VO contínuo até PD ou intolerância","estatistica":"Poder ~80% para PFS HR 0,67; α 0,05.","analises":"ITT.","primario":"PFS: 23,9 vs 14,1 m (HR 0,67; IC 0,48-0,95; p=0,022)","secundario":"ORR central: 21,9% vs 4,2% (p<0,0001); local: 30,5% vs 8,4% | OS interina: 63,4 vs 58,7 m (HR 0,78; p=0,206; NS) | QoL favoreceu RLT","subgrupo":"Benefício consistente; pancreáticos vs não-pancreáticos com magnitude semelhante.","tox_g3":"TEAE relacionados ao tratamento: 82,5% (RLT) vs 97,0% (everolimus). Descontinuação por AE: 1,8% vs 15,2%. Hematológicos G3 baixos com PRRT.","tox_interesse":"Toxicidade hematológica reversível com RLT; toxicidade crônica importante com everolimus (estomatite, hiperglicemia, pneumonite).","impacto_reg":"Primeira vez que radiofármaco SUPERA terapia molecular alvo em fase 3 em GEP-NET. NDA aceito pela FDA (2025) para 177Lu-edotreotide. Posiciona ITM-11 como alternativa ao Lutathera®.","limit":"Comparador everolimus pode estar superado em alguns cenários (combinações com QT modernas); G1 vs G2 alto (vs NETTER-2) sem grande overlap.","ref":"Pavel M, et al. ENETS 2025 (Press release/abstract); Halfdanarson T et al. 2025","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT03049189","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=COMPETE+2025","ano_pub":2025,"status":"Publicado","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_3"},{"estudo":"OCCLURANDOM (ESMO GI 2024)","acron":"OCCLURANDOM — 177Lu-DOTATATE vs Sunitinib in advanced PNET","nct":"NCT02230176","sponsor":"Acadêmico francês (GETNE) | PI: Eric Baudin / Jérôme Cros","fase":"Fase 2 randomizada (academic)","desenho":"Randomização 1:1 a 177Lu-DOTATATE vs sunitinibe.","centros":"Multicêntrico francês","periodo":"2014 - 2020","indicacao":"TNE pancreático bem diferenciado, esporádico, progressivo","incl":"PNET esporádico bem dif; Ki-67 ≤20%; SSTR+; progressivo (RECIST/clínico) nos 12 m prévios.","excl":"MEN1/VHL/NF1; mTOR/sunitinibe prévio; metástase cerebral.","estrat":"Centro; status funcional (sintomático vs não)","basal":"Mediana 65a; ECOG 0-1 em 90%; funcionantes ~30%.","n":"Planejado 84; randomizados 84","molecular":"Cintilo SSTR ou PET 68Ga-DOTATATE+; Ki-67 ≤20%.","biomarc":"CgA, glicemia (insulinomas); painel hormonal específico.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate","esquema":"7,4 GBq IV q8sem × 4 ciclos","cumul":"29,6 GBq","comparador":"Sunitinibe 37,5 mg/dia VO contínuo até PD/intolerância","estatistica":"Poder ~80% para PFS em 12 m (40% vs 70%); α 0,05.","analises":"ITT.","primario":"PFS em 12 m: 80,5% (LuDOTATATE) vs 42% (sunitinibe) | PFS mediana: 20,7 vs 11,0 m","secundario":"ORR favoreceu PRRT; QoL favoreceu PRRT.","subgrupo":"Benefício consistente.","tox_g3":"G3+ — fadiga 7% vs 12%; redução hematológica 12% vs 24%; HAS 12% vs 19%. Perfil mais favorável com PRRT.","tox_interesse":"Tolerabilidade a longo prazo: PRRT melhor (eventos crônicos do sunitinibe são limitantes).","impacto_reg":"Primeiro RCT de PRRT em PNET. Influenciou desenho do COMPOSE. Posiciona PRRT precoce em PNET progressivo.","limit":"Fase 2 (não pivotal); n moderado; sem ajuste para cross-over.","ref":"Baudin E, et al. ESMO GI 2024; J Clin Oncol 2024;42(suppl)","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT02230176","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=OCCLURANDOM+2024","ano_pub":2024,"status":"Publicado","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_4"},{"estudo":"COMPOSE (em andamento)","acron":"COMPOSE — 177Lu-Edotreotide vs SoC (chemo or everolimus) in aggressive G2-G3 GEP-NET","nct":"NCT04919226","sponsor":"ITM Radiopharma | PI: Thorvardur Halfdanarson","fase":"Fase 3, randomizada, aberta","desenho":"Randomização 1:1 a LuTOC vs SoC (escolha investigador: CAPTEM, FOLFOX ou everolimus).","centros":"Multicêntrico mundial","periodo":"2021 - em recrutamento","indicacao":"TNE GEP G2-G3 bem diferenciados agressivos (Ki-67 15-55%), 1ª/2ª linha","incl":"≥18a; GEP-NET bem dif G2-G3; Ki-67 15-55%; SSTR+; sem QT prévia (1ª linha) ou 1 linha prévia.","excl":"Ki-67 >55%; PRRT prévia; ECOG 3-4.","estrat":"Por publicar","basal":"Por publicar","n":"202 planejados (1:1)","molecular":"PET 68Ga-DOTATATE+; Ki-67 15-55%.","biomarc":"CgA, NSE, dosimetria.","radiofarmaco":"[177Lu]Lu-edotreotide (ITM-11)","esquema":"7,5 GBq IV q12sem × 4 ciclos","cumul":"30 GBq","comparador":"Investigador escolhe: CAPTEM (capecitabina + temozolamida) OU FOLFOX OU everolimus","estatistica":"Por publicar","analises":"ITT planejada.","primario":"PFS — em andamento (dados não publicados)","secundario":"OS, ORR, QoL, PROs — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Complementa COMPETE em pacientes G2 alto/G3 agressivos; pode consolidar 177Lu-edotreotide em alternativa ao Lutathera®.","limit":"Aguardando resultados; comparador heterogêneo (CAPTEM/FOLFOX/everolimus).","ref":"Halfdanarson T et al. Ann Oncol 2022;33:S919; ClinicalTrials.gov NCT04919226","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT04919226","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_5"},{"estudo":"NETTER-3 (em andamento)","acron":"NETTER-3 — Optimization of 177Lu-DOTATATE in NET","nct":"NCT06710184","sponsor":"AAA / Novartis","fase":"Fase 3 (próxima geração)","desenho":"Randomizado, otimização de regimes (manutenção, retratamento, combinações).","centros":"Multicêntrico planejado","periodo":"2024 - em planejamento","indicacao":"TNE GEP G1-G2 progressivos pós-LAR","incl":"Por publicar","excl":"Por publicar","estrat":"Por publicar","basal":"—","n":"Planejado","molecular":"PET 68Ga-DOTATATE+","biomarc":"Por publicar","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate","esquema":"Esquemas em estudo (manutenção, intensificado, fracionado)","cumul":"Variável","comparador":"SoC (everolimus ou outras)","estatistica":"Por publicar","analises":"Por publicar","primario":"PFS — em planejamento","secundario":"OS, segurança, dose absorvida, biomarcadores — em planejamento","subgrupo":"—","tox_g3":"—","tox_interesse":"—","impacto_reg":"Próxima geração de estudos com Lutathera®, otimizando regimes (manutenção, retratamento).","limit":"Em planejamento; sem dados ainda.","ref":"ClinicalTrials.gov NCT06710184","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT06710184","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_6"},{"estudo":"PReCedeNT (em andamento)","acron":"PReCedeNT — Re-PRRT (retratamento) com 177Lu-DOTATATE","nct":"NCT06465069","sponsor":"Multinacional acadêmico","fase":"Fase 2","desenho":"Single-arm; retratamento em pacientes com resposta prévia à PRRT.","centros":"Planejado multicêntrico","periodo":"2024 - em recrutamento","indicacao":"TNE GEP G1-G2 SSTR+ pós-PRRT (retratamento)","incl":"Resposta documentada à PRRT prévia (CR/PR/SD ≥6 m); progressão >12 m após última dose; SSTR+ persistente.","excl":"Toxicidade renal/medular significativa após PRRT prévia; dose cumulativa total >100 Gy renal ou 2 Gy medular.","estrat":"Por publicar","basal":"Por publicar","n":"Planejado","molecular":"PET 68Ga-DOTATATE+ persistente.","biomarc":"CgA, dosimetria cumulativa renal/medular.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate","esquema":"7,4 GBq q8sem × 2-4 ciclos (depende dosimetria cumulativa)","cumul":"14,8-29,6 GBq adicionais","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol; foco em segurança.","primario":"PFS, segurança no retratamento — em andamento","secundario":"ORR, dosimetria cumulativa, toxicidade renal/hematológica longa — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento — atenção a toxicidade renal/medular cumulativa.","impacto_reg":"Aborda questão clínica do retratamento: papel formal de PRRT seriada.","limit":"Aguardando dados.","ref":"ClinicalTrials.gov NCT06465069","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF; iniciados ~30 min antes e mantidos por ~4 h após — reduzem reabsorção tubular do peptídeo). Antieméticos potentes (setrons + aprepitanto se necessário). Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT06465069","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_7"},{"estudo":"PRRT em PHEO/PGL (Pryma JCO 2025; JNM 2026)","acron":"177Lu-DOTATATE em feocromocitoma/paraganglioma metastático","nct":"Múltiplos (NCT04157816, NCT03206060, séries)","sponsor":"Coortes prospectivas multicêntricas","fase":"Fase 2 / coortes prospectivas","desenho":"Single-arm (maioria); foco em segurança e eficácia em PPGL.","centros":"Multicêntrico mundial","periodo":"2018 - 2025","indicacao":"PHEO/PGL metastáticos/inoperáveis SSTR+","incl":"PHEO ou PGL metastático; SSTR+ (PET 68Ga-DOTATATE com captação > fígado); pré-α-bloqueio se funcionantes.","excl":"Crise HAS não controlada; insuficiência cardíaca grave.","estrat":"Mutação SDHB+/-; primário (head-and-neck vs adrenal vs visceral)","basal":"Mediana 50a; mutação SDHB em ~30-40%; funcionantes em 60-70%.","n":"Coortes 30-50 (multicêntricas); >200 acumulados","molecular":"PET 68Ga-DOTATATE+ (Krenning ≥3) > captação hepática.","biomarc":"Catecolaminas (metanefrinas plasmáticas/urinárias), CgA, mutação SDHB.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate","esquema":"7,4 GBq IV q8sem × 4 ciclos","cumul":"29,6 GBq","comparador":"—","estatistica":"Descritiva.","analises":"Per-protocol.","primario":"ORR ~29% (PR predominantemente); SD ~58%; DCR ~87% | PFS ~26,9 m; OS ~54,8 m","secundario":"Controle sintomático (catecolaminas) em ~75-90%; melhora de QoL.","subgrupo":"Mutação SDHB+ tem prognóstico pior mas também pode responder.","tox_g3":"Eventos hematológicos G3-4 baixos (<5%); náusea/vômitos manejáveis.","tox_interesse":"CRISES HIPERTENSIVAS: risco real durante infusão (manejar com α-bloqueio prévio + UTI se necessário); toxicidade renal mínima com aminoácidos.","impacto_reg":"Alternativa eficaz e tolerável ao 131I-MIBG em PHEO/PGL SSTR+. Especialmente útil quando captação MIBG é fraca ou refratário. Off-label, mas amplamente usado em centros experientes.","limit":"Sem RCT pivotal em PPGL; uso off-label; dados de longo prazo em populações pequenas.","ref":"Pryma DA, et al. JCO 2025; J Nucl Med 2026; Vyakaranam AR et al. 2019","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF, iniciados ~30 min antes e mantidos por ~4 h após). Antieméticos potentes (setrons + aprepitanto). PPGL: α-bloqueio prévio (fenoxibenzamina ou doxazosina) obrigatório em funcionantes; β-bloqueio se taquiarritmia; monitorização cardíaca/UTI peri-procedimento em alto risco. Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT04157816","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/40829092/","ano_pub":2025,"status":"Publicado","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_8"},{"estudo":"LuDO-N (Front Pediatr 2022)","acron":"LuDO-N — Personalized 177Lu-DOTATATE in pediatric high-risk neuroblastoma","nct":"NCT04903899","sponsor":"Acadêmico (Karolinska, Suécia) | PI: Anna Sundlöv","fase":"Fase 2 pediátrica","desenho":"Single-arm; dose personalizada por dosimetria absorvida (whole-body), 2 administrações de alta atividade q2sem.","centros":"Multicêntrico europeu","periodo":"2020 - em recrutamento","indicacao":"Neuroblastoma de alto risco refratário/recidivado, SSTR+","incl":"Idade 18 m-18a; NB alto risco refratário/recidivado; SSTR+ ao PET 68Ga-DOTATATE; falha à terapia padrão.","excl":"Insuficiência renal/medular grave; mets cerebrais não controladas.","estrat":"Idade; status MIBG (negativo prioritário)","basal":"Mediana 5a; ECOG/Lansky variável; refratários multi-tratados.","n":"~40 planejados","molecular":"PET 68Ga-DOTATATE+ (Krenning ≥3).","biomarc":"Dosimetria por SPECT/CT (corpo inteiro); função renal seriada.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate (uso pediátrico aprovado pela EMA dentro do estudo)","esquema":"Atividade individualizada por DOSIMETRIA (alvo de dose absorvida total ao corpo); 2 administrações de alta atividade q2sem","cumul":"Alvo de 2-3 Gy whole-body (variável)","comparador":"—","estatistica":"Descritivo.","analises":"Per-protocol.","primario":"ORR (RECIST/INRC) — em andamento","secundario":"PFS, OS, segurança, dosimetria personalizada — em andamento","subgrupo":"—","tox_g3":"Tox hematológica esperada (linfopenia, plaquetopenia); aceitável em séries menores (DCR ~83%).","tox_interesse":"Função renal e fertilidade futura; segundo tumor primário em FU longo.","impacto_reg":"PRRT pediátrica aprovada pela EMA dentro do estudo. Alternativa ao 131I-MIBG quando captação ausente.","limit":"n pequeno; população órfã; resultados de longo prazo essenciais.","ref":"Sundlöv A, et al. Front Pediatr 2022;10:836230; ClinicalTrials.gov NCT04903899","category_id":"lu_dotatate_net","preparo":"Aminoácidos renoprotetores obrigatórios com ajuste pediátrico por peso/idade. Antieméticos potentes; sedação/anestesia conforme idade; hidratação rigorosa; controle de exposição familiar/equipe (radioproteção pediátrica); função renal e medular seriadas.","nct_url":"https://clinicaltrials.gov/study/NCT04903899","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/35359899/","ano_pub":2022,"status":"Em andamento","category_name":"177Lu-DOTATATE · NET","category_short":"Lu-DOTATATE","category_color":"#10b981","uid":"lu_dotatate_net_9"},{"estudo":"PRadR (BMC Cancer 2024)","acron":"PRadR — PSMA-targeted RLT in metastatic ccRCC","nct":"NCT06059014","sponsor":"Acadêmico francês (Institut Curie)","fase":"Fase 1/2 (braço único, multicêntrico)","desenho":"Single-arm; fase 1 para segurança, fase 2 para eficácia (DCR-24sem).","centros":"Multicêntrico francês","periodo":"Nov/2023 - em recrutamento","indicacao":"ccRCC metastático pós-falha a TKI e ICI (≥2ª linha)","incl":"≥18a; ECOG 0-2; ccRCC histologicamente confirmado; mets PSMA+ ao PET 68Ga-PSMA-11; pós-TKI E pós-ICI.","excl":"Mets cerebrais não controladas; insuficiência renal/medular grave (ClCr <40, plaq <100k).","estrat":"Por publicar","basal":"Por publicar","n":"48 planejados","molecular":"PET 68Ga-PSMA-11 com captação significativa nas lesões metastáticas (Krenning equivalente ≥3).","biomarc":"Análises de dosimetria; PSMA SUVmax; biomarcadores renais.","radiofarmaco":"[177Lu]Lu-PSMA-617 (denominado PSMA-1 no estudo)","esquema":"7,4 GBq IV q6sem × 4 ciclos","cumul":"29,6 GBq (4 ciclos)","comparador":"— (single-arm)","estatistica":"Fase 1: incidência de toxicidade severa nos 6 primeiros sem (3+3); fase 2: DCR-24sem (RECIST 1.1).","analises":"Per-protocol.","primario":"Fase 1: incidência de toxicidade severa | Fase 2: DCR-24 sem (RECIST 1.1) — em andamento","secundario":"ORR, PFS, OS, dosimetria — em andamento","subgrupo":"—","tox_g3":"Em andamento — dados de segurança preliminares aceitáveis.","tox_interesse":"Sialoadenite (xerostomia) menor que em próstata (carga tumoral menor); função renal a ser monitorada.","impacto_reg":"Primeiro estudo prospectivo de PSMA-RLT em ccRCC. Aproveita superexpressão de PSMA na neovasculatura tumoral (mutação VHL/HIF). Pioneiro para uso de RLT em câncer renal.","limit":"Single-arm (sem comparador); pode haver heterogeneidade na captação PSMA por paciente.","ref":"Verzoni E, et al. BMC Cancer 2024;24:46; ClinicalTrials.gov NCT06059014","category_id":"lupsma_ccrcc","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT06059014","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/38302933/","ano_pub":2024,"status":"Em andamento","category_name":"177Lu-PSMA · ccRCC","category_short":"Lu-PSMA-RCC","category_color":"#06b6d4","uid":"lupsma_ccrcc_0"},{"estudo":"RENALUT (EORTC-2361, ESMO 2025)","acron":"RENALUT — 177Lu-PSMA-617 in 2nd/3rd line metastatic ccRCC (EORTC)","nct":"NCT06783348","sponsor":"EORTC + Novartis | PI: Verzoni / Pignot","fase":"Fase 2 (braço único, multicêntrico europeu)","desenho":"Single-arm; 4 ciclos básicos + 2 adicionais opcionais se SD/PR.","centros":"Multicêntrico EORTC (Europa)","periodo":"Set/2025 - em recrutamento","indicacao":"ccRCC metastático após TKI + ICI (2ª/3ª linha)","incl":"≥18a; ccRCC; pós-progressão a TKI E ICI; PSMA-PET com captação tumoral significativa; ECOG 0-2; função renal preservada.","excl":"Mets cerebrais não controladas; PSMA-PET sem captação; insuficiência renal grave.","estrat":"Por publicar","basal":"Por publicar","n":"Planejado ~48","molecular":"PET 68Ga-PSMA-11 com captação significativa.","biomarc":"Dosimetria, ctDNA, biomarcadores VHL/HIF.","radiofarmaco":"[177Lu]Lu-PSMA-617 (Pluvicto®)","esquema":"7,4 GBq q6sem × 4 ciclos + 2 opcionais (até 6)","cumul":"29,6-44,4 GBq","comparador":"—","estatistica":"Por publicar; ORR como endpoint primário.","analises":"Per-protocol.","primario":"ORR (RECIST 1.1) — em andamento","secundario":"PFS, OS, segurança, biomarcadores PSMA — em andamento","subgrupo":"—","tox_g3":"Em andamento — primeiro paciente recrutado em set/2025.","tox_interesse":"Em andamento.","impacto_reg":"Estudo EORTC liderando expansão de PSMA-RLT além da próstata. Resultados ainda não disponíveis. Amplia panorama do teranóstico para ccRCC.","limit":"n moderado; sem comparador.","ref":"EORTC 2361; Eur Urol Open Sci 2025;75; ESMO 2025","category_id":"lupsma_ccrcc","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT06783348","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/41073165/","ano_pub":2361,"status":"Em andamento","category_name":"177Lu-PSMA · ccRCC","category_short":"Lu-PSMA-RCC","category_color":"#06b6d4","uid":"lupsma_ccrcc_1"},{"estudo":"LASER (J Nucl Med 2026)","acron":"LASER — 177Lu-PSMA-617 in refractory ccRCC (Dana-Farber)","nct":"NCT06959433","sponsor":"Dana-Farber Cancer Institute | PI: Toni Choueiri","fase":"Fase 2 (braço único, EUA)","desenho":"Single-arm; foco em ORR/DCR e dosimetria.","centros":"Single-center expandido (Dana-Farber + colaboradores)","periodo":"2024 - em recrutamento","indicacao":"ccRCC metastático refratário a TKI + ICI","incl":"ccRCC com PSMA-PET+ ; falha a terapias padrão.","excl":"Por publicar","estrat":"Por publicar","basal":"Por publicar","n":"Planejado ~30","molecular":"PSMA-PET+ com captação significativa.","biomarc":"Dosimetria detalhada; análises moleculares de VHL.","radiofarmaco":"[177Lu]Lu-PSMA-617","esquema":"Esquema padrão q6sem (até 6 ciclos)","cumul":"≤44,4 GBq","comparador":"—","estatistica":"Por publicar; ORR e DCR como endpoints.","analises":"Per-protocol.","primario":"ORR e DCR — em andamento","secundario":"PFS, OS, dosimetria, biomarcadores — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Estudo norte-americano (Dana-Farber) complementar ao PRadR/RENALUT. Conjunto desses estudos definirá papel do PSMA-RLT em ccRCC PSMA+.","limit":"Aguardando dados.","ref":"Choueiri TK, et al. J Nucl Med 2026;67:501; Dana-Farber Trial 25-216","category_id":"lupsma_ccrcc","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT06959433","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=LASER+2026","ano_pub":2026,"status":"Em andamento","category_name":"177Lu-PSMA · ccRCC","category_short":"Lu-PSMA-RCC","category_color":"#06b6d4","uid":"lupsma_ccrcc_2"},{"estudo":"SARAH (2017)","acron":"SARAH — Sorafenib vs Radioembolization in Advanced HCC (FFCD)","nct":"NCT01482442","sponsor":"Acadêmico francês (FFCD) | PI: Valérie Vilgrain","fase":"Fase 3, francesa, randomizada, aberta","desenho":"Randomização 1:1 a TARE Y-90 resina vs sorafenibe.","centros":"25 centros franceses","periodo":"Dez/2011 - Mar/2015","indicacao":"HCC localmente avançado (BCLC C ou B refratário a TACE), inoperável","incl":"≥18a; ECOG 0-1; Child-Pugh A/B7; HCC histológico ou imagiológico; TVP permitida; sem mets extra-hepáticas dominantes.","excl":"TVP main + Child-Pugh B8+; mets extra-hepáticas dominantes; QT sistêmica prévia.","estrat":"Centro; presença de TVP","basal":"Mediana 67a; HCV/álcool predominantes; TVP em ~63%; BCLC C em ~78%.","n":"Planejado 400; randomizados 467 (237 + 222); ITT 467; treated 226 vs 216","molecular":"AFP basal; sem biomarcadores genômicos.","biomarc":"AFP, função hepática (Child-Pugh, MELD); LDH; albumina.","radiofarmaco":"90Y-microsferas de RESINA (SIR-Spheres®)","esquema":"Dose única; planejamento BSA/MIRD (NÃO personalizada); dose mediana ~22,3 GBq teórico calculado","cumul":"Dose única (pode repetir se necessário)","comparador":"Sorafenibe 800 mg/dia VO contínuo até PD/intolerância","estatistica":"Poder 80% para OS HR 0,75; α 0,05 bilateral.","analises":"ITT.","primario":"OS: 8,0 vs 9,9 m (HR 1,15; IC 0,94-1,41; p=0,18) — NEGATIVO em ITT","secundario":"PFS: sem diferença | ORR (mRECIST): 19% vs 11,6% (favoreceu TARE) | QoL: melhor com TARE | Progressão hepática como 1º evento: menor com TARE","subgrupo":"Subgrupos sugerindo benefício em pacientes que receberam dose tumoral adequada (>200 Gy) em análise post-hoc (Garin E, Radiology 2020).","tox_g3":"Eventos ≥G3: TARE 41% vs sorafenibe 63%. TARE menor toxicidade global (menos hand-foot, diarreia, HAS, alopecia).","tox_interesse":"Sorafenibe: hand-foot 54%, diarreia 30%, HAS 15%, alopecia 10%, fadiga 26%. TARE: dor abdominal, fadiga, ascite (controlável).","impacto_reg":"Resultado NEGATIVO em OS. NÃO MUDOU prática para TARE em 1ª linha vs sorafenibe. Mas mostrou perfil de toxicidade favorável e pavimentou discussão sobre necessidade de DOSIMETRIA PERSONALIZADA (vide DOSISPHERE-01).","limit":"Dosimetria NÃO PERSONALIZADA (BSA/MIRD); inclusão de muitos BCLC C com TVP main; centros com curva de aprendizado heterogênea.","ref":"Vilgrain V, et al. Lancet Oncol 2017;18:1624-1636; Garin E et al. Radiology 2020;291:792","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT01482442","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/29413470/","ano_pub":2017,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_0"},{"estudo":"SIRveNIB (2018)","acron":"SIRveNIB — SIRT vs Sorafenib in HCC, Asia-Pacific","nct":"NCT01135056","sponsor":"Acadêmico Asia-Pacific | PI: Pierce Chow","fase":"Fase 3, asiática, randomizada, aberta","desenho":"Randomização 1:1 a TARE Y-90 resina vs sorafenibe.","centros":"27 centros em 11 países Asia-Pacific (HBV-predominante)","periodo":"Out/2010 - Mai/2015","indicacao":"HCC localmente avançado, BCLC B/C, Asia-Pacific","incl":"≥18a; ECOG 0-1; Child-Pugh A; sem mets extra-hepáticas; HCC HBV-predominante.","excl":"Mets extra-hepáticas; Child-Pugh B+.","estrat":"País; tamanho do tumor","basal":"Mediana 60a; HBV em ~71%; ECOG 0 em ~68%; BCLC C em ~57%; TVP em ~56%.","n":"Planejado 360; randomizados 360 (182 + 178); ITT 360; treated 130 vs 162","molecular":"AFP; sem genômica.","biomarc":"AFP, função hepática.","radiofarmaco":"90Y-microsferas de RESINA (SIR-Spheres®)","esquema":"Dose única; planejamento BSA/MIRD","cumul":"Dose única","comparador":"Sorafenibe 800 mg/dia","estatistica":"Poder 80% para OS HR 0,67; α 0,05.","analises":"ITT.","primario":"OS ITT: 8,5 vs 10,6 m (HR 1,17; p=0,20) — NEGATIVO","secundario":"ORR ITT: 16,5% vs 1,7% (p<0,001); ORR (treated): 23,1% vs 1,9% | QoL melhor com TARE.","subgrupo":"Pacientes BCLC B podem ter benefício maior; etiologia HBV vs HCV sem diferença significativa.","tox_g3":"Eventos ≥G3: 27,7% (TARE) vs 50,6% (sorafenibe) — p<0,0001. TARE com perfil muito mais favorável.","tox_interesse":"TARE: dor abdominal, fadiga; sem hand-foot/HAS/alopecia. Sorafenibe: hand-foot 54,9%, diarreia 29,6%, HAS 14,8%, alopecia 9,9%.","impacto_reg":"Confirma SARAH em outra geografia: sem ganho de OS, mas perfil de toxicidade muito melhor. Suporta TARE em pacientes intolerantes a sorafenibe.","limit":"Idem SARAH (sem dosimetria personalizada; alta proporção que não recebeu tratamento — só 130/182 receberam TARE).","ref":"Chow PKH, et al. J Clin Oncol 2018;36:1913-1921","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT01135056","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/29498924/","ano_pub":2018,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_1"},{"estudo":"DOSISPHERE-01 (2021)","acron":"DOSISPHERE-01 — Personalized vs Standard Dosimetry in TARE Y-90 for HCC","nct":"NCT02582034","sponsor":"Acadêmico francês (Saint-Pierre Hôpital) | PI: Etienne Garin","fase":"Fase 2, francesa, randomizada","desenho":"Randomização 1:1 a TARE Y-90 vidro com DOSIMETRIA PERSONALIZADA (PDA, ≥205 Gy no tumor) vs DOSIMETRIA PADRÃO (SDA, 120 Gy no perfundido).","centros":"4 centros franceses","periodo":"2015 - 2018","indicacao":"HCC localmente avançado (≥1 lesão ≥7 cm), Child-Pugh A/B7, com ou sem TVP","incl":"≥18a; ECOG 0-1; Child-Pugh A/B7; HCC ≥7 cm em ≥1 lesão; dosimetria preditiva com 99mTc-MAA SPECT/CT.","excl":"Mets extra-hepáticas; descompensação hepática.","estrat":"Por publicar (centro)","basal":"Mediana 65a; HCV/álcool predominantes; tumores grandes; TVP em ~50%.","n":"Planejado 60; randomizados 60 (28 PDA + 28 SDA + 4 excluídos)","molecular":"AFP; análise de dose absorvida intra-tumoral.","biomarc":"AFP, função hepática; dosimetria por SPECT/CT pós-injeção.","radiofarmaco":"90Y-microsferas de VIDRO (TheraSphere® / BTG)","esquema":"PDA: dose ajustada para ≥205 Gy no tumor (mediana ~232 Gy) | SDA: 120 Gy no perfundido (dose tumoral mediana ~120-180 Gy)","cumul":"Dose única; pode ser repetida","comparador":"TARE Y-90 vidro com dosimetria padrão (SDA) — controle ativo","estatistica":"Poder 80% para diferença de ORR (40 vs 70%); α 0,05.","analises":"ITT.","primario":"ORR (3 m): 71% (PDA) vs 36% (SDA) (p=0,0074)","secundario":"OS mediana: 26,6 vs 10,7 m (HR 0,42 favoreceu PDA, sustentado em FU 65,8 m) | Downstaging para resseção: PDA muito superior | Resposta sustentada em portadores de TVP.","subgrupo":"Benefício em TVP particularmente notável; resposta completa em ~25% no PDA.","tox_g3":"Sem aumento significativo de toxicidade hepática G3-4 com PDA, apesar de doses tumorais maiores. Bilirrubinemia e disfunção hepática semelhantes.","tox_interesse":"Sem REILD (radiation-induced liver disease) clinicamente significativa; sem aumento de descompensação Child-Pugh.","impacto_reg":"PIVOTAL: estabelece DOSIMETRIA PERSONALIZADA como padrão moderno de TARE. Mostra que cumprimento de dose-limiar tumoral muda desfechos. Mudou prática mundial. Diretrizes EASL/SIR/EANM/SNMMI atualizadas.","limit":"n pequeno (60 pacientes); fase 2; uso restrito a centros com expertise dosimétrica.","ref":"Garin E, et al. Lancet Gastroenterol Hepatol 2021;6:17-29; FU longo Hepatology 2024","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT02582034","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/33166497/","ano_pub":2021,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_2"},{"estudo":"LEGACY (2021)","acron":"LEGACY — Local hepatocellular carcinoma in early stages: Y-90 in unifocal HCC ≤8 cm","nct":"NCT03447522 (registro retrospectivo)","sponsor":"BTG/Boston Scientific (TheraSphere®)","fase":"Coorte multicêntrica retrospectiva (registro)","desenho":"Retrospectivo, single-arm; pacientes de 3 centros US tratados com TheraSphere® em HCC unifocal ≤8 cm.","centros":"3 centros EUA (Northwestern, Mount Sinai, MGH)","periodo":"2014 - 2017","indicacao":"HCC unifocal ≤8 cm, Child-Pugh A, BCLC A ou C (PS 1)","incl":"HCC solitário inoperável ≤8 cm; lesão acessível por arteriografia segmentar; Child-Pugh A; ECOG 0-1.","excl":"Multifocal; >8 cm; Child-Pugh B+.","estrat":"Tamanho; etiologia","basal":"Mediana 67a; HCV/álcool predominantes; tamanho mediano 2,7 cm; uso como ponte para transplante em ~30%.","n":"162 pacientes","molecular":"AFP basal.","biomarc":"AFP; função hepática.","radiofarmaco":"90Y-microsferas de VIDRO (TheraSphere®)","esquema":"Radiação SEGMENTAR (alta dose em pequeno volume), dose mediana ≥190 Gy","cumul":"Dose única","comparador":"—","estatistica":"Descritivo.","analises":"Per-protocol; análise de resposta por mRECIST.","primario":"ORR (mRECIST): 88,3%, com CR 62% | Duração de resposta >6 m: 76,1%","secundario":"OS mediana: 57,9 m | OS 3 anos: 86,6% | OS 3 anos em ponte para transplante/resseção: 92,8%","subgrupo":"Resposta excelente independente de tamanho até 8 cm; pacientes ponte ao transplante com excelente sobrevida pós-cirurgia.","tox_g3":"Tolerabilidade excelente; G3 raro. Sem REILD significativa.","tox_interesse":"Sem toxicidade biliar grave; sem fístulas; sem necrose extensa não-alvo.","impacto_reg":"Suportou aprovação da FDA do TheraSphere® para HCC (Mar/2021). Conceito de RADIATION SEGMENTECTOMY com intenção curativa. Base para uso em ponte ao transplante.","limit":"Retrospectivo; 3 centros de excelência (selection bias); sem comparador.","ref":"Salem R, et al. Hepatology 2021;74:2342-2352","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT03447522","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/33739462/","ano_pub":2021,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_3"},{"estudo":"RASER (Lancet Gastro 2022)","acron":"RASER — Radiation Segmentectomy with curative intent in early HCC","nct":"NCT03319238","sponsor":"Mount Sinai | PI: Edward Kim","fase":"Fase 2 (braço único)","desenho":"Single-center prospective; foco em CR sustentada e necrose patológica.","centros":"1 centro (Mount Sinai)","periodo":"2018 - 2021","indicacao":"HCC unifocal ≤3 cm, inelegível para ablação por localização","incl":"Idade ≥18a; HCC solitário ≤3 cm; Child-Pugh A-B7; ECOG 0; localização desfavorável para RFA/MWA (subcapsular, próximo a vias biliares).","excl":"Mets distantes; Child-Pugh B8+; multifocal.","estrat":"—","basal":"Mediana 68a; HCV em ~45%; tamanho mediano 1,9 cm.","n":"29 (avaliáveis); 39 inicialmente recrutados","molecular":"AFP.","biomarc":"AFP, dosimetria detalhada.","radiofarmaco":"90Y-microsferas de VIDRO (TheraSphere®)","esquema":"Doses curativas (>400 Gy ao tumor); single segmental","cumul":"Dose única","comparador":"—","estatistica":"Descritivo; pCR como endpoint primário.","analises":"Per-protocol.","primario":"ORR inicial: 100% (CR 83%, PR 17%) | Resposta completa sustentada: 90%","secundario":"Padrão patológico em peças cirúrgicas: necrose 100% no alvo | Local recidiva: muito baixa.","subgrupo":"—","tox_g3":"G3 em 14% (leucopenia) e 7% (plaquetopenia); sem eventos hepáticos graves.","tox_interesse":"Sem fístulas biliares; sem REILD; tolerabilidade excelente.","impacto_reg":"Demonstra TARE com intenção CURATIVA em HCC pequeno em local desfavorável a ablação. Impacto direto no manejo de HCC inicial: alternativa robusta à RFA em casos selecionados.","limit":"n pequeno; single-center; sem comparação direta com RFA.","ref":"Kim E, et al. Lancet Gastroenterol Hepatol 2022;7:843-850","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT03319238","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/35617978/","ano_pub":2022,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_4"},{"estudo":"PREMIERE (JVIR 2016)","acron":"PREMIERE — Y-90 Glass vs cTACE in unresectable HCC","nct":"NCT00956930","sponsor":"Northwestern | PI: Riad Salem","fase":"Fase 2 randomizada","desenho":"Randomização 1:1 a TARE Y-90 vidro vs cTACE.","centros":"1 centro (Northwestern)","periodo":"Out/2009 - Set/2015","indicacao":"HCC unifocal/multifocal não-elegível para resseção/ablação","incl":"HCC inoperável; Child-Pugh A-B; sem mets extra-hepáticas; planejamento angiográfico viável.","excl":"Mets extra-hepáticas; Child-Pugh C; insuficiência renal grave.","estrat":"—","basal":"Mediana 65a; HCV/álcool predominantes.","n":"Planejado 124; randomizados 45 (24 TARE + 21 TACE)","molecular":"AFP.","biomarc":"AFP, função hepática.","radiofarmaco":"90Y-microsferas de VIDRO (TheraSphere®)","esquema":"TARE: 120 Gy ao perfundido (dose ambulatorial); ciclo único","cumul":"Dose única (pode ser repetida)","comparador":"cTACE convencional (lipiodol + doxorrubicina + gelfoam)","estatistica":"Poder 80% para TTP HR 0,5; α 0,05.","analises":"ITT.","primario":"Tempo até progressão (TTP): >26 m (TARE) vs 6,8 m (TACE) — p=0,0012","secundario":"OS sem diferença significativa | Menos hospitalizações com TARE.","subgrupo":"—","tox_g3":"Tolerabilidade semelhante; menos dor pós-procedimento e menos hospitalização com TARE.","tox_interesse":"TACE: pico de febre/dor, hospitalização frequente. TARE: ambulatorial, menor pico clínico.","impacto_reg":"Primeiro RCT TARE vs TACE: TARE com TTP MUITO superior. Não desenhado para OS. Estimulou estudos como TRACE, que confirmaram benefício.","limit":"n pequeno; single-center; recrutamento lento (6 anos).","ref":"Salem R, et al. JVIR 2016/Gastroenterology 2016;151:1155-1163","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT00956930","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/27575820/","ano_pub":2016,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_5"},{"estudo":"TRACE (Radiology 2022)","acron":"TRACE — TARE vs DEB-TACE in BCLC A/B HCC","nct":"NCT01381211","sponsor":"Acadêmico belga | PI: Edward Dhondt","fase":"Fase 2 randomizada","desenho":"Randomização 1:1 a TARE Y-90 vidro vs DEB-TACE.","centros":"Multicêntrico belga","periodo":"2011 - 2018 (encerrado precocemente por superioridade)","indicacao":"HCC BCLC A/B inelegíveis para resseção/transplante imediato/ablação","incl":"HCC inoperável; Child-Pugh A-B7; lesões 3-8 cm.","excl":"Mets extra-hepáticas; >5 lesões; Child-Pugh B8+.","estrat":"—","basal":"Mediana 67a.","n":"Planejado 140; randomizados 72 (encerrado precocemente)","molecular":"AFP.","biomarc":"AFP, função hepática.","radiofarmaco":"90Y-microsferas de VIDRO (TheraSphere®)","esquema":"TARE: dose padrão (~120 Gy)","cumul":"Dose única","comparador":"DEB-TACE (DC Beads + doxorrubicina)","estatistica":"Poder 80% para TTP HR 0,5; α 0,05.","analises":"ITT; estudo encerrado precocemente.","primario":"TTP: 17,1 vs 9,5 m (HR 0,36; p<0,001) | OS: 30,2 vs 15,6 m (HR 0,48; p=0,006)","secundario":"ORR favoreceu TARE; melhor controle local sustentado.","subgrupo":"—","tox_g3":"Perfil semelhante; menor hospitalização com TARE.","tox_interesse":"DEB-TACE com mais síndrome pós-embolização.","impacto_reg":"Confirma e EXPANDE PREMIERE: TARE Y-90 vidro é superior à DEB-TACE em TTP e OS. Altera prática em HCC intermediário inelegível para SoC clássico.","limit":"Encerrado precocemente; n moderado.","ref":"Dhondt E, et al. Radiology 2022;303:699-710","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT01381211","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/35258271/","ano_pub":2022,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_6"},{"estudo":"SIRFLOX + FOXFIRE + FOXFIRE-Global (2017)","acron":"Análise combinada de 3 RCT em mCRC com mets hepáticas","nct":"NCT00724503 (SIRFLOX); NCT01721954 (FOXFIRE-Global)","sponsor":"Acadêmico Australia/UK + Sirtex | PI: H Wasan / G Van Hazel / P Dutton","fase":"Análise combinada de 3 RCT fase 3","desenho":"Randomização 1:1 a FOLFOX + TARE Y-90 resina (single dose ciclo 1 ou 2) vs FOLFOX em pacientes mCRC chemo-naive.","centros":"1.103 pacientes em 14 países","periodo":"2006 - 2014","indicacao":"mCRC com mets hepáticas dominantes, 1ª linha (chemo-naive)","incl":"mCRC chemo-naive; mets hepáticas predominantes (≤25% extra-hepático); irressecáveis; ECOG 0-1.","excl":"Mets extra-hepáticas significativas (>25%); contraindicações a oxaliplatina.","estrat":"Estudo (SIRFLOX vs FOXFIRE vs Global); uso de bevacizumabe; uso de irinotecano","basal":"Mediana 64a; KRAS mutado em ~38%; sincrônica em ~70%.","n":"Planejado 1.075; randomizados 1.103","molecular":"Status KRAS retrospectivo; sem critério molecular obrigatório.","biomarc":"CEA, KRAS/NRAS/BRAF retrospectivo.","radiofarmaco":"90Y-microsferas de RESINA (SIR-Spheres®)","esquema":"Dose única no ciclo 1 ou 2 de FOLFOX; planejamento BSA","cumul":"Dose única","comparador":"FOLFOX padrão ± bevacizumabe (a critério; em ~40%)","estatistica":"Poder 90% para OS HR 0,8; α 0,05.","analises":"ITT.","primario":"OS pooled: 22,6 vs 23,3 m (HR 1,04; p=0,609) — NEGATIVO","secundario":"PFS pooled: HR 0,90 (NS) | ORR hepática: 72,2% vs 63,0% (favoreceu TARE) | Progressão hepática como 1º evento: HR 0,51 (favoreceu TARE) | hPFS: melhor com TARE","subgrupo":"Subgrupo de cólon direito pode ter benefício; análises post-hoc complexas.","tox_g3":"TARE adiciona toxicidade hematológica e hepática transitória; sem aumento de mortalidade tratamento-relacionada.","tox_interesse":"Síndrome pós-radioembolização (dor, febre, fadiga); descompensação hepática transitória; hipersensibilidade a oxaliplatina.","impacto_reg":"Resultado NEGATIVO em OS. Limita uso indiscriminado em 1ª linha (não recomendado). Diretrizes ESMO/NCCN reservam TARE para 3ª linha+ ou casos específicos.","limit":"Sem dosimetria personalizada; selecção heterogênea; uso de bevacizumabe variável.","ref":"Wasan HS, et al. Lancet Oncol 2017;18:1159-1171","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT00724503","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/28781171/","ano_pub":2017,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_7"},{"estudo":"EPOCH (JCO 2022)","acron":"EPOCH — TARE Y-90 + 2nd-line chemo vs chemo in mCRC liver mets","nct":"NCT01483027","sponsor":"BTG/Boston Scientific | PI: Mary Mulcahy","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 1:1 a QT 2ª linha + TARE Y-90 vidro vs QT isolada.","centros":"Multicêntrico EUA + Europa + Ásia","periodo":"Mai/2012 - Ago/2020","indicacao":"mCRC com mets hepáticas dominantes, 2ª linha (após falha à 1ª)","incl":"mCRC com mets hepáticas dominantes; progressão à 1ª linha (oxa OU iri); ECOG 0-1.","excl":"Mets extra-hepáticas dominantes; QT prévia 2ª linha; insuficiência renal grave.","estrat":"1ª linha (oxa vs iri); uso de biológico planejado; status mutacional","basal":"Mediana 63a; KRAS mut em ~50%; mediana 1 linha prévia.","n":"Planejado 360; randomizados 428 (215 + 213)","molecular":"Status KRAS/NRAS/BRAF coletado.","biomarc":"CEA, RAS/BRAF; subgrupo análise por status.","radiofarmaco":"90Y-microsferas de VIDRO (TheraSphere®)","esquema":"Dose única, planejamento padrão","cumul":"Dose única","comparador":"QT 2ª linha (FOLFOX OU FOLFIRI ± biológico — bevacizumabe ou cetuximabe)","estatistica":"Poder ~80% para PFS e hPFS; α 0,05.","analises":"ITT; análise sequencial pré-especificada.","primario":"PFS: 8,0 vs 7,2 m (HR 0,69; IC 0,54-0,88; p=0,0013) | hPFS: 9,1 vs 7,2 m (HR 0,59; p<0,0001)","secundario":"OS: 14,0 vs 14,4 m (HR 1,07; p=0,72) — NS | ORR: 34,0% vs 21,1% (p<0,001) | QoL/PROs favoreceram TARE.","subgrupo":"RAS-mutado e left-sided sem heterogeneidade marcante; subgrupo de doença hepática-dominante com benefício maior.","tox_g3":"Eventos ≥G3: maiores com TARE (68% vs 49%) — principalmente hepáticos transitórios e hematológicos.","tox_interesse":"Descompensação hepática transitória; síndrome pós-embolização; toxicidade hematológica do FOLFOX/FOLFIRI somada.","impacto_reg":"Primeiro RCT positivo de TARE em 2ª linha em mCRC. Ganho de PFS e hPFS, sem ganho de OS. Útil para retardar progressão hepática em pacientes com doença hepática-dominante. Inclui em diretrizes para casos selecionados.","limit":"OS NS (poder limitado por heterogeneidade); seleção de pacientes; comparador heterogêneo.","ref":"Mulcahy MF, et al. J Clin Oncol 2022;40:1574-1585","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"https://clinicaltrials.gov/study/NCT01483027","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/34541864/","ano_pub":2022,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_8"},{"estudo":"TARE em mets neuroendócrinas (séries)","acron":"TARE Y-90 em mets hepáticas de TNE refratárias","nct":"Múltiplos (séries)","sponsor":"Coortes prospectivas (multicêntricas)","fase":"Coortes prospectivas / fase 2","desenho":"Single-arm; uso de TARE em pacientes com mets hepáticas dominantes refratárias a SSA/PRRT.","centros":"Multicêntrico (Europa/EUA)","periodo":"Coortes 2010-2024","indicacao":"Mets hepáticas de TNE bem diferenciadas, refratárias a SSA e/ou PRRT","incl":"TNE bem diferenciado; mets hepáticas dominantes; SSA/PRRT prévia; função hepática preservada.","excl":"TNE pouco diferenciado; descompensação hepática.","estrat":"Origem do primário; uso prévio de PRRT","basal":"Variável (séries pequenas).","n":"Variável (10-100 por série)","molecular":"PET 68Ga-DOTATATE+; CgA elevada.","biomarc":"CgA, 5-HIAA; função hepática.","radiofarmaco":"90Y-microsferas (vidro ou resina)","esquema":"Variável conforme protocolo institucional","cumul":"Dose única ou sequencial","comparador":"—","estatistica":"Descritivo.","analises":"Per-protocol.","primario":"DCR ~80-90% | ORR ~30-50%","secundario":"Controle sintomático (carcinoide); melhora bioquímica (CgA, 5-HIAA).","subgrupo":"Funcionantes têm benefício sintomático adicional.","tox_g3":"Tolerável; risco de descompensação hepática se função basal limítrofe.","tox_interesse":"Crise carcinoide durante embolização (manejo com SSA); ascite transitória.","impacto_reg":"TARE como terapia loco-regional complementar ou alternativa à PRRT em TNE com doença hepática dominante. Não há RCT pivotal definindo papel formal.","limit":"Sem RCT; seleção heterogênea; sem comparação direta com PRRT.","ref":"Cao C et al. Eur J Nucl Med Mol Imaging 2022; séries clássicas (Memon, Kennedy)","category_id":"y90_tare","preparo":"Mapeamento angiográfico prévio + cintilografia/SPECT-CT com 99mTc-MAA (cálculo de shunt pulmonar e dosimetria preditiva). Embolização profilática de vasos extra-hepáticos (gastroduodenal, gastrohepáticas) quando indicado. Antieméticos peri-procedimento; analgesia; alopurinol em casos selecionados (gastrite radiogênica).","nct_url":"","pubmed_url":"","ano_pub":0,"status":"Publicado","category_name":"Radioembolização 90Y","category_short":"Y-90","category_color":"#f59e0b","uid":"y90_tare_9"},{"estudo":"225Ac-PSMA-617 Heidelberg (2016-2020)","acron":"225Ac-PSMA-617 — Pioneer alpha-therapy in mCRPC (Heidelberg)","nct":"Uso compassional / NCT04597411 e outros","sponsor":"Acadêmico (University Heidelberg) | PI: Clemens Kratochwil","fase":"Coortes de uso compassional / fase 1","desenho":"Coortes consecutivas; escalonamento empírico de dose; pacientes refratários multi-tratados.","centros":"Single-center expandido (Heidelberg) e replicação (Pretoria — Mike Sathekge)","periodo":"2014 - 2022","indicacao":"mCRPC pós-falência a 177Lu-PSMA ou outras terapias avançadas; salvage","incl":"PSMA-PET fortemente positivo; falência a múltiplas linhas; ECOG 0-2.","excl":"Insuficiência renal/medular grave; xerostomia G3 prévia.","estrat":"—","basal":"Mediana 70a; mediana 4-5 linhas prévias; mets viscerais comuns.","n":"Coortes 30-60 (Kratochwil, Sathekge, Yadav, Hooshyar Yousefi)","molecular":"PSMA-PET com captação intensa; sem critério molecular formal mas seleção por avidez.","biomarc":"PSA, dosimetria, biomarcadores hematológicos.","radiofarmaco":"[225Ac]Ac-PSMA-617 (alfa-emissor; 4 alfas em cascata)","esquema":"100 kBq/kg q8sem (dose empírica); ajuste para xerostomia; até 4-6 ciclos","cumul":"300-600 kBq/kg","comparador":"— (séries históricas)","estatistica":"Descritivo.","analises":"Per-protocol.","primario":"PSA50: 63-70% mesmo após falha a 177Lu-PSMA | Duração de resposta: 10-15 m | RC em ~10%","secundario":"OS estimada favorável vs séries históricas; resposta também em pacientes com lesões refratárias.","subgrupo":"Resposta independente de carga tumoral; melhor em high PSMA-avidity.","tox_g3":"Xerostomia DOSE-LIMITANTE (>100 kBq/kg leva a xerostomia grave G2-3 em maioria); toxicidade hematológica geralmente moderada (anemia G3 ~20%, plaquetopenia G3 ~15%).","tox_interesse":"XEROSTOMIA permanente em ~30-50% (G2-3); nefrotoxicidade tardia possível (alfa concentra em rins).","impacto_reg":"Prova de conceito para alfa-terapia com PSMA. Atividade anti-tumoral até em refratários a beta. Limitação: xerostomia. Inspirou estudos randomizados (TATCIST, AcTION, ECLIPSE-Ac225).","limit":"Não-randomizado; uso compassional; séries pequenas; xerostomia limitante.","ref":"Kratochwil C, et al. JNM 2016;57:1941-1944 / 2018;59:795-802; Sathekge M et al. Theranostics 2020;10:9364","category_id":"novos_psma","preparo":"Hidratação peri-infusão; antieméticos. Atenção especial a XEROSTOMIA dose-limitante (225Ac concentra em glândulas salivares); ice packs/sialogogos podem ser tentados. Considerar PABA em protocolos de pesquisa.","nct_url":"https://clinicaltrials.gov/study/NCT04597411","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/27390158/","ano_pub":2016,"status":"Publicado","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_0"},{"estudo":"TATCIST (em andamento)","acron":"TATCIST — Phase 2 of 225Ac-PSMA-617 in mCRPC","nct":"NCT05219500","sponsor":"Investigador-iniciado (EUA / Multinacional)","fase":"Fase 2","desenho":"Single-arm; escalonamento e expansão.","centros":"Multicêntrico EUA","periodo":"2022 - em recrutamento","indicacao":"mCRPC pós-ARPi e pós-taxano","incl":"PSMA-PET fortemente positivo; pós-progressão a SoC.","excl":"Xerostomia G3 prévia; mielotoxicidade.","estrat":"Por publicar","basal":"Por publicar","n":"~70 planejados","molecular":"PSMA-PET fortemente positivo.","biomarc":"PSA, dosimetria, biomarcadores.","radiofarmaco":"[225Ac]Ac-PSMA-617","esquema":"Escalonamento de dose; provavelmente ~100 kBq/kg q8sem","cumul":"Variável","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol.","primario":"ORR (RECIST/PCWG3) — em andamento","secundario":"PSA50, rPFS, OS, dosimetria, biomarcadores — em andamento","subgrupo":"—","tox_g3":"Em andamento — dados não publicados","tox_interesse":"Em andamento — atenção a xerostomia","impacto_reg":"Estudo pivotal para colocar 225Ac-PSMA-617 em terreno regulatório formal. Pode legitimar alfa-terapia PSMA como linha terapêutica.","limit":"Aguardando resultados.","ref":"ClinicalTrials.gov NCT05219500","category_id":"novos_psma","preparo":"Hidratação peri-infusão; antieméticos. Atenção especial a XEROSTOMIA dose-limitante (225Ac concentra em glândulas salivares); ice packs/sialogogos podem ser tentados. Considerar PABA em protocolos de pesquisa.","nct_url":"https://clinicaltrials.gov/study/NCT05219500","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_1"},{"estudo":"AcTION (em andamento)","acron":"AcTION — 225Ac-PSMA-I&T (CONV-01-α / FPI-2059)","nct":"NCT06280300","sponsor":"Convergent Therapeutics / Lantheus","fase":"Fase 1/2","desenho":"Escalonamento + expansão.","centros":"Multicêntrico","periodo":"2024 - em recrutamento","indicacao":"mCRPC PSMA+ pós-falência a 177Lu-PSMA","incl":"PSMA-PET+; pós-RLT beta.","excl":"—","estrat":"—","basal":"—","n":"Planejado","molecular":"PSMA-PET+","biomarc":"Por publicar","radiofarmaco":"[225Ac]Ac-PSMA-I&T (CONV-01-α)","esquema":"Por publicar","cumul":"Por publicar","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol","primario":"Segurança, dose recomendada — em andamento","secundario":"PSA50, rPFS — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Estudo de empresa para ligante PSMA-I&T marcado com Ac-225. Estratégia para 'salvage' pós-Pluvicto®.","limit":"Aguardando dados.","ref":"ClinicalTrials.gov NCT06280300 (Convergent / Lantheus)","category_id":"novos_psma","preparo":"Hidratação peri-infusão; antieméticos. Atenção especial a XEROSTOMIA dose-limitante (225Ac concentra em glândulas salivares); ice packs/sialogogos podem ser tentados. Considerar PABA em protocolos de pesquisa.","nct_url":"https://clinicaltrials.gov/study/NCT06280300","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_2"},{"estudo":"VIOLET (Lancet Oncol 2025)","acron":"VIOLET — First-in-human 161Tb-PSMA-I&T in mCRPC (Peter MacCallum)","nct":"NCT05521412","sponsor":"Peter MacCallum + Isotopia | PI: Michael Hofman","fase":"Fase 1/2 (single-center)","desenho":"3+3 escalonamento de dose + expansão; primeiro uso humano de 161Tb em qualquer câncer.","centros":"1 centro (Peter MacCallum, Melbourne)","periodo":"2022 - 2024","indicacao":"mCRPC pós-ARPi (maioria pós-docetaxel)","incl":"≥18a; ECOG 0-2; PSMA-PET+ (SUVmean ≥7); FDG-PET sem discordância maior; ADT.","excl":"Discordância FDG/PSMA; mielotoxicidade.","estrat":"—","basal":"Mediana 69a (IQR 66-74,8); PSA mediano 26,9 ng/mL; SUVmean PSMA mediano 8,2; pós-doce em 67%.","n":"30 (3+3 escalonamento + expansão)","molecular":"PSMA-PET+ (SUVmean ≥7); FDG-PET para excluir discordância maior.","biomarc":"PSA, dosimetria 3D (alfa beta + Auger); QoL.","radiofarmaco":"[161Tb]Tb-PSMA-I&T (DUAL EMISSÃO: beta longo alcance + elétrons Auger curtos)","esquema":"Escalonamento de 3 níveis (4,4 → 5,9 → 7,4 GBq); 6 ciclos q6-8sem; RP2D = 7,4 GBq","cumul":"Mediana 38 GBq","comparador":"—","estatistica":"Descritivo (3+3 + expansão); foco em DLT.","analises":"Per-protocol.","primario":"Segurança, MTD — sem DLT até 7,4 GBq (RP2D)","secundario":"PSA50: 70% (21/30) | ORR: 50% | PFS bioquímica favorável | QoL sustentada | Dosimetria mostra absorção homogênea","subgrupo":"—","tox_g3":"Eventos relacionados G3: dor (1/30) e linfopenia (1/30). Sem G4 nem morte. Sem descontinuação por toxicidade.","tox_interesse":"Xerostomia menos prevalente que com 177Lu (em séries comparativas iniciais); sem nefrotoxicidade.","impacto_reg":"PRIMEIRO USO HUMANO DE 161Tb em qualquer câncer. Conceito de DUAL EMISSÃO (beta longo + Auger curto para micrometástase). Resultados sugerem potencial sinérgico ao 177Lu. Projetos de fase 2/3 em planejamento (REPLAY, MERIDIAN).","limit":"Single-center; n pequeno (fase 1/2); seguimento curto; comparação com 177Lu necessária.","ref":"Hofman MS, et al. Lancet Oncol 2025;26:e423-e433","category_id":"novos_psma","preparo":"Hidratação peri-infusão; antieméticos padrão. Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares) opcional para mitigar xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT05521412","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/40617237/","ano_pub":2025,"status":"Publicado","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_3"},{"estudo":"177Lu-J591 (Tagawa, 2013/2019)","acron":"177Lu-J591 — Anti-PSMA mAb radioimunoterapia","nct":"NCT00859781 (fase 2); NCT00538668 (fracionado)","sponsor":"Weill Cornell Medicine | PI: Scott Tagawa","fase":"Fase 2 (single-dose) e fase 1/2 (fracionado)","desenho":"Single-arm; dose única (fase 2) ou fracionada em 2 administrações 2 sem (fase 1/2).","centros":"Weill Cornell Medicine (NYC)","periodo":"2007 - 2017","indicacao":"mCRPC pós-progressão","incl":"mCRPC progressivo; expressão PSMA presumida (sem PET PSMA na época); ECOG 0-2.","excl":"Mielotoxicidade significativa; uso prévio de RLT.","estrat":"Dose recebida","basal":"Mediana 70a; mediana 3 linhas prévias; pré-PSMA-PET era.","n":"47 (fase 2) / 49 (fracionado)","molecular":"Expressão PSMA presumida; sem PET PSMA na maioria dos estudos iniciais.","biomarc":"PSA, biomarcadores hematológicos, imagem com 111In-J591 (theranostic pair).","radiofarmaco":"[177Lu]Lu-J591 (anticorpo monoclonal anti-PSMA radioimunoconjugado)","esquema":"Dose única 65-70 mCi/m² (fase 2); fracionado: 20-45 mCi/m² × 2 (q2sem)","cumul":"Variável","comparador":"—","estatistica":"Descritivo.","analises":"Per-protocol.","primario":"PSA50 ≥30%: 46,9% no MTD (70 mCi/m²) | OS: 21,8 m (MTD) vs 11,9 m (dose menor) | Direcionamento tumoral em 93,6% das lesões","secundario":"Resposta correlacionada à dose recebida; fracionamento permitiu maior dose cumulativa e melhor PSA response (~58%).","subgrupo":"Resposta maior em pacientes com expressão PSMA mais alta (correlação imagiológica retrospectiva).","tox_g3":"Trombocitopenia G4 reversível em ~46%; sem hemorragia significativa.","tox_interesse":"Cinética longa do anticorpo (meia-vida ~7 dias) → mielotoxicidade prolongada. Sem xerostomia (seletividade do anticorpo).","impacto_reg":"Primeiro RIT (radioimunoterapia) PSMA. Pavimentou desenvolvimento de small-molecule PSMA (PSMA-617) com cinética favorável (rápida depuração de tecidos não-alvos).","limit":"Cinética longa = mais tox medular; superado por small-molecules em uso clínico atual.","ref":"Tagawa ST, et al. Clin Cancer Res 2013;19:5182-5191; Cancer 2019;125:2561","category_id":"novos_psma","preparo":"Pré-medicação com corticoide (dexametasona) + anti-histamínico antes da infusão (reações relacionadas à infusão de anticorpo monoclonal); antieméticos; hidratação peri-infusão.","nct_url":"https://clinicaltrials.gov/study/NCT00859781","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/23881929/","ano_pub":2013,"status":"Publicado","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_4"},{"estudo":"225Ac-J591 (em andamento)","acron":"225Ac-J591 — Alpha radioimunoterapia anti-PSMA","nct":"NCT04506567 e outros","sponsor":"Weill Cornell + Convergent | PI: Scott Tagawa","fase":"Fase 1/2","desenho":"Single-arm; escalonamento + expansão.","centros":"Weill Cornell + replicação","periodo":"2020 - em recrutamento","indicacao":"mCRPC pós-progressão a SoC","incl":"mCRPC com expressão PSMA esperada; sem critério molecular obrigatório.","excl":"Mielotoxicidade; uso prévio de alfa-RIT.","estrat":"—","basal":"Mediana ~71a; mediana 3-4 linhas prévias.","n":"~40-60 em coortes","molecular":"PSMA-PET adjunto (não obrigatório); biopsia esporádica.","biomarc":"PSA, ctDNA, dosimetria.","radiofarmaco":"[225Ac]Ac-J591","esquema":"Escalonamento de dose; dose única ou fracionada","cumul":"Variável","comparador":"—","estatistica":"Per-protocol.","analises":"Per-protocol.","primario":"Segurança (DLT), PSA response — preliminar promissor","secundario":"rPFS, OS, biomarcadores — em andamento","subgrupo":"—","tox_g3":"Trombocitopenia, anemia, fadiga; xerostomia menos prevalente que com 225Ac-PSMA-617 (vantagem do anticorpo).","tox_interesse":"Mielotoxicidade prolongada (cinética do anticorpo); menos xerostomia que small-molecule.","impacto_reg":"Combina vantagem de alfa-emissor + cinética de anticorpo. Resultados promissores em PSA response. Avanço da plataforma RIT-α.","limit":"Aguardando dados de fase 2 maturos.","ref":"Tagawa ST, et al. JCO 2024;42(suppl 16):5037; ClinicalTrials.gov NCT04506567","category_id":"novos_psma","preparo":"Pré-medicação com corticoide (dexametasona) + anti-histamínico antes da infusão (reações relacionadas à infusão de anticorpo monoclonal); antieméticos; hidratação peri-infusão.","nct_url":"https://clinicaltrials.gov/study/NCT04506567","pubmed_url":"","ano_pub":0,"status":"Publicado","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_5"},{"estudo":"ECLIPSE-Ac (em andamento)","acron":"ECLIPSE-Ac (PNT2003) — Alpha-PSMA-I&T (Lantheus)","nct":"NCT06388759","sponsor":"Lantheus | (subsidiária Point Biopharma)","fase":"Fase 1/2","desenho":"Escalonamento + expansão.","centros":"Multicêntrico","periodo":"2024 - em recrutamento","indicacao":"mCRPC PSMA+ pós-ARPi","incl":"PSMA-PET+; pós-progressão a SoC.","excl":"—","estrat":"—","basal":"—","n":"Planejado","molecular":"PSMA-PET+","biomarc":"Por publicar","radiofarmaco":"[225Ac]Ac-PNT2003 (alpha-PSMA-I&T)","esquema":"Por publicar","cumul":"Por publicar","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol","primario":"Segurança, MTD — em andamento","secundario":"ORR, PSA50, rPFS — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento — atenção a xerostomia","impacto_reg":"Mais um candidato alfa-PSMA da indústria. Reflete pipeline robusto de alfa-terapias para próstata.","limit":"Aguardando dados.","ref":"ClinicalTrials.gov NCT06388759","category_id":"novos_psma","preparo":"Hidratação peri-infusão; antieméticos. Atenção especial a XEROSTOMIA dose-limitante (225Ac concentra em glândulas salivares); ice packs/sialogogos podem ser tentados. Considerar PABA em protocolos de pesquisa.","nct_url":"https://clinicaltrials.gov/study/NCT06388759","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_6"},{"estudo":"212Pb-PSMA (em andamento)","acron":"212Pb-VMT-α-NET / 212Pb-PSMA — Pb-212 alpha-PSMA","nct":"NCT05496985","sponsor":"Perspective Therapeutics","fase":"Fase 1/2","desenho":"Escalonamento + expansão.","centros":"Multicêntrico EUA","periodo":"2023 - em recrutamento","indicacao":"mCRPC PSMA+","incl":"PSMA-PET+; pós-progressão.","excl":"—","estrat":"—","basal":"—","n":"Planejado","molecular":"PSMA-PET+","biomarc":"Por publicar","radiofarmaco":"[212Pb]Pb-PSMA (gerador 212Pb→212Bi)","esquema":"Por publicar","cumul":"Por publicar","comparador":"—","estatistica":"Por publicar","analises":"Per-protocol","primario":"Segurança, dose recomendada — em andamento","secundario":"PSA50, rPFS, OS — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"Em andamento","impacto_reg":"Plataforma alfa baseada em 212Pb (meia-vida mais curta = logística mais simples). Concorrente potencial do 225Ac na alfa-terapia PSMA.","limit":"Aguardando dados.","ref":"ClinicalTrials.gov NCT05496985 (Perspective Therapeutics)","category_id":"novos_psma","preparo":"Hidratação peri-infusão; antieméticos. Atenção especial a XEROSTOMIA dose-limitante (225Ac concentra em glândulas salivares); ice packs/sialogogos podem ser tentados. Considerar PABA em protocolos de pesquisa.","nct_url":"https://clinicaltrials.gov/study/NCT05496985","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"Novos PSMA (α / 161Tb / RIT)","category_short":"α-PSMA","category_color":"#ef4444","uid":"novos_psma_7"},{"estudo":"AZEDRA / Iobenguano I-131 (JCO 2018)","acron":"AZEDRA — High-specific activity 131I-iobenguane in malignant PPGL","nct":"NCT00874614","sponsor":"Progenics/Lantheus | PI: Daniel Pryma","fase":"Fase 2 pivotal, multicêntrica","desenho":"Single-arm; doses terapêuticas com 131I-iobenguano de alta atividade específica.","centros":"Multicêntrico EUA","periodo":"2009 - 2017","indicacao":"Feocromocitoma/paraganglioma (PPGL) maligno, recidivado, irressecável, MIBG+","incl":"≥12a; PPGL maligno ou irressecável; MIBG+ na cintilografia (123I ou 131I-MIBG); requerendo terapia sistêmica; ECOG 0-2.","excl":"Insuficiência renal/medular grave; expectativa de vida <6 m; gravidez.","estrat":"Por publicar","basal":"Idade mediana 49a; ~72% com ≥2 linhas prévias; pheo 71,6%, PGL 28,4%; ECOG 0-1 majoritário.","n":"Planejado 60; total 68 pacientes (incluindo dose run-in)","molecular":"MIBG-positivo na cintilografia diagnóstica (123I-MIBG planar/SPECT).","biomarc":"Catecolaminas (metanefrinas), CgA, mutação SDHB.","radiofarmaco":"[131I]MIBG (iobenguano I 131, AZEDRA®) — alta atividade específica (sem MIBG não-radiomarcado para competição)","esquema":"Doses terapêuticas: 8 mCi/kg (mediana ~555 mCi) IV, até 2 doses (separadas por ≥90 dias); ajuste por dosimetria","cumul":"Até ~16 mCi/kg","comparador":"— (single-arm)","estatistica":"Descritivo; endpoint primário pré-especificado.","analises":"ITT.","primario":"Redução ≥50% no uso de anti-hipertensivos por ≥6 m em 25% (todos) / 32% (que receberam ≥2 doses; IC 21-46%)","secundario":"ORR (PR): 23,4% | DCR (CR+PR+SD): 92,2% | OS mediana: 36,7 m (IC 29,9-49,1) | Subgrupo com ≥2 doses: PFS prolongada","subgrupo":"OS similar com/sem mets pulmonares/hepáticas (42,6 vs 41,1 m); benefício observado mesmo em multi-tratados.","tox_g3":"Mielossupressão FREQUENTE: linfopenia G3-4 (78%), neutropenia G3-4 (33%), plaquetopenia G3-4 (33%) — geralmente reversíveis; náusea G3 (4%), fadiga G3 (4%).","tox_interesse":"SEM crises HAS agudas relacionadas (graças ao manejo); risco tardio de hipotireoidismo (proteção com KI); risco de SMD/leucemia em FU longo (~2-5%).","impacto_reg":"PRIMEIRA terapia FDA-aprovada (Jul/2018) para PPGL maligno irressecável. Mostra controle pressórico e antitumoral significativos. Pavimentou padrão de terapia sistêmica em PPGL maligno.","limit":"Single-arm (sem comparador); custo elevado; logística de quarto isolado para alta atividade; mielotoxicidade significativa.","ref":"Pryma DA, et al. J Clin Oncol 2018;36(suppl):4005; FDA AZEDRA approval Jul 2018","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. α-bloqueio prévio (fenoxibenzamina/doxazosina) obrigatório em PPGL funcionantes para prevenir crise hipertensiva durante a infusão; β-bloqueio se taquiarritmia. UTI ou monitorização cardíaca peri-procedimento em alto risco. Antieméticos; hidratação.","nct_url":"https://clinicaltrials.gov/study/NCT00874614","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=AZEDRA+2018","ano_pub":2018,"status":"Publicado","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_0"},{"estudo":"131I-MIBG em Neuroblastoma — Bambino Gesù / Curie","acron":"131I-MIBG terapia em NB alto risco refratário/recidivado MIBG+","nct":"Múltiplos (séries)","sponsor":"Centros de referência (Bambino Gesù, Curie, UCSF)","fase":"Fase 2 / coortes prospectivas","desenho":"Single-arm; doses terapêuticas tandem (2 ciclos sucessivos) ± topotecano (radio-sensibilizador).","centros":"Centros de referência Europa/EUA","periodo":"Coortes 1990-2024","indicacao":"Neuroblastoma de alto risco refratário/recidivado, MIBG-positivo","incl":"NB alto risco; MIBG+ na cintilografia; falha à indução padrão.","excl":"MIBG-negativo; insuficiência renal/medular grave.","estrat":"Idade; carga tumoral; status MYCN","basal":"Mediana 4-5a; multi-tratados; mediana 2-3 linhas prévias.","n":"Coortes (>100 em séries combinadas)","molecular":"Cintilografia 123I-MIBG positiva.","biomarc":"Catecolaminas urinárias (HVA/VMA); MYCN status.","radiofarmaco":"[131I]MIBG terapêutico","esquema":"12-18 mCi/kg em ciclos tandem (2 ciclos com 2-3 sem entre eles); ± topotecano radio-sensibilizador","cumul":"Até 36 mCi/kg em 2 ciclos","comparador":"—","estatistica":"Descritivo (séries).","analises":"Per-protocol.","primario":"ORR ~30-40% | DCR ~70-80%","secundario":"PFS variável (curtas em refratários); uso como ponte para TCTH em alguns casos.","subgrupo":"Resposta melhor em pacientes com captação MIBG mais intensa.","tox_g3":"Mielotoxicidade (frequente; necessidade de suporte com transfusões e GCSF); risco de SOS hepática se combinado a HD-chemo.","tox_interesse":"HIPOTIREOIDISMO em FU longo (40-70%, mesmo com KI); SMD/leucemia em FU longo (~5%); infertilidade (gônadas).","impacto_reg":"Tratamento estabelecido em neuroblastoma refratário/recidivado MIBG+. Combinado a QT (topotecano, vincristina) e/ou TCTH. Padrão em centros de referência. Sem aprovação formal FDA específica para NB pediátrico.","limit":"Sem RCT pivotal em NB; séries heterogêneas; logística complexa (quarto isolado pediátrico).","ref":"De Pasquale MD, et al. JNM 2021; Matthay KK et al. JCO; séries clássicas (Curie/Sloan-Kettering)","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. Em pediatria: sedação/anestesia conforme idade; LSI (Lugol/SSKI) padrão; antieméticos potentes; hidratação rigorosa; controle de exposição familiar/staff. Em combinações com Bu/Mel (TCTH): gap mínimo de 10 sem para reduzir risco de SOS hepática.","nct_url":"","pubmed_url":"","ano_pub":0,"status":"Publicado","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_1"},{"estudo":"ANBL09P1 (COG, 2021)","acron":"ANBL09P1 — 131I-MIBG induction + Bu/Mel + ASCT in newly diagnosed HR-NB","nct":"NCT01175356","sponsor":"Children's Oncology Group (COG) | PI: Brian Weiss","fase":"Fase 1/2 piloto","desenho":"Single-arm; escalonamento de dose 131I-MIBG (12, 15, 18 mCi/kg) durante indução, seguido de busulfano/melfalano (Bu/Mel) e TCTH; gap de ≥10 sem para evitar SOS.","centros":"Multicêntrico COG (EUA)","periodo":"2010 - 2018","indicacao":"Neuroblastoma de alto risco recém-diagnosticado, MIBG-positivo","incl":"NB alto risco recém-diagnosticado; idade <30 anos; MIBG+; sem QT prévia além de indução padrão (3-5 ciclos).","excl":"MIBG-negativo; condição clínica que impede TCTH.","estrat":"Dose-level (12, 15, 18 mCi/kg)","basal":"Mediana 4a; MYCN amp em ~30%.","n":"30+ pacientes (escalonamento)","molecular":"Cintilografia 123I-MIBG positiva.","biomarc":"Catecolaminas; MYCN; status pós-indução.","radiofarmaco":"[131I]MIBG","esquema":"12, 15 ou 18 mCi/kg IV; dose única na indução, seguido de gap ≥10 sem antes de Bu/Mel + TCTH","cumul":"12-18 mCi/kg","comparador":"—","estatistica":"Descritivo; foco em SOS (síndrome de obstrução sinusoidal hepática).","analises":"Per-protocol.","primario":"Viabilidade (taxa de feasibility): 96,7% no 15 mCi/kg (designado para estudo seguinte); taxa de SOS hepática severa 23,5%","secundario":"PFS, OS, resposta na indução — descritivos.","subgrupo":"Doses maiores (18 mCi/kg) tiveram SOS semelhante à 15 mCi/kg.","tox_g3":"SOS hepática moderada-severa: 33% (12 mCi/kg), 23,5% (15 mCi/kg), 25% (18 mCi/kg); mielotoxicidade prolongada.","tox_interesse":"SOS HEPÁTICA (sinusoidal obstruction syndrome) é o evento crítico; gap de 10 sem reduz risco; mortalidade tratamento-relacionada baixa.","impacto_reg":"Estabeleceu viabilidade de incluir 131I-MIBG na indução de NB de alto risco recém-diagnosticado. Base para o estudo randomizado ANBL1531.","limit":"Single-arm; n moderado; análise de SOS pré e pós-modificação do protocolo.","ref":"Weiss B, et al. Pediatr Blood Cancer 2021;68:e29117","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. Em pediatria: sedação/anestesia conforme idade; LSI (Lugol/SSKI) padrão; antieméticos potentes; hidratação rigorosa; controle de exposição familiar/staff. Em combinações com Bu/Mel (TCTH): gap mínimo de 10 sem para reduzir risco de SOS hepática.","nct_url":"https://clinicaltrials.gov/study/NCT01175356","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/34028986/","ano_pub":2021,"status":"Publicado","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_2"},{"estudo":"ANBL1531 (COG)","acron":"ANBL1531 — 131I-MIBG OR crizotinib added to standard induction in newly Dx HR-NB","nct":"NCT03126916","sponsor":"COG (NCI) | PI: Brian Weiss / Suzanne Shusterman","fase":"Fase 3 randomizada (COG)","desenho":"Randomização: indução padrão + 131I-MIBG (em pacientes MIBG+) OU + crizotinib (em ALK+) vs indução padrão; estratificação molecular.","centros":"Multicêntrico COG","periodo":"2017 - em recrutamento ativo","indicacao":"Neuroblastoma de alto risco recém-diagnosticado","incl":"NB alto risco recém-diagnosticado; estratificado por MIBG-positividade e mutação ALK.","excl":"MIBG-negativo + ALK negativo (não elegíveis para braços experimentais).","estrat":"Status MIBG; status mutacional ALK","basal":"Por publicar","n":"Planejado >700","molecular":"Cintilografia 123I-MIBG; mutação ALK (genoma).","biomarc":"Catecolaminas; ALK; MYCN; outras alterações genômicas.","radiofarmaco":"[131I]MIBG (em braço MIBG+)","esquema":"15 mCi/kg (definido pelo ANBL09P1) durante indução, seguido de Bu/Mel + TCTH","cumul":"15 mCi/kg","comparador":"Indução padrão sem adição (em respectivo subgrupo)","estatistica":"Por publicar; EFS como primário.","analises":"ITT planejada.","primario":"EFS (sobrevida livre de evento) — em andamento (dados não publicados)","secundario":"OS, taxa de resposta, segurança a longo prazo — em andamento","subgrupo":"—","tox_g3":"Em andamento — perfil esperado: SOS hepática, mielotoxicidade.","tox_interesse":"Em andamento.","impacto_reg":"Estudo PIVOTAL para definir papel do 131I-MIBG em PRIMEIRA LINHA em NB de alto risco. Resultado esperado em 2026-2027 pode mudar prática global.","limit":"Recrutamento longo (>9 anos); resultados aguardados.","ref":"ClinicalTrials.gov NCT03126916","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. Em pediatria: sedação/anestesia conforme idade; LSI (Lugol/SSKI) padrão; antieméticos potentes; hidratação rigorosa; controle de exposição familiar/staff. Em combinações com Bu/Mel (TCTH): gap mínimo de 10 sem para reduzir risco de SOS hepática.","nct_url":"https://clinicaltrials.gov/study/NCT03126916","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/?term=ANBL1531+1531","ano_pub":0,"status":"Em andamento","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_3"},{"estudo":"VERITAS (SIOPEN)","acron":"VERITAS — Fase 2 europeia em NB recidivado MIBG+","nct":"NCT03165292","sponsor":"SIOPEN | PI: Lucas Moreno","fase":"Fase 2 randomizada (Europa)","desenho":"Randomização: 131I-MIBG + topotecano + Bu/Mel + TCTH vs Topotecano + ciclofosfamida (TOTEM) padrão europeu.","centros":"Multicêntrico SIOPEN (Europa)","periodo":"2018 - em recrutamento","indicacao":"Neuroblastoma de alto risco refratário/recidivado MIBG+","incl":"NB alto risco refratário/recidivado; MIBG+; idade pediátrica.","excl":"MIBG-negativo; insuficiência renal/medular grave.","estrat":"Idade; status MYCN","basal":"Por publicar","n":"Planejado","molecular":"Cintilografia 123I-MIBG positiva.","biomarc":"Catecolaminas; MYCN; ALK.","radiofarmaco":"[131I]MIBG + topotecano + Bu/Mel + TCTH","esquema":"Por publicar (esquema MIBG geralmente 12-15 mCi/kg)","cumul":"Por publicar","comparador":"TOTEM (topotecano + ciclofosfamida) — padrão europeu","estatistica":"Por publicar","analises":"ITT planejada.","primario":"ORR / EFS — em andamento (dados não publicados)","secundario":"OS, segurança, dosimetria — em andamento","subgrupo":"—","tox_g3":"Em andamento","tox_interesse":"SOS hepática, mielotoxicidade.","impacto_reg":"Estudo europeu (SIOPEN) para padronizar protocolos de MIBG em NB recidivado. Importante por incluir dosimetria.","limit":"Aguardando dados.","ref":"ClinicalTrials.gov NCT03165292","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. Em pediatria: sedação/anestesia conforme idade; LSI (Lugol/SSKI) padrão; antieméticos potentes; hidratação rigorosa; controle de exposição familiar/staff. Em combinações com Bu/Mel (TCTH): gap mínimo de 10 sem para reduzir risco de SOS hepática.","nct_url":"https://clinicaltrials.gov/study/NCT03165292","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_4"},{"estudo":"OPTIMOM (em planejamento)","acron":"OPTIMOM — Otimização de 131I-MIBG ± topotecano em consolidação NB","nct":"Em planejamento","sponsor":"SIOPEN","fase":"Fase 2","desenho":"Otimização de regimes; uso de dosimetria personalizada.","centros":"Multicêntrico SIOPEN","periodo":"Em planejamento","indicacao":"Neuroblastoma alto risco em consolidação","incl":"NB alto risco; MIBG+; em fase de consolidação pós-indução.","excl":"Por publicar","estrat":"Por publicar","basal":"—","n":"Planejado","molecular":"Cintilografia 123I-MIBG.","biomarc":"Por publicar","radiofarmaco":"[131I]MIBG ± topotecano","esquema":"Personalizado por dosimetria","cumul":"Por publicar","comparador":"—","estatistica":"Por publicar","analises":"Por publicar","primario":"EFS — em planejamento","secundario":"Toxicidade tardia, segundo tumor primário — em planejamento","subgrupo":"—","tox_g3":"—","tox_interesse":"—","impacto_reg":"Investiga personalização (dosimetria) e combinação radio-sensibilizante. Parte da estratégia europeia para reduzir uso de TCTH.","limit":"Em planejamento.","ref":"Em planejamento (SIOPEN)","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. Em pediatria: sedação/anestesia conforme idade; LSI (Lugol/SSKI) padrão; antieméticos potentes; hidratação rigorosa; controle de exposição familiar/staff. Em combinações com Bu/Mel (TCTH): gap mínimo de 10 sem para reduzir risco de SOS hepática.","nct_url":"","pubmed_url":"","ano_pub":0,"status":"Em andamento","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_5"},{"estudo":"177Lu-DOTATATE em PHEO/PGL (2025)","acron":"177Lu-DOTATATE em feocromocitoma/paraganglioma metastático","nct":"NCT04157816 e outros","sponsor":"Investigador-iniciado / Multicentros","fase":"Fase 2 / coortes prospectivas","desenho":"Single-arm; PRRT em PPGL SSTR+ refratários ou MIBG-negativos.","centros":"Multicêntrico mundial","periodo":"2018 - 2025","indicacao":"PHEO/PGL metastáticos/inoperáveis SSTR+ (especialmente quando MIBG- ou refratário a MIBG)","incl":"PHEO/PGL metastático; SSTR+ (PET 68Ga-DOTATATE > captação hepática); pré-α-bloqueio se funcionantes.","excl":"Crise HAS não controlada; insuficiência cardíaca grave.","estrat":"Mutação SDHB (status); primário","basal":"Mediana 50a; SDHB mut em ~30-40%; funcionantes 60-70%.","n":"Coortes 30-50 (multicêntricas); >200 acumulados","molecular":"PET 68Ga-DOTATATE+ (Krenning ≥3).","biomarc":"Metanefrinas plasmáticas/urinárias; CgA; SDHB.","radiofarmaco":"[177Lu]Lu-DOTA-Tyr3-Octreotate","esquema":"7,4 GBq IV q8sem × 4 ciclos","cumul":"29,6 GBq","comparador":"—","estatistica":"Descritivo.","analises":"Per-protocol.","primario":"ORR ~29% (PR); SD ~58%; DCR ~87% | PFS ~26,9 m | OS ~54,8 m","secundario":"Controle sintomático (catecolaminas) em 75-90%; melhora QoL.","subgrupo":"SDHB+ tem prognóstico pior mas pode responder.","tox_g3":"Eventos hematológicos G3-4 baixos (<5%); náusea/vômitos manejáveis.","tox_interesse":"CRISES HIPERTENSIVAS: risco real durante infusão (manejar com α-bloqueio prévio + UTI se necessário); toxicidade renal mínima com aminoácidos.","impacto_reg":"Alternativa eficaz e tolerável ao 131I-MIBG em PHEO/PGL SSTR+. Especialmente útil quando captação MIBG é fraca/refratária. Off-label, mas amplamente usado.","limit":"Sem RCT pivotal; uso off-label; dados de longo prazo em populações pequenas.","ref":"Pryma DA, et al. JCO 2025; J Nucl Med 2026; Vyakaranam AR et al. 2019","category_id":"mibg_pediatria_pheo","preparo":"Aminoácidos renoprotetores obrigatórios (lisina + arginina, 25 g cada em 1 L SF, iniciados ~30 min antes e mantidos por ~4 h após). Antieméticos potentes (setrons + aprepitanto). PPGL: α-bloqueio prévio (fenoxibenzamina ou doxazosina) obrigatório em funcionantes; β-bloqueio se taquiarritmia; monitorização cardíaca/UTI peri-procedimento em alto risco. Octreotide LAR mantido em manutenção; suspender octreotide curto 24 h antes.","nct_url":"https://clinicaltrials.gov/study/NCT04157816","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/40829092/","ano_pub":2025,"status":"Publicado","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_6"},{"estudo":"131I-MIBG em adultos com PHEO/PGL (séries clássicas)","acron":"131I-MIBG terapêutico em PPGL maligno adulto","nct":"Múltiplos (séries históricas)","sponsor":"Centros de referência (UMich, UCSF, Curie)","fase":"Coortes retrospectivas / fase 2","desenho":"Single-arm; doses terapêuticas (200-300 mCi por ciclo) em PHEO/PGL maligno MIBG+.","centros":"Centros de referência mundiais","periodo":"Anos 1990-2020","indicacao":"PHEO/PGL adulto maligno, MIBG+","incl":"MIBG-positivo na cintilografia diagnóstica; doença irressecada/inoperável; ECOG 0-2.","excl":"Insuficiência renal/medular grave.","estrat":"Por série","basal":"Mediana 45-55a.","n":"Séries multicêntricas (>200 totais)","molecular":"Cintilografia 123I/131I-MIBG positiva.","biomarc":"Metanefrinas; SDHB.","radiofarmaco":"[131I]MIBG (formulação clássica low-specific activity)","esquema":"200-300 mCi por ciclo IV; pode repetir a cada 6-12 m até dose cumulativa máxima","cumul":"Cumulativa variável (até ~1 Ci em alguns casos)","comparador":"—","estatistica":"Descritivo (séries).","analises":"Per-protocol.","primario":"Controle sintomático ~75-90% | ORR 25-45% | DCR ~80%","secundario":"Sobrevida prolongada vs séries históricas; controle endócrino prolongado.","subgrupo":"Resposta correlacionada à intensidade de captação MIBG.","tox_g3":"Mielotoxicidade (frequente); hipotireoidismo (proteção com KI obrigatória); náusea.","tox_interesse":"Hipotireoidismo (40-70% mesmo com KI); SMD em FU longo; infertilidade.","impacto_reg":"Padrão histórico em PHEO/PGL maligno MIBG+ desde os anos 90. Hoje convive com AZEDRA® (formulação especificada) e 177Lu-DOTATATE. Não-AZEDRA disponível em poucos centros.","limit":"Formulação variável (sem alta atividade específica como AZEDRA); séries heterogêneas; logística complexa.","ref":"Loh KC, Shapiro B et al. (séries clássicas); Gonias S et al. JCO 2009;27:4162","category_id":"mibg_pediatria_pheo","preparo":"Proteção tireoidiana com iodeto de potássio (KI) iniciada ≥1 dia antes e mantida 10-14 dias. α-bloqueio prévio (fenoxibenzamina/doxazosina) obrigatório em PPGL funcionantes para prevenir crise hipertensiva durante a infusão; β-bloqueio se taquiarritmia. UTI ou monitorização cardíaca peri-procedimento em alto risco. Antieméticos; hidratação.","nct_url":"","pubmed_url":"","ano_pub":0,"status":"Publicado","category_name":"131I-MIBG · Pediátrico · PPGL","category_short":"MIBG/PPGL","category_color":"#ec4899","uid":"mibg_pediatria_pheo_7"},{"estudo":"CHAARTED (2015)","acron":"CHAARTED — ChemoHormonal therapy vs ADT for hormone-sensitive prostate cancer","nct":"NCT00309985","sponsor":"ECOG-ACRIN | PI: Christopher Sweeney","fase":"Fase 3, EUA","desenho":"Randomização 1:1 a ADT + Docetaxel (75 mg/m² q3sem × 6) vs ADT isolada.","centros":"Multicêntrico EUA (NCI sponsored)","periodo":"Jul/2006 - Dez/2012","indicacao":"mHSPC recém-diagnosticado, alto e baixo volume","incl":"Histologia adenocarcinoma; M1 (de novo ou metacrônico); ECOG 0-2; ADT iniciada ≤4 m antes; testosterona <50 ng/dL.","excl":"Mets cerebrais; QT prévia; ADT >4 m antes da inclusão.","estrat":"Volume CHAARTED, idade, ECOG, uso prévio de ADT adjuvante","basal":"Mediana 64a; ECOG 0-1 em 99%; alto volume em 65%; mediana de 5 mets ósseas.","n":"Planejado 780; randomizados 790 (397 + 393)","molecular":"Sem critério molecular; volume CHAARTED estabelecido aqui pela 1ª vez.","biomarc":"PSA seriado, testosterona; sem genômica obrigatória.","radiofarmaco":"Docetaxel 75 mg/m² IV q3sem × 6 ciclos (não-radiofármaco)","esquema":"ADT contínua + Docetaxel × 6 ciclos","cumul":"Doce: 450 mg/m²","comparador":"ADT contínua isolada","estatistica":"Poder 80% para OS HR 0,80; α 0,05.","analises":"ITT.","primario":"OS (todo grupo): 57,6 vs 47,2 m (HR 0,72; IC 0,59-0,89; p<0,001) | Subgrupo alto volume: 51,2 vs 34,4 m (HR 0,63) | Baixo volume: HR 1,04 (NS)","secundario":"Tempo até CRPC: 20,2 vs 11,7 m | PSA<0,2 em 12 m: 27,7% vs 16,8% | rPFS favoreceu combo.","subgrupo":"Benefício DRAMÁTICO em alto volume; baixo volume sem benefício de OS — definiu CHAARTED como critério padrão.","tox_g3":"Neutropenia G3+ (12% no combo), neutropenia febril (6%), neuropatia (8%), fadiga, alopecia.","tox_interesse":"Mortes relacionadas: 1% no combo. Toxicidade reversível.","impacto_reg":"Primeiro RCT a mostrar ganho de OS com QT em mHSPC. Estabeleceu critério de volume CHAARTED. Padrão em alto volume; combinado com tripletas modernas (PEACE-1, ARASENS).","limit":"Sem benefício em baixo volume (controverso vs STAMPEDE); toxicidade não trivial.","ref":"Sweeney CJ, et al. NEJM 2015;373:737-746; Kyriakopoulos CE et al. JCO 2018;36:1080-1087","category_id":"prostata_contexto","preparo":"Pré-medicação padrão para taxano: dexametasona (16 mg VO 12 h, 3 h e 1 h antes; ou 8 mg IV) + anti-histamínico (difenidramina) + antagonista H2 (ranitidina/famotidina) para prevenir hipersensibilidade. Antieméticos; G-CSF profilático em cabazitaxel ou se neutropenia prévia.","nct_url":"https://clinicaltrials.gov/study/NCT00309985","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/26244877/","ano_pub":2015,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_0"},{"estudo":"GETUG-AFU 15 (2013/2019)","acron":"GETUG-AFU 15 — Hormone therapy ± Docetaxel in mHSPC (French)","nct":"NCT00104715","sponsor":"Acadêmico francês (UNICANCER) | PI: Gwenaëlle Gravis","fase":"Fase 3 francesa","desenho":"Randomização 1:1 a ADT + Docetaxel (75 mg/m² q3sem × 9) vs ADT isolada.","centros":"Multicêntrico francês (UNICANCER)","periodo":"Out/2004 - Dez/2008","indicacao":"mHSPC, todos volumes","incl":"M1 (de novo ou metacrônico); ECOG 0-2; ADT permitida ≤2 m antes.","excl":"QT prévia; mets cerebrais.","estrat":"Centro, prognóstico (alto/baixo)","basal":"Mediana 63a; ECOG 0-1 em 95%; volume não pré-estratificado (post-hoc).","n":"385 randomizados","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Docetaxel 75 mg/m² IV q3sem × 9 ciclos (NÃO radiofármaco)","esquema":"ADT contínua + Doce × 9 (mais ciclos que CHAARTED)","cumul":"Doce: 675 mg/m² (mais agressivo)","comparador":"ADT isolada","estatistica":"Poder 80% para OS HR 0,80; α 0,05.","analises":"ITT.","primario":"OS: 58,9 vs 54,2 m (HR 1,01; p=0,955) — NEGATIVO | Atualização 2019 (FU 84 m): mantém negatividade no global; subgrupo alto volume com tendência (HR 0,78; NS)","secundario":"PFS bioquímica: HR 0,72 (favoreceu combo) | PFS clínica: HR 0,75 (favoreceu combo).","subgrupo":"Subgrupo alto volume post-hoc com tendência favorável; sem ganho de OS em baixo volume.","tox_g3":"Toxicidade hematológica/neuropática esperada do docetaxel; 4 mortes relacionadas (2%).","tox_interesse":"Maior toxicidade que CHAARTED (9 ciclos vs 6); 9% descontinuaram por AE.","impacto_reg":"Resultado NEGATIVO em OS — controverso vs CHAARTED/STAMPEDE. Diferenças: dose mais agressiva, seleção possivelmente diferente. Meta-análises subsequentes confirmaram benefício em alto volume.","limit":"Sample size pequeno; recrutamento estendido em era pré-CHAARTED; uso de docetaxel mais agressivo (9 ciclos) pode ter aumentado descontinuação.","ref":"Gravis G, et al. Lancet Oncol 2013;14:149-158; Eur Urol 2019;76:111-118 (final FU)","category_id":"prostata_contexto","preparo":"Pré-medicação padrão para taxano: dexametasona (16 mg VO 12 h, 3 h e 1 h antes; ou 8 mg IV) + anti-histamínico (difenidramina) + antagonista H2 (ranitidina/famotidina) para prevenir hipersensibilidade. Antieméticos; G-CSF profilático em cabazitaxel ou se neutropenia prévia.","nct_url":"https://clinicaltrials.gov/study/NCT00104715","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/23306100/","ano_pub":2013,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_1"},{"estudo":"STAMPEDE — plataforma (2015-2024)","acron":"STAMPEDE — Systemic Therapy for Advanced or Metastatic Prostate Cancer Platform","nct":"NCT00268476","sponsor":"MRC Clinical Trials Unit / UCL | PI: Nicholas James / Mahesh Parmar","fase":"Fase 3 plataforma multibraço UK","desenho":"Plataforma adaptativa multibraço com controle compartilhado (ADT). Múltiplos braços ativos sequenciais: ADT+Doce, ADT+Abi, ADT+Abi+Enza, ADT+RT (em M1 baixo volume), ADT+Abi+Ra-223 (em M0+ósseo), STAMPEDE-2 com LuPSMA.","centros":"100+ centros no Reino Unido + Suíça","periodo":"2005 - em curso","indicacao":"mHSPC e localmente avançado de alto risco","incl":"M1 OU M0 alto risco (≥2 de [T3-4, ISUP 4-5, PSA ≥40]); ADT recente.","excl":"Mets cerebrais; QT prévia; uso prévio de braço experimental.","estrat":"Por subprotocolo: idade, ECOG, volume, M1 vs M0, uso prévio adjuvante.","basal":"Mediana 65-67a (varia por braço); maioria ECOG 0-1.","n":">10.000 ao todo (cada comparação ~1.000-2.000)","molecular":"Sem critério molecular obrigatório (alguns braços com mutação ATM/BRCA exploratórios).","biomarc":"PSA, ALP, testosterona; UK Biobank-link em alguns subprotocolos.","radiofarmaco":"Diferentes intervenções por braço (não-radiofármacos exceto STAMPEDE-2 LuPSMA)","esquema":"Doce 75 mg/m² q3sem × 6 (Arm C); Abi 1000 mg + Pred 5 mg/d (Arm G); Abi+Enza 160 mg/d (Arm K); RT prostática 36 Gy/6 fr (Arm H); etc.","cumul":"Variável por braço","comparador":"ADT (controle compartilhado)","estatistica":"Poder ~80% para OS por braço; análise sequencial pré-especificada.","analises":"ITT por braço; análises de subgrupo por volume CHAARTED.","primario":"ADT+Doce vs ADT (M1): OS HR 0,78 (p<0,001) | ADT+Abi vs ADT (M1): OS HR 0,63 (p<0,001) | ADT+Abi+Enza (M1): OS HR 0,65 vs ADT+Abi (não testado vs ADT), comparação histórica suporta tripleta | ADT+RT prostática (M1 baixo volume): OS HR 0,68","secundario":"Múltiplos braços com benefícios consistentes; QoL, MFS, FFS analisados sequencialmente.","subgrupo":"Volume CHAARTED prediz benefício de QT; baixo volume beneficia mais de RT prostática.","tox_g3":"Específica de cada braço (abi: HAS/hipocalemia; doce: neutropenia; enza: fadiga/HAS).","tox_interesse":"Toxicidade aditiva em tripletas; fraturas com Ra-223 sem protetor ósseo (lição aprendida).","impacto_reg":"Plataforma britânica REVOLUCIONÁRIA: estabeleceu superioridade de TRIPLETAS (ADT+QT+ARPi) e ADT+RT em mHSPC de baixo volume. Mudou diretrizes globalmente. Brasão STAMPEDE-2 inclui LuPSMA-617 e novos ARPis.","limit":"Plataforma com complexidade analítica; comparações cross-arm com cuidado; mudança contínua de SoC ao longo de 19 anos.","ref":"James ND, et al. Lancet 2016;387:1163; NEJM 2017;377:338 (Abi); Lancet 2022;399:447 (Abi+Enza); Lancet 2018;392:2353 (RT prostática)","category_id":"prostata_contexto","preparo":"Hidratação peri-infusão (1-2 L SF); antieméticos padrão (setrons). Resfriamento glandular salivar (ice packs sobre parótidas/submandibulares durante e 1-2 h após a infusão) opcional para reduzir xerostomia.","nct_url":"https://clinicaltrials.gov/study/NCT00268476","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/26719232/","ano_pub":2015,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_2"},{"estudo":"LATITUDE (2017/2019)","acron":"LATITUDE — Abiraterone in newly diagnosed high-risk mHSPC","nct":"NCT01715285","sponsor":"Janssen | PI: Karim Fizazi","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a ADT + Abiraterona + Prednisona vs ADT + Placebo.","centros":"Multicêntrico mundial (235 sites)","periodo":"Fev/2013 - Dez/2014","indicacao":"mHSPC de novo de alto risco","incl":"Critério LATITUDE: ≥2 de 3 [ISUP 4-5, ≥3 mets ósseas, mets viscerais]; sem QT prévia.","excl":"Mets cerebrais; ECOG ≥3; uso prévio de ARPi.","estrat":"Mets viscerais (sim/não); ECOG 0-1 vs 2","basal":"Mediana 67a; ECOG 0-1 em 99%; ≥3 mets ósseas em 98%; mets viscerais em 17%.","n":"1.199 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA, ALP, testosterona, cortisol.","radiofarmaco":"Abiraterona 1000 mg VO + Prednisona 5 mg (não-radiofármaco)","esquema":"Abi 1000 mg/dia + Pred 5 mg/dia VO contínuo + ADT","cumul":"Contínuo até PD/intolerância","comparador":"ADT + Placebo","estatistica":"Poder 90% para OS HR 0,73; α 0,05.","analises":"ITT.","primario":"OS: 53,3 vs 36,5 m (HR 0,66; IC 0,56-0,78; p<0,001) | rPFS: 33,0 vs 14,8 m (HR 0,47; p<0,001)","secundario":"Tempo até PSA progression: HR 0,30 | Tempo até dor: HR 0,70 | Tempo até QT: HR 0,44 | Tempo até SSE: HR 0,75.","subgrupo":"Benefício consistente em todos os subgrupos pré-especificados.","tox_g3":"Hipertensão G3+ (20%), hipocalemia (10%), elevação enzimas hepáticas G3+ (16%), fadiga (5%).","tox_interesse":"Toxicidade hepática (monitorização ALT/AST mandatória); efeito mineralocorticoide; sem aumento significativo de eventos cardiovasculares vs placebo.","impacto_reg":"Estabeleceu ADT+Abi como SoC em mHSPC alto risco. Mudou diretrizes (NCCN/EAU/ESMO). Aprovação FDA Fev/2018 ampliada. Ganho de OS robusto mantido em FU longo.","limit":"Restrito a alto risco LATITUDE — extrapolação para baixo risco baseada em STAMPEDE.","ref":"Fizazi K, et al. NEJM 2017;377:352-360; Lancet Oncol 2019;20:686 (final OS)","category_id":"prostata_contexto","preparo":"Prednisona profilática (5 mg BID ou 5 mg/dia) obrigatória — mitigação do excesso mineralocorticoide do bloqueio CYP17 (HAS, hipocalemia, edema). Monitor ALT/AST (hepatotoxicidade), K+ e PA.","nct_url":"https://clinicaltrials.gov/study/NCT01715285","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/28578607/","ano_pub":2017,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_3"},{"estudo":"ARASENS (2022)","acron":"ARASENS — Darolutamide + Docetaxel + ADT in mHSPC","nct":"NCT02799602","sponsor":"Bayer | PI: Matthew Smith","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a ADT + Doce + Daro vs ADT + Doce + Placebo.","centros":"Multicêntrico mundial (286 sites)","periodo":"Nov/2016 - Jun/2018","indicacao":"mHSPC sintomático/assintomático elegível para QT","incl":"M1; elegível para docetaxel; ECOG 0-1; sem mets cerebrais.","excl":"QT prévia para mHSPC; mets cerebrais.","estrat":"Status M1 (volume); região","basal":"Mediana 67a; ECOG 0-1 em 96%; alto volume CHAARTED em 77%.","n":"1.305 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona, ALP.","radiofarmaco":"Darolutamida 600 mg BID VO (não-radiofármaco)","esquema":"ADT contínua + Doce 75 mg/m² q3sem × 6 + Daro 600 mg BID VO contínuo","cumul":"Doce: 450 mg/m²; Daro: contínuo até PD","comparador":"ADT + Doce + Placebo","estatistica":"Poder 90% para OS HR 0,75; α 0,05.","analises":"ITT.","primario":"OS: NÃO ATINGIDA (mediana) vs 48,9 m (HR 0,68; IC 0,57-0,80; p<0,001) — REDUÇÃO DE 32%","secundario":"Tempo até CRPC: HR 0,36 | Tempo até dor: HR 0,79 | Tempo até SSE: HR 0,71 | Tempo até nova terapia anti-câncer: HR 0,39.","subgrupo":"Benefício consistente em alto e baixo volume; magnitude similar entre subgrupos.","tox_g3":"Eventos AE semelhantes entre os braços (devido à QT predominante); fadiga, neutropenia, alopecia.","tox_interesse":"Darolutamida NÃO adiciona toxicidade significativa (estrutura química com baixa penetração SNC); sem aumento de fadiga, queda, fratura, convulsão vs placebo.","impacto_reg":"Estabeleceu TRIPLETA com darolutamida (ADT+Doce+Daro) em mHSPC. Aprovação FDA Aug/2022. Padrão moderno em mHSPC alto volume com elegibilidade a QT. Compete com PEACE-1 (Abi+Doce+ADT).","limit":"Sem braço sem QT (não testou Daro+ADT vs ADT em mHSPC); comparador é tripleta com placebo, não Abi+Doce+ADT.","ref":"Smith MR, et al. NEJM 2022;386:1132-1142","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória — perfil tolerabilidade favorável (baixa penetração SNC; sem aumento de queda/fratura/convulsão/HAS vs placebo).","nct_url":"https://clinicaltrials.gov/study/NCT02799602","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/35179323/","ano_pub":2022,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_4"},{"estudo":"PEACE-1 (2022)","acron":"PEACE-1 — Standard care ± Abiraterone ± RT in de novo mHSPC","nct":"NCT01957436","sponsor":"UNICANCER | PI: Karim Fizazi","fase":"Fase 3 plataforma 2×2 fatorial","desenho":"Desenho 2×2: ADT + Doce ± Abiraterona ± RT prostática.","centros":"Multicêntrico francês (UNICANCER)","periodo":"Nov/2013 - Dez/2018","indicacao":"mHSPC de novo (sincrônico)","incl":"M1 sincrônico; ECOG 0-2.","excl":"Mets cerebrais; QT prévia.","estrat":"Volume CHAARTED; centro","basal":"Mediana 66a; alto volume em ~70%.","n":"1.173 (4 braços)","molecular":"Sem critério molecular.","biomarc":"PSA, ALP, testosterona.","radiofarmaco":"Abiraterona 1000 mg + Pred 5 mg (não-radiofármaco)","esquema":"ADT contínua + Doce 75 mg/m² q3sem × 6 ± Abi 1000 mg/dia + Pred ± RT prostática 74 Gy","cumul":"Doce: 450 mg/m²; Abi: contínuo até PD","comparador":"ADT + Doce ± RT (sem Abi)","estatistica":"Poder 80% para rPFS HR 0,67 e OS; análise hierárquica.","analises":"ITT por subgrupo de volume.","primario":"rPFS (alto volume + Abi): HR 0,47 (p<0,001) | OS (alto volume + Abi): HR 0,72 (p=0,009)","secundario":"Subgrupo baixo volume + Abi: rPFS HR 0,58 (p<0,001), OS sem diferença significativa em FU intermediário | RT prostática: ganho em baixo volume.","subgrupo":"Alto volume = ganho de OS com Abi; baixo volume = ganho de rPFS mas não de OS na análise inicial.","tox_g3":"Hepatotoxicidade aumentada com Abi sobre QT (manejável); HAS, hipocalemia.","tox_interesse":"Tolerabilidade da combinação Abi+Doce+ADT geralmente aceitável.","impacto_reg":"Outro pilar das TRIPLETAS em mHSPC alto volume (com Abi). Reforça ADT+RT prostática em baixo volume. Junto com ARASENS, define escolhas de intensificação. Aprovação europeia.","limit":"Não compara diretamente Abi+Doce+ADT vs Daro+Doce+ADT; análise por volume essencial.","ref":"Fizazi K, et al. Lancet 2022;399:1695-1707","category_id":"prostata_contexto","preparo":"Prednisona profilática (5 mg BID ou 5 mg/dia) obrigatória — mitigação do excesso mineralocorticoide do bloqueio CYP17 (HAS, hipocalemia, edema). Monitor ALT/AST (hepatotoxicidade), K+ e PA.","nct_url":"https://clinicaltrials.gov/study/NCT01957436","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/35405085/","ano_pub":2022,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_5"},{"estudo":"ARCHES (2019/2022)","acron":"ARCHES — Enzalutamide + ADT in mHSPC","nct":"NCT02677896","sponsor":"Astellas/Pfizer | PI: Andrew Armstrong","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a Enzalutamida + ADT vs Placebo + ADT.","centros":"Multicêntrico mundial (202 sites)","periodo":"Mar/2016 - Jan/2018","indicacao":"mHSPC, alto e baixo volume","incl":"M1; ECOG 0-1; ADT recente; QT prévia para mHSPC permitida (~17%).","excl":"Mets cerebrais; uso prévio de ARPi.","estrat":"Volume CHAARTED; uso prévio de docetaxel","basal":"Mediana 70a; alto volume em 63%; doce prévio em 18%.","n":"1.150 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Enzalutamida 160 mg/dia VO (não-radiofármaco)","esquema":"Enza 160 mg/dia VO contínuo + ADT","cumul":"Contínuo até PD","comparador":"Placebo + ADT","estatistica":"Poder ≥85% para rPFS HR 0,67; α 0,05.","analises":"ITT.","primario":"rPFS: NÃO ATINGIDA vs 19,0 m (HR 0,39; p<0,001)","secundario":"OS final (FU 44 m): HR 0,66 (p<0,001) — REDUÇÃO DE 34% | Tempo até CRPC, PSA undetectable, ORR favoreceram Enza.","subgrupo":"Benefício consistente em alto e baixo volume; pacientes com doce prévio também beneficiaram.","tox_g3":"Fadiga (~24%), HAS, fraturas (5%); semelhante ao perfil esperado de Enza.","tox_interesse":"Convulsão rara (<1%); queda 4%.","impacto_reg":"Confirma enzalutamida em mHSPC. Aprovação FDA Dez/2019. Alternativa à abiraterona em mHSPC.","limit":"Sem comparação direta vs ADT+Doce ou tripletas.","ref":"Armstrong AJ, et al. JCO 2019;37:2974-2986; JCO 2022;40:1616-1622 (final OS)","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Atenção a quedas, fadiga e convulsão (rara, <1%); avaliar interações com anticonvulsivantes/SSRI (CYP3A4/2C9).","nct_url":"https://clinicaltrials.gov/study/NCT02677896","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/31329516/","ano_pub":2019,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_6"},{"estudo":"TITAN (2019/2021)","acron":"TITAN — Apalutamide + ADT in mHSPC","nct":"NCT02489318","sponsor":"Janssen | PI: Kim Chi","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a Apalutamida + ADT vs Placebo + ADT.","centros":"Multicêntrico mundial (260 sites)","periodo":"Dez/2015 - Jul/2017","indicacao":"mHSPC, todos volumes; QT prévia permitida (10%)","incl":"M1; ECOG 0-1; ADT iniciada ≤6 m antes; doce prévio para mHSPC permitido.","excl":"Mets cerebrais; uso prévio de ARPi.","estrat":"Volume CHAARTED; doce prévio; região","basal":"Mediana 69a; alto volume em 63%; doce prévio em 11%.","n":"1.052 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Apalutamida 240 mg/dia VO (não-radiofármaco)","esquema":"Apa 240 mg/dia VO contínuo + ADT","cumul":"Contínuo até PD","comparador":"Placebo + ADT","estatistica":"Poder 87% para rPFS; α 0,05.","analises":"ITT.","primario":"rPFS: NÃO ATINGIDA vs 22,1 m (HR 0,48; p<0,001) | OS: HR 0,67 (p=0,005)","secundario":"Tempo até CRPC, PSA undetectable favoreceram Apa.","subgrupo":"Benefício consistente.","tox_g3":"Rash G3+ (27%), hipotireoidismo (6%), HAS, queda (4%), fratura (4%).","tox_interesse":"RASH é diferencial da apalutamida (relacionado ao N-óxido metabólito); manejável com corticoide tópico. Hipotireoidismo monitorável.","impacto_reg":"Estabelece apalutamida em mHSPC. Aprovação FDA Set/2019. Mais um ARPi disponível.","limit":"Sem comparação direta com outros ARPis.","ref":"Chi KN, et al. NEJM 2019;381:13-24; JCO 2021;39:2294-2303","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Monitorar TSH (hipotireoidismo ~6%) e rash cutâneo (~24%, manejável com corticoide tópico).","nct_url":"https://clinicaltrials.gov/study/NCT02489318","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/31157963/","ano_pub":2019,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_7"},{"estudo":"ENZAMET (2019/2023)","acron":"ENZAMET — Enzalutamide vs NSAA + ADT in mHSPC (ANZUP)","nct":"NCT02446405","sponsor":"ANZUP | PI: Ian Davis","fase":"Fase 3, ANZUP/SWOG","desenho":"Randomização 1:1 a Enzalutamida + ADT vs NSAA padrão (bicalutamida/nilutamida/flutamida) + ADT; QT concomitante permitida.","centros":"Multicêntrico Australia/NZ + EUA (SWOG)","periodo":"Mar/2014 - Mar/2017","indicacao":"mHSPC, todos volumes; QT concomitante permitida (45%)","incl":"M1; ECOG 0-2; doce concomitante a critério.","excl":"Mets cerebrais; ARPi prévio.","estrat":"Volume; doce planejado; bisfosfonato; CrCl","basal":"Mediana 69a; alto volume em 52%; doce planejado em 45%.","n":"1.125 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Enzalutamida 160 mg/dia VO (não-radiofármaco)","esquema":"Enza 160 mg/dia VO + ADT ± Doce 75 mg/m² q3sem × 6","cumul":"Contínuo até PD","comparador":"NSAA padrão (bicalutamida etc.) + ADT (controle ATIVO, não placebo)","estatistica":"Poder 85% para OS; α 0,05.","analises":"ITT.","primario":"OS em 3 anos: 80% vs 72% (HR 0,67; p=0,002) | Final (FU 68 m): HR 0,70 (favorável) sustentado","secundario":"PFS clínica HR 0,40 | PSA-PFS HR 0,33 | QoL: leve trade-off (mais fadiga com Enza).","subgrupo":"Benefício consistente; magnitude maior em pacientes sem doce concomitante.","tox_g3":"Fadiga, fraturas, convulsões raras (1%), queda.","tox_interesse":"Tripleta Enza+Doce+ADT explorada (Enza+QT concomitante): tolerabilidade aceitável.","impacto_reg":"Suporta enzalutamida + ADT em mHSPC; permitiu uso concomitante com docetaxel. Importante para discussão de escolha entre ARPis.","limit":"Comparador NSAA hoje obsoleto; estudo aberto.","ref":"Davis ID, et al. NEJM 2019;381:121-131; Sweeney CJ et al. Lancet Oncol 2023;24:323-334","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Atenção a quedas, fadiga e convulsão (rara, <1%); avaliar interações com anticonvulsivantes/SSRI (CYP3A4/2C9).","nct_url":"https://clinicaltrials.gov/study/NCT02446405","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/31157963/","ano_pub":2019,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_8"},{"estudo":"PREVAIL (2014)","acron":"PREVAIL — Enzalutamide in pre-chemo mCRPC","nct":"NCT01212991","sponsor":"Astellas/Medivation | PI: Tomasz Beer","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a Enzalutamida vs Placebo (sem QT); pós-ADT progressivo.","centros":"Multicêntrico mundial","periodo":"Set/2010 - Set/2012","indicacao":"mCRPC pré-QT, assintomático/min sintomático","incl":"mCRPC progressivo pós-ADT; ECOG 0-1; assintomático ou min sintomático; sem QT.","excl":"Visceral grande; convulsão prévia; mets cerebrais.","estrat":"Centro, ECOG, dor (BPI)","basal":"Mediana 71a; ECOG 0-1; mediana 2 mets ósseas.","n":"1.717 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA seriado.","radiofarmaco":"Enzalutamida 160 mg/dia VO (não-radiofármaco)","esquema":"Enza 160 mg/dia VO contínuo até PD","cumul":"Contínuo","comparador":"Placebo","estatistica":"Poder 90% para OS HR 0,80; α 0,05.","analises":"ITT.","primario":"OS: 32,4 vs 30,2 m (HR 0,71; p<0,001) | rPFS: 65% redução (HR 0,19; p<0,001)","secundario":"Tempo até início QT: HR 0,35 | PSA50: 78% vs 3% | ORR: 59% vs 5% | Tempo até SSE: HR 0,72.","subgrupo":"Benefício consistente em todos os subgrupos.","tox_g3":"Fadiga (36% G1-2; G3 ~2%), HAS (13%), queda (12%), convulsão (1%).","tox_interesse":"Convulsão (raro); fadiga e quedas em idosos.","impacto_reg":"Estabelece enzalutamida em mCRPC pré-QT. Aprovação FDA Set/2014. Padrão pós-ADT. Ainda 1ª linha mCRPC hoje.","limit":"Excluiu visceral grande; placebo como comparador (ético na época mas hoje questionável).","ref":"Beer TM, et al. NEJM 2014;371:424-433","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Atenção a quedas, fadiga e convulsão (rara, <1%); avaliar interações com anticonvulsivantes/SSRI (CYP3A4/2C9).","nct_url":"https://clinicaltrials.gov/study/NCT01212991","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/24881730/","ano_pub":2014,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_9"},{"estudo":"COU-AA-302 (2013/2015)","acron":"COU-AA-302 — Abiraterone in pre-chemo mCRPC","nct":"NCT00887198","sponsor":"Janssen | PI: Charles Ryan","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a Abi+Pred vs Placebo+Pred; pré-QT.","centros":"Multicêntrico mundial","periodo":"Abr/2009 - Jun/2010","indicacao":"mCRPC pré-QT, assintomático/min sintomático","incl":"mCRPC progressivo; ECOG 0-1; sem viscerais grandes; assintomático/min sintomático.","excl":"Visceral grande; QT prévia.","estrat":"ECOG, BPI","basal":"Mediana 70a.","n":"1.088 (1:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona, cortisol.","radiofarmaco":"Abiraterona 1000 mg + Pred 5 mg BID (não-radiofármaco)","esquema":"Abi 1000 mg/dia + Pred 5 mg BID VO contínuo","cumul":"Contínuo","comparador":"Placebo + Pred","estatistica":"Poder 95% para co-primários (rPFS e OS); α 0,01 cada.","analises":"ITT.","primario":"rPFS: 16,5 vs 8,3 m (HR 0,53; p<0,001) | OS final: 34,7 vs 30,3 m (HR 0,81; p=0,003)","secundario":"Tempo até dor, QT, PSA50 favoreceram Abi.","subgrupo":"Benefício consistente.","tox_g3":"HAS G3+ (22%), hipocalemia (17%), elevação ALT/AST (12%), edema.","tox_interesse":"Toxicidade hepática (monitor ALT); efeito mineralocorticoide; Pred associada à osteoporose.","impacto_reg":"Estabelece abiraterona em mCRPC pré-QT. Aprovação FDA Dez/2012. Junto com PREVAIL, define ARPi pré-QT.","limit":"Excluiu sintomáticos significativos; não testou sequência ideal Abi vs Enza.","ref":"Ryan CJ, et al. NEJM 2013;368:138-148; Lancet Oncol 2015;16:152-160 (final OS)","category_id":"prostata_contexto","preparo":"Prednisona profilática (5 mg BID ou 5 mg/dia) obrigatória — mitigação do excesso mineralocorticoide do bloqueio CYP17 (HAS, hipocalemia, edema). Monitor ALT/AST (hepatotoxicidade), K+ e PA.","nct_url":"https://clinicaltrials.gov/study/NCT00887198","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/23228172/","ano_pub":2013,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_10"},{"estudo":"IMPACT (2010)","acron":"IMPACT — Sipuleucel-T in mCRPC","nct":"NCT00065442","sponsor":"Dendreon | PI: Philip Kantoff","fase":"Fase 3, EUA","desenho":"Randomização 2:1 a Sipuleucel-T (vacina autóloga DC) vs APC células sem antígeno.","centros":"Multicêntrico EUA","periodo":"2003 - 2007","indicacao":"mCRPC assintomático/min sintomático, sem viscerais","incl":"mCRPC; ECOG 0-1; assintomático ou min sintomático; sem viscerais; expectativa ≥6 m.","excl":"Mets viscerais; QT prévia (parcialmente); imunossupressão.","estrat":"Bisfosfonato, BPI","basal":"Mediana 71a; mediana 2-3 mets ósseas.","n":"512 (2:1)","molecular":"Sem critério molecular específico (PAP-positivo presumido).","biomarc":"PSA, células T anti-PAP em subestudo.","radiofarmaco":"Sipuleucel-T (vacina autóloga; PAP-GM-CSF; 3 infusões q2sem) — NÃO radiofármaco","esquema":"3 infusões IV q2sem com leucaférese cada vez para coleta autóloga","cumul":"3 doses (~700 milhões de APCs cada)","comparador":"APC células sem antígeno (controle ativo placebo)","estatistica":"Poder 80% para OS HR 0,80; α 0,05.","analises":"ITT.","primario":"OS: 25,8 vs 21,7 m (HR 0,78; p=0,032) — REDUÇÃO DE 22% NO RISCO","secundario":"Sem ganho de PFS, sem resposta de PSA significativa (sinal imunológico atípico — 'separation of survival curves at later time'). Imunorresposta em ~30%.","subgrupo":"Benefício maior em pacientes com PSA basal baixo.","tox_g3":"Reações infusionais (calafrios, febre, náusea); sem aumento significativo de eventos graves.","tox_interesse":"Reação infusional aguda (geralmente nas primeiras 24 h); manejável.","impacto_reg":"PRIMEIRA imunoterapia FDA-aprovada (Abr 2010) em câncer de próstata. Estabelece imunoterapia celular como modalidade. Uso atual mais limitado por logística (leucaférese), custo e ausência de efeito em PSA/PFS.","limit":"Logística complexa (leucaférese); custo elevado; sem efeito em PSA dificulta percepção clínica de benefício; muitos centros descontinuaram uso.","ref":"Kantoff PW, et al. NEJM 2010;363:411-422","category_id":"prostata_contexto","preparo":"Acetaminofeno (paracetamol) + anti-histamínico (difenidramina) 30 min antes de cada infusão para mitigar reações infusionais agudas (calafrios, febre).","nct_url":"https://clinicaltrials.gov/study/NCT00065442","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/20818862/","ano_pub":2010,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_11"},{"estudo":"AFFIRM (2012)","acron":"AFFIRM — Enzalutamide post-docetaxel in mCRPC","nct":"NCT00974311","sponsor":"Astellas/Medivation | PI: Howard Scher","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Enza vs Placebo; pós-doce.","centros":"Multicêntrico mundial","periodo":"Set/2009 - Mai/2010","indicacao":"mCRPC pós-docetaxel","incl":"Pós-doce; ECOG 0-2; mCRPC.","excl":"Convulsão prévia; mets cerebrais.","estrat":"ECOG, BPI","basal":"Mediana 69a.","n":"1.199 (2:1)","molecular":"Sem critério molecular.","biomarc":"PSA seriado.","radiofarmaco":"Enzalutamida 160 mg/dia VO (não-radiofármaco)","esquema":"Enza 160 mg/dia VO contínuo","cumul":"Contínuo","comparador":"Placebo","estatistica":"Poder 95% para OS; α 0,05.","analises":"ITT; estudo encerrado precocemente em análise interina.","primario":"OS: 18,4 vs 13,6 m (HR 0,63; p<0,001) — REDUÇÃO DE 37%","secundario":"PSA50: 54% vs 2% | ORR: 29% vs 4% | rPFS HR 0,40 | Tempo até SSE: HR 0,69.","subgrupo":"Benefício consistente.","tox_g3":"Fadiga, HAS, convulsão (0,6%).","tox_interesse":"Convulsão raro mas requer atenção.","impacto_reg":"Primeiro fase III positivo de enzalutamida (Aug 2012). Pós-doce com ganho de OS robusto. Padrão pós-QT.","limit":"Comparador placebo (ético na época).","ref":"Scher HI, et al. NEJM 2012;367:1187-1197","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Atenção a quedas, fadiga e convulsão (rara, <1%); avaliar interações com anticonvulsivantes/SSRI (CYP3A4/2C9).","nct_url":"https://clinicaltrials.gov/study/NCT00974311","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/22894553/","ano_pub":2012,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_12"},{"estudo":"COU-AA-301 (2011)","acron":"COU-AA-301 — Abiraterone post-docetaxel in mCRPC","nct":"NCT00638690","sponsor":"Janssen | PI: Johann de Bono","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Abi+Pred vs Placebo+Pred; pós-doce.","centros":"Multicêntrico mundial","periodo":"Mai/2008 - Jul/2009","indicacao":"mCRPC pós-docetaxel","incl":"Pós-doce; ECOG 0-2; mCRPC progressivo.","excl":"QT prévia >2 linhas; insuficiência hepática.","estrat":"ECOG, BPI, status pós-doce","basal":"Mediana 69a.","n":"1.195 (2:1)","molecular":"Sem critério molecular.","biomarc":"PSA, ALP, testosterona.","radiofarmaco":"Abiraterona 1000 mg + Pred 5 mg BID (não-radiofármaco)","esquema":"Abi 1000 mg/dia + Pred 5 mg BID VO contínuo","cumul":"Contínuo","comparador":"Placebo + Pred","estatistica":"Poder 90% para OS; α 0,05.","analises":"ITT.","primario":"OS: 14,8 vs 10,9 m (HR 0,65; p<0,001)","secundario":"PSA50: 29% vs 6% | ORR: 14% vs 3% | Tempo até PSA progression, dor, SSE favoreceram Abi.","subgrupo":"Benefício consistente.","tox_g3":"Hipocalemia (4%), edema (2%), HAS, hepatotoxicidade.","tox_interesse":"Mineralocorticoide-related (HAS, hipocalemia, edema) manejado com Pred.","impacto_reg":"Primeiro fase III positivo de abiraterona (Set 2011) — primeiro ARPi 'moderno' aprovado. Pós-doce. Diretrizes mundiais.","limit":"Comparador placebo (ético na época).","ref":"de Bono JS, et al. NEJM 2011;364:1995-2005","category_id":"prostata_contexto","preparo":"Prednisona profilática (5 mg BID ou 5 mg/dia) obrigatória — mitigação do excesso mineralocorticoide do bloqueio CYP17 (HAS, hipocalemia, edema). Monitor ALT/AST (hepatotoxicidade), K+ e PA.","nct_url":"https://clinicaltrials.gov/study/NCT00638690","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/21612468/","ano_pub":2011,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_13"},{"estudo":"SPARTAN (2018/2020)","acron":"SPARTAN — Apalutamide in nmCRPC","nct":"NCT01946204","sponsor":"Janssen | PI: Matthew Smith","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Apa+ADT vs Placebo+ADT.","centros":"Multicêntrico mundial","periodo":"Out/2013 - Dez/2016","indicacao":"nmCRPC com PSA-DT ≤10 m (alto risco de mets)","incl":"M0 por imagens convencionais (TC + cintilo); PSA-DT ≤10 m; ADT contínua.","excl":"Mets distantes em imagem convencional; PSA-DT >10 m; convulsão.","estrat":"PSA-DT, uso bisfosfonato","basal":"Mediana 74a; PSA mediano 8 ng/mL; PSA-DT mediano 4,4 m.","n":"1.207 (2:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Apalutamida 240 mg/dia VO (não-radiofármaco)","esquema":"Apa 240 mg/dia VO contínuo + ADT","cumul":"Contínuo","comparador":"Placebo + ADT","estatistica":"Poder 85% para MFS HR 0,67; α 0,05.","analises":"ITT.","primario":"MFS: 40,5 vs 16,2 m (HR 0,28; p<0,001) — REDUÇÃO DE 72%","secundario":"OS final: 73,9 vs 59,9 m (HR 0,78; p=0,016) | Tempo até início QT: HR 0,44 | PFS-2: HR 0,55 | Tempo até dor sintomática: HR 0,57.","subgrupo":"Benefício consistente.","tox_g3":"Rash (24%), HAS (25%), queda (16%), fratura (12%), hipotireoidismo (8%).","tox_interesse":"Rash, hipotireoidismo, queda, fratura — perfil clínico característico da apalutamida.","impacto_reg":"Aprovação FDA Fev/2018. Define apalutamida em nmCRPC alto risco. Padrão antes de imagens metabólicas substituírem definição M0 (PET-PSMA reclassifica muitos M0 → M1).","limit":"Definição M0 hoje questionável com PSMA-PET (oligo-mets ocultas em imagens convencionais); FU longo essencial.","ref":"Smith MR, et al. NEJM 2018;378:1408-1418; Eur Urol 2021;79:150-158 (final OS)","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Monitorar TSH (hipotireoidismo ~6%) e rash cutâneo (~24%, manejável com corticoide tópico).","nct_url":"https://clinicaltrials.gov/study/NCT01946204","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/29420164/","ano_pub":2018,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_14"},{"estudo":"PROSPER (2018/2020)","acron":"PROSPER — Enzalutamide in nmCRPC","nct":"NCT02003924","sponsor":"Astellas/Pfizer | PI: Maha Hussain","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Enza+ADT vs Placebo+ADT.","centros":"Multicêntrico mundial","periodo":"Nov/2013 - Jun/2017","indicacao":"nmCRPC com PSA-DT ≤10 m","incl":"M0 por imagem convencional; PSA-DT ≤10 m.","excl":"Mets distantes; convulsão.","estrat":"PSA-DT, bisfosfonato","basal":"Mediana 74a.","n":"1.401 (2:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Enzalutamida 160 mg/dia VO (não-radiofármaco)","esquema":"Enza 160 mg/dia VO contínuo + ADT","cumul":"Contínuo","comparador":"Placebo + ADT","estatistica":"Poder 95% para MFS HR 0,73; α 0,05.","analises":"ITT.","primario":"MFS: 36,6 vs 14,7 m (HR 0,29; p<0,001) — REDUÇÃO DE 71%","secundario":"OS final: 67,0 vs 56,3 m (HR 0,73; p=0,001) | Tempo até nova terapia: HR 0,21 | Tempo até PSA progression: HR 0,07.","subgrupo":"Benefício consistente.","tox_g3":"Fadiga (33%), HAS, queda (5%), eventos cardiovasculares; sem aumento significativo de fratura.","tox_interesse":"Convulsão rara; fadiga e queda em idosos.","impacto_reg":"Aprovação FDA Jul/2018. Estabelece enzalutamida em nmCRPC. Junto com SPARTAN/ARAMIS define as 3 opções.","limit":"Definição M0 hoje questionável com PSMA-PET.","ref":"Hussain M, et al. NEJM 2018;378:2465-2474; NEJM 2020;382:2197-2206 (final OS)","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória. Atenção a quedas, fadiga e convulsão (rara, <1%); avaliar interações com anticonvulsivantes/SSRI (CYP3A4/2C9).","nct_url":"https://clinicaltrials.gov/study/NCT02003924","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/29949494/","ano_pub":2018,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_15"},{"estudo":"ARAMIS (2019/2020)","acron":"ARAMIS — Darolutamide in nmCRPC","nct":"NCT02200614","sponsor":"Bayer/Orion | PI: Karim Fizazi","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Daro+ADT vs Placebo+ADT.","centros":"Multicêntrico mundial","periodo":"Set/2014 - Jun/2018","indicacao":"nmCRPC com PSA-DT ≤10 m","incl":"M0 por imagem convencional; PSA-DT ≤10 m.","excl":"Mets distantes; convulsão; eventos cardiovasculares recentes.","estrat":"PSA-DT, bisfosfonato","basal":"Mediana 74a.","n":"1.509 (2:1)","molecular":"Sem critério molecular.","biomarc":"PSA, testosterona.","radiofarmaco":"Darolutamida 600 mg BID VO (não-radiofármaco)","esquema":"Daro 600 mg BID VO contínuo + ADT","cumul":"Contínuo","comparador":"Placebo + ADT","estatistica":"Poder 90% para MFS HR 0,67; α 0,05.","analises":"ITT.","primario":"MFS: 40,4 vs 18,4 m (HR 0,41; p<0,001)","secundario":"OS final: HR 0,69 (p=0,003) | Tempo até dor, QT, SSE: favoreceram Daro.","subgrupo":"Benefício consistente.","tox_g3":"PERFIL MAIS LIMPO entre os 3: SEM aumento de queda, fratura, convulsão, HAS — diferencial da darolutamida (estrutura química única, baixa penetração SNC).","tox_interesse":"Sem convulsão; sem aumento de fadiga vs placebo; sem aumento de eventos cardiovasculares.","impacto_reg":"Aprovação FDA Jul/2019. Darolutamida é PREFERIDA quando QoL/SNC importam (idosos, polifarmácia). Padrão em nmCRPC.","limit":"Definição M0 hoje questionável com PSMA-PET.","ref":"Fizazi K, et al. NEJM 2019;380:1235-1246; NEJM 2020;383:1040-1049 (final OS)","category_id":"prostata_contexto","preparo":"Sem pré-medicação específica obrigatória — perfil tolerabilidade favorável (baixa penetração SNC; sem aumento de queda/fratura/convulsão/HAS vs placebo).","nct_url":"https://clinicaltrials.gov/study/NCT02200614","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/30763142/","ano_pub":2019,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_16"},{"estudo":"PROfound (2020)","acron":"PROfound — Olaparib in mCRPC with HRR mutations","nct":"NCT02987543","sponsor":"AstraZeneca/Merck | PI: Johann de Bono","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Olaparib vs troca de ARPi (abi↔enza); seleção PRÉVIA por mutação HRR.","centros":"Multicêntrico mundial","periodo":"Fev/2017 - Jul/2018","indicacao":"mCRPC pós-ARPi com mutação HRR (BRCA1/2, ATM e outros 12 genes)","incl":"Pós-≥1 ARPi; mutação HRR documentada em tumor (NGS); ECOG 0-2; ADT contínua.","excl":"QT prévia para mCRPC; mets cerebrais; uso prévio de PARP.","estrat":"Coorte (A: BRCA1/2/ATM; B: outros 12 genes); doce prévio; mets viscerais","basal":"Mediana 67a.","n":"387 (2:1) — coorte A 245, coorte B 142","molecular":"MUTAÇÃO HRR EM TUMOR (NGS): coorte A (BRCA1/2, ATM); coorte B (CDK12, CHEK1/2 e outros).","biomarc":"Painel HRR em tumor (Foundation Medicine T7).","radiofarmaco":"Olaparib 300 mg BID VO (não-radiofármaco)","esquema":"Olaparib 300 mg BID VO contínuo até PD","cumul":"Contínuo","comparador":"Troca de ARPi (abiraterona ↔ enzalutamida)","estatistica":"Poder >80% para rPFS coorte A; α 0,05.","analises":"ITT por coorte.","primario":"rPFS coorte A: 7,4 vs 3,6 m (HR 0,34; p<0,0001) | rPFS população total (A+B): 5,8 vs 3,5 m (HR 0,49; p<0,0001)","secundario":"OS coorte A: 19,1 vs 14,7 m (HR 0,69; p=0,02; ajustado por crossover) | ORR: 33% vs 2% | PFS-2 favoreceu Olaparib.","subgrupo":"BRCA1/2 com benefício máximo; ATM com benefício menor (HR ~0,73); coorte B (outros HRR) menos beneficiada.","tox_g3":"Anemia G3+ (22%), náusea, fadiga, embolia pulmonar (5%).","tox_interesse":"Embolia pulmonar/TVP é evento de classe; SMD/leucemia em FU longo (~2-4%).","impacto_reg":"Primeiro fase III de PARP em mCRPC HRR+. Aprovação FDA Mai/2020. Estabelece TESTE GENÉTICO como obrigatório em mCRPC. BRCA1/2 são os respondedores principais.","limit":"Comparador é troca de ARPi (questionável atividade); diferenças de magnitude entre genes HRR.","ref":"de Bono J, et al. NEJM 2020;382:2091-2102","category_id":"prostata_contexto","preparo":"Antieméticos (náusea é comum); hemograma seriado obrigatório (anemia G3+ frequente — talazoparibe ~43%, olaparib ~22%, niraparib ~28%); transfusões e ajustes de dose conforme necessário; avaliação de risco tromboembólico (TVP/EP em ~5-7%).","nct_url":"https://clinicaltrials.gov/study/NCT02987543","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/32343890/","ano_pub":2020,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_17"},{"estudo":"TRITON3 (2023)","acron":"TRITON3 — Rucaparib in mCRPC with BRCA/ATM mutations","nct":"NCT02975934","sponsor":"Clovis Oncology / Pharma & | PI: Karim Fizazi","fase":"Fase 3, internacional","desenho":"Randomização 2:1 a Rucaparib vs investigador escolhe (docetaxel OU 2ª ARPi); pré-QT.","centros":"Multicêntrico mundial","periodo":"2017 - 2021","indicacao":"mCRPC com mutação BRCA1/2 ou ATM, pós-1 ARPi (pré-QT)","incl":"Pós-1 ARPi; mutação BRCA1/2 ou ATM em tumor ou germline; ECOG 0-2.","excl":"QT prévia para mCRPC; PARP prévio.","estrat":"Tipo de mutação (BRCA vs ATM); região","basal":"Mediana 70a.","n":"405 (2:1) — BRCA 302, ATM 103","molecular":"MUTAÇÃO BRCA1/2 OU ATM (tumor ou germline).","biomarc":"Painel HRR; ctDNA exploratório.","radiofarmaco":"Rucaparib 600 mg BID VO (não-radiofármaco)","esquema":"Rucaparib 600 mg BID VO contínuo","cumul":"Contínuo","comparador":"Docetaxel 75 mg/m² q3sem × 10 OU 2ª ARPi (escolha investigador)","estatistica":"Poder >80% para rPFS BRCA; α 0,025.","analises":"ITT por coorte.","primario":"rPFS BRCA: 11,2 vs 6,4 m (HR 0,50; p<0,001) | rPFS população total: 10,2 vs 6,4 m (HR 0,61; p<0,001) | ATM: SEM benefício (HR 0,95)","secundario":"ORR BRCA: 45% vs 21% | OS imatura na análise principal.","subgrupo":"BRCA tem benefício forte; ATM NÃO RESPONDE — restringe uso a BRCA1/2.","tox_g3":"Anemia G3+ (24%), náusea, fadiga.","tox_interesse":"Anemia é o evento mais comum; SMD em FU longo.","impacto_reg":"Segundo PARP em mCRPC HRR+. Aprovação FDA 2023. Confirma ATM NÃO RESPONDE — restringe uso a BRCA1/2 (NCCN). Reforça importância do perfil genético específico.","limit":"ATM coorte negativa; análise por mutação específica essencial.","ref":"Fizazi K, et al. NEJM 2023;388:719-732","category_id":"prostata_contexto","preparo":"Antieméticos (náusea é comum); hemograma seriado obrigatório (anemia G3+ frequente — talazoparibe ~43%, olaparib ~22%, niraparib ~28%); transfusões e ajustes de dose conforme necessário; avaliação de risco tromboembólico (TVP/EP em ~5-7%).","nct_url":"https://clinicaltrials.gov/study/NCT02975934","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/36795891/","ano_pub":2023,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_18"},{"estudo":"PROpel (2022/2023)","acron":"PROpel — Abiraterone + Olaparib in 1L mCRPC (all-comers)","nct":"NCT03732820","sponsor":"AstraZeneca | PI: Noel Clarke / Fred Saad","fase":"Fase 3, internacional","desenho":"Randomização 1:1 a Abi + Olaparib vs Abi + Placebo; SEM seleção por HRR (all-comers).","centros":"Multicêntrico mundial","periodo":"Out/2018 - Jul/2020","indicacao":"mCRPC 1ª linha (sem QT prévia para mCRPC); HRR+ E HRR− (todos)","incl":"mCRPC; sem QT prévia para mCRPC; ECOG 0-1; ADT contínua; mets documentadas.","excl":"Doce/Cabaz prévio para mCRPC; ARPi prévio para mCRPC; uso prévio de PARP.","estrat":"Local de mets (visceral vs ósseo só); doce prévio para mHSPC","basal":"Mediana 70a.","n":"796 (1:1)","molecular":"SEM seleção prévia por HRR; análise estratificada post-hoc (HRR+ ~28%).","biomarc":"ctDNA + tecido HRR (analisados retrospectivamente).","radiofarmaco":"Olaparib 300 mg BID + Abi 1000 mg + Pred (não-radiofármaco)","esquema":"Abi 1000 mg/dia + Pred 5 mg BID + Olaparib 300 mg BID VO contínuo","cumul":"Contínuo","comparador":"Abi 1000 mg + Pred + Placebo","estatistica":"Poder ≥85% para rPFS HR 0,67; α 0,05.","analises":"ITT (all-comers); subgrupo HRR.","primario":"rPFS ITT: 24,8 vs 16,6 m (HR 0,66; p<0,001) | rPFS HRR+: HR 0,50 | rPFS HRR−: HR 0,76 (ainda favorável)","secundario":"OS ITT: 42,1 vs 34,7 m (HR 0,81; p=0,054 — não significativo) | Subgrupo BRCA: HR ~0,30 (forte benefício).","subgrupo":"BRCA1/2 com magnitude muito maior; HRR− com benefício menor mas presente em rPFS.","tox_g3":"Anemia G3+ (16%), embolia pulmonar (7%), TVP, fadiga.","tox_interesse":"Embolia pulmonar é evento de classe; anemia frequente.","impacto_reg":"Aprovação FDA 2023 RESTRITA a BRCA1/2 (NÃO 'all-comers' devido a OS NS no ITT). Discussão ativa: combinar PARPi+ARPi em todos vs só HRR+? Diretrizes restringem a HRR+/BRCA+.","limit":"OS ITT NÃO atingida — diretrizes restringem aprovação a BRCA1/2.","ref":"Clarke NW, et al. NEJM Evid 2022; Saad F et al. Lancet Oncol 2023;24:1067-1078","category_id":"prostata_contexto","preparo":"Prednisona profilática (5 mg BID) obrigatória — mitigação do excesso mineralocorticoide do bloqueio CYP17 (HAS, hipocalemia, edema). Monitor ALT/AST, K+ e PA (Abi). PARP: antieméticos; hemograma seriado (anemia/plaquetopenia); avaliação de risco tromboembólico (TVP/EP em ~5-7%).","nct_url":"https://clinicaltrials.gov/study/NCT03732820","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/36746434/","ano_pub":2022,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_19"},{"estudo":"MAGNITUDE (2022/2024)","acron":"MAGNITUDE — Niraparib + Abiraterone in 1L mCRPC (HRR+ selected)","nct":"NCT03748641","sponsor":"Janssen | PI: Kim Chi","fase":"Fase 3, internacional","desenho":"Randomização 1:1; coorte HRR+ (selecionada) E coorte HRR− separada (encerrada precocemente por futilidade).","centros":"Multicêntrico mundial","periodo":"Mar/2019 - Mai/2021","indicacao":"mCRPC 1ª linha; coorte HRR+ E coorte HRR−","incl":"mCRPC; sem QT prévia; mutação HRR em coorte HRR+ (BRCA1/2 e outros 7 genes).","excl":"QT prévia; ARPi prévio para mCRPC.","estrat":"Tipo de mutação; uso prévio de doce para mHSPC; status HRR","basal":"Mediana 69a.","n":"423 HRR+ + 247 HRR− (encerrado precocemente em HRR− por futilidade)","molecular":"SELEÇÃO PRÉVIA POR HRR+ (BRCA1/2 e 7 outros genes); coorte HRR− separada.","biomarc":"Painel HRR; ctDNA.","radiofarmaco":"Niraparib 200 mg/dia + Abi 1000 mg + Pred (não-radiofármaco)","esquema":"Abi 1000 mg/dia + Pred + Niraparib 200 mg/dia VO contínuo","cumul":"Contínuo","comparador":"Abi + Pred + Placebo","estatistica":"Poder ≥85% para rPFS HRR+; α 0,025.","analises":"ITT por coorte.","primario":"rPFS HRR+: 16,5 vs 13,7 m (HR 0,73; p=0,022) | rPFS BRCA1/2: HR 0,53 (forte benefício)","secundario":"OS BRCA1/2: HR 0,55 favorável | OS HRR+ ITT: HR 0,79 (NS) | rPFS HRR− coorte: SEM benefício (encerrada por futilidade).","subgrupo":"BRCA1/2 com benefício máximo; HRR não-BRCA com magnitude menor.","tox_g3":"Anemia G3+ (28%), trombocitopenia, hipertensão, fadiga.","tox_interesse":"Anemia mais frequente que com olaparib (perfil diferente).","impacto_reg":"Reforça posição: PARPi+ARPi BENEFICIA HRR+ (especialmente BRCA), MAS NÃO HRR−. Aprovação FDA Aug/2023 restrita a BRCA1/2. Diferente do PROpel (all-comers ITT).","limit":"HRR− coorte negativa (encerrada); seleção rigorosa por HRR+ vs PROpel all-comers.","ref":"Chi KN, et al. JCO 2022;40:LBA12; Ann Oncol 2024 (final OS)","category_id":"prostata_contexto","preparo":"Prednisona profilática (5 mg BID) obrigatória — mitigação do excesso mineralocorticoide do bloqueio CYP17 (HAS, hipocalemia, edema). Monitor ALT/AST, K+ e PA (Abi). PARP: antieméticos; hemograma seriado (anemia/plaquetopenia); avaliação de risco tromboembólico (TVP/EP em ~5-7%).","nct_url":"https://clinicaltrials.gov/study/NCT03748641","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/35658493/","ano_pub":2022,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_20"},{"estudo":"TALAPRO-2 (2023/2024)","acron":"TALAPRO-2 — Talazoparib + Enzalutamide in 1L mCRPC (ITT and HRR+ cohorts)","nct":"NCT03395197","sponsor":"Pfizer | PI: Neeraj Agarwal / Karim Fizazi","fase":"Fase 3, internacional","desenho":"Randomização 1:1 em duas coortes: (1) ITT (todos) e (2) HRR+ (selecionada).","centros":"Multicêntrico mundial","periodo":"Jan/2019 - Set/2020","indicacao":"mCRPC 1ª linha; coorte 1: ITT (todos); coorte 2: HRR+ separada","incl":"mCRPC 1ª linha; coorte HRR+: mutação HRR em tumor; ECOG 0-1.","excl":"QT prévia para mCRPC; ARPi prévio para mCRPC; uso prévio de PARP.","estrat":"Status HRR; uso prévio de doce para mHSPC; uso prévio de abi para mHSPC","basal":"Mediana 71a.","n":"805 (1:1) ITT (coorte 1); 399 (1:1) HRR+ (coorte 2)","molecular":"Coorte 1 ITT (todos); Coorte 2 HRR+ (BRCA1/2 e 11 outros genes).","biomarc":"Painel HRR; ctDNA exploratório.","radiofarmaco":"Talazoparibe 0,5 mg/dia + Enza 160 mg/dia (não-radiofármaco)","esquema":"Enza 160 mg/dia + Talazoparibe 0,5 mg/dia VO contínuo","cumul":"Contínuo","comparador":"Enza + Placebo","estatistica":"Poder ≥90% para rPFS; α 0,025 cada coorte.","analises":"ITT por coorte.","primario":"rPFS ITT: NÃO atingiu vs 21,9 m (HR 0,63; p<0,001) | rPFS HRR+: 27,9 vs 16,4 m (HR 0,46; p<0,0001) | rPFS BRCA1/2: HR 0,20","secundario":"OS ITT (final): HR 0,80 (p=0,055; tendência) | OS HRR+: HR 0,62 favorável | ORR: 62% vs 44%.","subgrupo":"BRCA1/2 com benefício máximo (HR 0,20); HRR não-BRCA com benefício maior que esperado.","tox_g3":"ANEMIA G3+ MUITO FREQUENTE (43%) — exige monitoramento e transfusões; trombocitopenia, neutropenia, fadiga.","tox_interesse":"Toxicidade hematológica é a principal limitação (talazoparibe é o PARP mais 'potente'); embolia pulmonar.","impacto_reg":"Aprovação FDA 2023 (HRR+) e 2024 (ITT — única combinação aprovada para 'all-comers' em mCRPC). Toxicidade hematológica é a limitação prática. Maior magnitude de benefício em BRCA1/2.","limit":"Toxicidade hematológica significativa; seleção cuidadosa em pacientes; comparador é monoterapia (não inclui Doce).","ref":"Agarwal N, et al. Lancet 2023;402:291-303; Fizazi K et al. Nat Med 2024","category_id":"prostata_contexto","preparo":"Antieméticos (náusea é comum); hemograma seriado obrigatório (anemia G3+ frequente — talazoparibe ~43%, olaparib ~22%, niraparib ~28%); transfusões e ajustes de dose conforme necessário; avaliação de risco tromboembólico (TVP/EP em ~5-7%).","nct_url":"https://clinicaltrials.gov/study/NCT03395197","pubmed_url":"https://pubmed.ncbi.nlm.nih.gov/37414009/","ano_pub":2023,"status":"Publicado","category_name":"Oncologia Próstata · Contexto","category_short":"Contexto Próstata","category_color":"#64748b","uid":"prostata_contexto_21"},{"estudo":"KEYNOTE-024 (2016)","acron":"KEYNOTE-024 — Pembrolizumab vs QT em NSCLC PD-L1 ≥50%","nct":"NCT02142738","sponsor":"MSD | PI: Reck","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Randomização 1:1 a pembrolizumab 200 mg q3w vs QT à base de platina por 4-6 ciclos. Crossover permitido na progressão.","centros":"102 centros, 16 países","periodo":"2014-2015","indicacao":"NSCLC avançado, 1L, PD-L1 TPS ≥50%, sem driver EGFR/ALK","incl":"Idade ≥18a; ECOG 0-1; PD-L1 ≥50% (22C3); doença mensurável RECIST 1.1; sem QT prévia para metastático","excl":"EGFR/ALK+; doença autoimune ativa; metástases SNC sintomáticas; uso de corticoide >10 mg/d","estrat":"ECOG, histologia, região","basal":"Mediana 65a; ~62% homens; histologia não-escamosa 81%","n":"N=305 (154 pembro + 151 QT)","molecular":"PD-L1 TPS ≥50% (Dako 22C3)","biomarc":"PD-L1 imunohistoquímica","radiofarmaco":"Pembrolizumab 200 mg EV q3w","esquema":"Pembro 200 mg EV q3w até 35 ciclos ou progressão","cumul":"—","comparador":"QT à base de platina (4-6 ciclos): pemetrexed+cis/carbo (não-escamoso) ou gen+cis/pacli+carbo (escamoso)","estatistica":"Endpoints duplos: PFS e OS. HR alvo 0,65","analises":"ITT; análise interina pré-especificada","primario":"PFS por BICR: 10,3 vs 6,0 m (HR 0,50; p<0,001). OS: 30,0 vs 14,2 m (HR 0,63)","secundario":"ORR 44,8 vs 27,8%; DoR não atingida vs 6,3 m","subgrupo":"Benefício mantido em todos os subgrupos pré-especificados","tox_g3":"≥G3: 26,6 vs 53,3% (a favor de pembro)","tox_interesse":"Pneumonite 5,8% (G3 2,6%), hipotireoidismo 9,1%, colite 1,3%","impacto_reg":"Aprovação FDA 2016 e EMA 2017 · pembrolizumab 1L PD-L1 ≥50%","limit":"Crossover de 50% no braço QT pode subestimar OS; sem comparação com pembro+QT (KEYNOTE-189 viria depois)","ref":"https://www.nejm.org/doi/full/10.1056/NEJMoa1606774","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT02142738","pubmed_url":"https://www.nejm.org/doi/full/10.1056/NEJMoa1606774","ano_pub":2016,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"keynote-024-pembrolizumab-vs-qt-em-nsclc-pd-l1-50"},{"estudo":"KEYNOTE-189 (2018)","acron":"KEYNOTE-189 — Pembro+pemetrexed+platina em NSCLC não-escamoso 1L","nct":"NCT02578680","sponsor":"MSD | PI: Gandhi","fase":"Fase 3, internacional, randomizado, duplo-cego, placebo-controlado","desenho":"Randomização 2:1 a pembro+pemetrexed+platina vs placebo+pemetrexed+platina por 4 ciclos, depois manutenção pembro+pemetrexed.","centros":"126 centros, 16 países","periodo":"2016-2017","indicacao":"NSCLC não-escamoso avançado, 1L, sem EGFR/ALK","incl":"ECOG 0-1; sem QT prévia; doença mensurável; sem mets SNC ativa","excl":"EGFR/ALK+; histologia escamosa; pneumonite prévia","estrat":"PD-L1 (<1% / 1-49% / ≥50%); platina (cis vs carbo); fumante","basal":"Mediana 65a; PD-L1 <1% 31%; 1-49% 31%; ≥50% 32%","n":"N=616 (410 + 206)","molecular":"Estratificado por PD-L1 (todos os níveis)","biomarc":"PD-L1 22C3 (estratificação)","radiofarmaco":"Pembro + pemetrexed + cis/carbo","esquema":"Pembro 200 mg + pemetrexed 500 mg/m² + cis 75 ou carbo AUC5 q3w × 4 ciclos; depois pembro+pemetrexed manutenção até 35 ciclos","cumul":"—","comparador":"Placebo + pemetrexed + platina; crossover permitido na progressão","estatistica":"Endpoints duplos: PFS e OS","analises":"ITT","primario":"OS 22,0 vs 10,7 m (HR 0,49; p<0,001). PFS 9,0 vs 4,9 m (HR 0,52)","secundario":"ORR 47,6 vs 18,9%; DoR 11,2 vs 7,8 m","subgrupo":"Benefício em todos PD-L1, inclusive <1% (HR OS 0,52)","tox_g3":"≥G3: 67,2 vs 65,8%","tox_interesse":"LRA G3+ 5,2%; pneumonite 4,4%","impacto_reg":"Aprovação FDA/EMA 2018 · padrão 1L NSCLC não-escamoso","limit":"Não-escamoso apenas; análise atualizada de 5 anos manteve benefício (OS 22,0 vs 10,6 m)","ref":"https://www.nejm.org/doi/full/10.1056/NEJMoa1801005","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT02578680","pubmed_url":"https://www.nejm.org/doi/full/10.1056/NEJMoa1801005","ano_pub":2018,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"keynote-189-pembro-pemetrexed-platina-em-nsclc-n-o-escamoso-1l"},{"estudo":"KEYNOTE-407 (2018)","acron":"KEYNOTE-407 — Pembro+QT em NSCLC escamoso 1L","nct":"NCT02775435","sponsor":"MSD | PI: Paz-Ares","fase":"Fase 3, internacional, randomizado, duplo-cego, placebo-controlado","desenho":"Pembro+carbo+(paclitaxel ou nab-paclitaxel) × 4 ciclos, depois pembro manutenção","centros":"Multinacional","periodo":"2016-2017","indicacao":"NSCLC escamoso avançado, 1L, sem EGFR/ALK","incl":"ECOG 0-1; histologia escamosa; sem QT prévia","excl":"Pneumonite prévia; mets SNC ativa","estrat":"PD-L1 (<1% / 1-49% / ≥50%); paclitaxel vs nab-paclitaxel; região","basal":"Mediana 65a; ECOG 0-1","n":"N=559 (278 + 281)","molecular":"Estratificado por PD-L1","biomarc":"PD-L1 22C3","radiofarmaco":"Pembro + carbo + paclitaxel/nab-paclitaxel","esquema":"Pembro 200 mg + carbo AUC6 + paclitaxel 200 mg/m² ou nab-paclitaxel 100 mg/m² q3w × 4; depois pembro manutenção até 35 ciclos","cumul":"—","comparador":"Placebo + mesma QT","estatistica":"Endpoints duplos: OS e PFS","analises":"ITT","primario":"OS 17,1 vs 11,6 m (HR 0,71; p<0,001). PFS 8,0 vs 5,1 m (HR 0,57)","secundario":"ORR 62,6 vs 38,4%; benefício em todos PD-L1","subgrupo":"HR OS consistente em PD-L1 <1%, 1-49%, ≥50%","tox_g3":"≥G3: 69,8 vs 68,2%","tox_interesse":"Pneumonite 6,5%, hipotireoidismo 7,9%","impacto_reg":"Aprovação FDA/EMA 2018 · padrão 1L NSCLC escamoso","limit":"Análise de 5 anos confirmou benefício sustentado","ref":"https://www.nejm.org/doi/full/10.1056/NEJMoa1810865","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT02775435","pubmed_url":"https://www.nejm.org/doi/full/10.1056/NEJMoa1810865","ano_pub":2018,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"keynote-407-pembro-qt-em-nsclc-escamoso-1l"},{"estudo":"CheckMate-227 (2019)","acron":"CheckMate-227 — Nivolumab + Ipilimumab em NSCLC 1L","nct":"NCT02477826","sponsor":"BMS | PI: Hellmann","fase":"Fase 3, internacional, randomizado, aberto, multibraço","desenho":"Múltiplos braços: nivo+ipi vs nivo (ou nivo+QT) vs QT","centros":"Multinacional","periodo":"2015-2018","indicacao":"NSCLC avançado, 1L, sem EGFR/ALK","incl":"ECOG 0-1; sem QT prévia; doença mensurável","excl":"EGFR/ALK+; pneumonite prévia","estrat":"Histologia, PD-L1, sexo","basal":"Mediana 64a; PD-L1 ≥1% 67%; <1% 33%","n":"Parte 1: N=1166 (PD-L1 ≥1%); 550 (PD-L1 <1%)","molecular":"Estratificado por PD-L1","biomarc":"PD-L1 28-8","radiofarmaco":"Nivolumab + ipilimumab","esquema":"Nivo 3 mg/kg q2w + ipi 1 mg/kg q6w até 2 anos","cumul":"—","comparador":"QT padrão por histologia (4 ciclos)","estatistica":"Endpoints duplos: PFS (TMB ≥10 mut/Mb), OS (PD-L1 ≥1%)","analises":"ITT","primario":"PD-L1 ≥1%: OS 17,1 vs 14,9 m (HR 0,79). PD-L1 <1%: OS 17,2 vs 12,2 m (HR 0,62)","secundario":"PFS, ORR; DoR mais durável com IO","subgrupo":"Benefício mantido em todos PD-L1, inclusive <1%","tox_g3":"≥G3: 32,8 vs 36,0%","tox_interesse":"Pneumonite 7%, colite 4%, hepatite 7%, endocrinopatia 25%","impacto_reg":"Aprovação FDA 2020 · nivo+ipi 1L NSCLC sem EGFR/ALK","limit":"Endpoint primário inicial (TMB) abandonado; alteração de protocolo gerou debate","ref":"https://www.nejm.org/doi/full/10.1056/NEJMoa1910231","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT02477826","pubmed_url":"https://www.nejm.org/doi/full/10.1056/NEJMoa1910231","ano_pub":2019,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"checkmate-227-nivolumab-ipilimumab-em-nsclc-1l"},{"estudo":"CheckMate-9LA (2021)","acron":"CheckMate-9LA — Nivo+Ipi+QT curta em NSCLC 1L","nct":"NCT03215706","sponsor":"BMS | PI: Paz-Ares","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Nivo+ipi+QT 2 ciclos vs QT 4 ciclos. Conceito: QT curta para \"controle inicial\" + IO sustentada","centros":"Multinacional","periodo":"2017-2018","indicacao":"NSCLC avançado, 1L, sem EGFR/ALK","incl":"ECOG 0-1; doença mensurável","excl":"EGFR/ALK+","estrat":"PD-L1, histologia, sexo","basal":"Mediana 65a; PD-L1 todos os níveis","n":"N=719 (361 + 358)","molecular":"Estratificado por PD-L1","biomarc":"PD-L1 28-8","radiofarmaco":"Nivo+ipi+QT (2 ciclos)","esquema":"Nivo 360 mg q3w + ipi 1 mg/kg q6w + QT por histologia × 2 ciclos; depois nivo+ipi manutenção até 2 anos","cumul":"—","comparador":"QT × 4 ciclos + manutenção (não-esc)","estatistica":"Endpoint primário: OS","analises":"ITT","primario":"OS 15,6 vs 10,9 m (HR 0,66; p=0,0006)","secundario":"PFS 6,7 vs 5,0 m; ORR 38 vs 25%","subgrupo":"Benefício em todos PD-L1; especialmente em escamoso e <1%","tox_g3":"≥G3: 47 vs 38%","tox_interesse":"Pneumonite 6%, colite 4%","impacto_reg":"Aprovação FDA 2020 · nivo+ipi+QT curta 1L NSCLC","limit":"QT 2 ciclos pode ser subótima em doença volumosa","ref":"https://www.thelancet.com/journals/lanonc/article/PIIS1470-2045(20)30641-0/fulltext","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT03215706","pubmed_url":"https://www.thelancet.com/journals/lanonc/article/PIIS1470-2045(20)30641-0/fulltext","ano_pub":2021,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"checkmate-9la-nivo-ipi-qt-curta-em-nsclc-1l"},{"estudo":"IMpower150 (2018)","acron":"IMpower150 — Atezo+Bev+QT em NSCLC não-escamoso 1L","nct":"NCT02366143","sponsor":"Roche/Genentech | PI: Socinski","fase":"Fase 3, randomizado, aberto, multibraço","desenho":"Atezo+bev+carbo+paclitaxel (ABCP) vs bev+carbo+pacli (BCP). Único estudo IO+anti-VEGF em pulmão","centros":"Multinacional","periodo":"2015-2017","indicacao":"NSCLC não-escamoso avançado, 1L; permitiu EGFR/ALK pré-tratados","incl":"ECOG 0-1; doença mensurável; EGFR/ALK pré-tratados elegíveis","excl":"Hemoptise; doença autoimune ativa","estrat":"Sexo, PD-L1, mets hepáticas","basal":"Mediana 63a; mets hepáticas 13%; EGFR/ALK pré-tratados 13%","n":"N=1202 (3 braços)","molecular":"ITT-WT (sem EGFR/ALK) endpoint primário","biomarc":"PD-L1 SP142; T-effector signature","radiofarmaco":"Atezolizumab + bevacizumab + carbo + paclitaxel","esquema":"Atezo 1200 mg + bev 15 mg/kg + carbo AUC6 + pacli 200 mg/m² q3w × 4-6; depois atezo+bev manutenção","cumul":"—","comparador":"BCP (controle) e ACP (atezo+carbo+pacli, sem bev)","estatistica":"Endpoints duplos: OS e PFS (ITT-WT)","analises":"ITT-WT, ITT","primario":"ITT-WT: PFS 8,3 vs 6,8 m (HR 0,62). OS 19,2 vs 14,7 m (HR 0,78; p=0,02)","secundario":"Benefício em mets hepáticas (HR OS 0,52) e EGFR+ pré-tratados","subgrupo":"ABCP melhor em mets hepáticas e EGFR/ALK pré-tratados","tox_g3":"≥G3: 57 vs 49%","tox_interesse":"Pneumonite 1,8%, hipertensão 11%, hemorragia 0,4%","impacto_reg":"Aprovação FDA 2018 · ABCP em NSCLC não-escamoso","limit":"Esquema com 4 drogas; toxicidade aditiva; uso menor após KEYNOTE-189","ref":"https://www.nejm.org/doi/full/10.1056/NEJMoa1716948","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT02366143","pubmed_url":"https://www.nejm.org/doi/full/10.1056/NEJMoa1716948","ano_pub":2018,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"impower150-atezo-bev-qt-em-nsclc-n-o-escamoso-1l"},{"estudo":"POSEIDON (2023)","acron":"POSEIDON — Durva+Treme+QT vs QT em NSCLC 1L","nct":"NCT03164616","sponsor":"AstraZeneca | PI: Johnson","fase":"Fase 3, randomizado, aberto, multibraço","desenho":"Tripletas: durvalumab+tremelimumab+QT vs durvalumab+QT vs QT","centros":"Multinacional","periodo":"2017-2018","indicacao":"NSCLC avançado, 1L, sem EGFR/ALK","incl":"ECOG 0-1; doença mensurável","excl":"EGFR/ALK+","estrat":"Histologia, PD-L1, ECOG","basal":"Mediana 64a; PD-L1 todos os níveis","n":"N=1013 (3 braços ~338 cada)","molecular":"Estratificado por PD-L1","biomarc":"PD-L1 SP263; STK11/KEAP1/KRAS por NGS (subanálise)","radiofarmaco":"Durva + treme + QT × 4; depois durva+treme manutenção","esquema":"Durva 1500 mg + treme 75 mg + QT q3w × 4; depois durva 1500 mg q4w + 1 dose treme; até progressão","cumul":"Treme: 5 doses totais","comparador":"QT × 4-6 ciclos (controle)","estatistica":"Endpoints hierárquicos: PFS e OS","analises":"ITT","primario":"Tripleta vs QT: PFS 6,2 vs 4,8 m (HR 0,72; p=0,0003); OS 14,0 vs 11,7 m (HR 0,77; p=0,003)","secundario":"ORR 38,8 vs 24,4%","subgrupo":"Subanálise STK11/KEAP1/KRAS: benefício maior com tripleta nessas mutações","tox_g3":"≥G3: 51,8 vs 41,6%","tox_interesse":"Colite 6%, pneumonite 4%, hepatite 5%","impacto_reg":"Aprovação FDA 2022 · durva+treme+QT 1L NSCLC","limit":"Magnitude de OS modesta; debate sobre custo-benefício vs nivo+ipi+QT","ref":"https://ascopubs.org/doi/10.1200/JCO.22.00975","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT03164616","pubmed_url":"https://ascopubs.org/doi/10.1200/JCO.22.00975","ano_pub":2023,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"poseidon-durva-treme-qt-vs-qt-em-nsclc-1l"},{"estudo":"EMPOWER-Lung 1 (2021)","acron":"EMPOWER-Lung 1 — Cemiplimab vs QT em NSCLC PD-L1 ≥50% 1L","nct":"NCT03088540","sponsor":"Regeneron | PI: Sezer","fase":"Fase 3, internacional, randomizado, aberto","desenho":"Cemiplimab vs QT à base de platina; crossover permitido na progressão","centros":"Multinacional (incluindo regiões emergentes)","periodo":"2017-2020","indicacao":"NSCLC avançado, 1L, PD-L1 TPS ≥50%, sem EGFR/ALK","incl":"ECOG 0-1; PD-L1 ≥50%","excl":"EGFR/ALK+; mets SNC ativa","estrat":"Histologia, região","basal":"Mediana 63a; PD-L1 ≥50%","n":"N=710 (354 + 356)","molecular":"PD-L1 ≥50% (22C3)","biomarc":"PD-L1 22C3","radiofarmaco":"Cemiplimab 350 mg q3w","esquema":"Cemiplimab 350 mg q3w até 108 semanas ou progressão","cumul":"—","comparador":"QT à base de platina × 4-6 ciclos","estatistica":"OS e PFS endpoints duplos","analises":"ITT","primario":"OS 22,1 vs 14,3 m (HR 0,57; p=0,002). PFS 6,2 vs 5,6 m (HR 0,54)","secundario":"ORR 39 vs 20%; DoR 16,7 vs 6,0 m","subgrupo":"Benefício consistente em todos os subgrupos","tox_g3":"≥G3: 28 vs 39%","tox_interesse":"Pneumonite 2%, hipotireoidismo 6%, colite 1%","impacto_reg":"Aprovação FDA 2021 · cemiplimab 1L PD-L1 ≥50%","limit":"Crossover alto pode subestimar OS; design idêntico ao KEYNOTE-024","ref":"https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(21)00228-2/fulltext","category_id":"nsclc_imuno","preparo":"","nct_url":"https://clinicaltrials.gov/study/NCT03088540","pubmed_url":"https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(21)00228-2/fulltext","ano_pub":2021,"status":"Publicado","category_name":"NSCLC · Imunoterapia 1L","category_short":"NSCLC IO","category_color":"#22d3ee","uid":"empower-lung-1-cemiplimab-vs-qt-em-nsclc-pd-l1-50-1l"},{"estudo":"FLAURA (2018)","acron":"FLAURA — Osimertinib 1L em NSCLC EGFR+","nct":"NCT02296125","sponsor":"AstraZeneca | PI: Soria","fase":"Fase 3, internacional, randomizado, duplo-cego","desenho":"Osimertinib (3ª geração) vs gefitinib ou erlotinib (controle TKI 1ª geração)","centros":"Multinacional","periodo":"2014-2016","indicacao":"NSCLC avançado EGFR+ (Ex19del ou L858R), 1L","incl":"Idade ≥18a; ECOG 0-1; EGFR Ex19del/L858R","excl":"EGFR T790M de novo; mets SNC sintomática","estrat":"Tipo de mutação, etnia","basal":"Mediana 64a; ~63% asiáticos; mets SNC 19%","n":"N=556 (279 + 277)","molecular":"EGFR Ex19del 63% / L858R 37%","biomarc":"EGFR mutação ativadora","radiofarmaco":"Osimertinib 80 mg/d","esquema":"Osimertinib 80 mg/d VO até progressão","cumul":"—","comparador":"Gefitinib 250 mg/d ou erlotinib 150 mg/d","estatistica":"Endpoint primário: PFS","analises":"ITT","primario":"PFS 18,9 vs 10,2 m (HR 0,46; p<0,001). OS 38,6 vs 31,8 m (HR 0,80; p=0,046)","secundario":"ORR 80% vs 76%; DoR 17,2 vs 8,5 m","subgrupo":"Benefício em SNC: PFS SNC mediana NA vs 13,9 m","tox_g3":"≥G3: 34 vs 45%","tox_interesse":"Diarreia 58% (G3 2%), rash 58% (G3 1%), pneumonite 4%","impacto_reg":"Aprovação FDA 2018 · padrão 1L EGFR+ NSCLC","limit":"Comparador inc