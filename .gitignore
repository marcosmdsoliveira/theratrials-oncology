# ====== TheraTrials Oncology — gitignore ======

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Logs e temporários
*.log
*.tmp
*.bak
*.old
*.orig
*.rej

# Node / build (caso seja adicionado no futuro)
node_modules/
dist/
build/
.cache/
.parcel-cache/
.next/
.nuxt/
.output/

# Python (caso scripts auxiliares sejam adicionados)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Senstivel — nunca subir
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials.json

# Outputs de teste / scratch
/tmp/
/scratch/
*.scratch.html
DEBUG_*

# Relatórios dos validadores de dados (scripts/validate_*.mjs)
report.json
validation-report.json
cards-report.json
pubmed-report.json
nct-report.json
trials-br-report.json

# Scratch de auditoria (prefixo _)
_*.json
_*.mjs.tmp

# Backups numerados (data.js.bak_pre_batchN, etc.)
*.bak_*

# Saídas do ciclo do Trial Matcher (br_ciclo.py): relatório e banco proposto
scripts/_br_*
# Saídas do pipeline do Database (db_registro.py, db_freshness.py): coleta,
# registro de identidade, relatórios, backlog e estado entre execuções
scripts/_db_*
# Database v2 · estado dos agentes (reproduzível): cache de fontes, pacotes, propostas, vereditos, fila
scripts/db_v2/state/
# Histórico da auditoria: passa entre runs do Actions como artifact, nunca pelo git
scripts/br_estado.json
scripts/br_eventos.jsonl
